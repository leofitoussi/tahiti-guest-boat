+), `;
+const bind = (sql: string) => fixture + sql.slice('WITH '.length)
+  .replaceAll('{{websiteId::uuid}}','$1::uuid').replaceAll('{{startDate}}','$2::timestamptz').replaceAll('{{endDate}}','$3::timestamptz');
+const db = new Client({ connectionString: process.env.DATABASE_URL });
+await db.connect();
+try {
+  await db.query('BEGIN READ ONLY');
+  const args = ['388d24a4-9679-4b9c-992d-5ac0427b099c','2026-11-25T06:00:00Z','2026-11-25T06:01:40Z'];
+  const { rows } = await db.query(bind(HOME_PAGEVIEW_REPORT_SQL),args);
+  const a=rows.find(r=>r.variant==='A'&&r.segment==='all');
+  const b=rows.find(r=>r.variant==='B'&&r.segment==='all');
+  assert.equal(a.exposed_visits,2); assert.equal(b.exposed_visits,2);
+  assert.equal(a.engaged_visits,1); assert.equal(b.engaged_visits,1);
+  assert.equal(a.next_page_visits,1); assert.equal(b.time_and_section_visits,1);
+  assert.equal(rows.find(r=>r.variant==='A'&&r.segment==='mobile').exposed_visits,1);
+  const { rows: [coverage] } = await db.query(bind(HOME_PAGEVIEW_TRAFFIC_SQL),args);
+  assert.deepEqual(coverage,{homepage_pageviews:7,homepage_visits:5,measured_visits:4,excluded_visits:1,unmeasured_visits:1,measured_pct:'80.0',mixed_visits:1});
+  for (const v of ['A','B']) {
+    assert.equal(rows.find(r=>r.variant===v&&r.segment==='all').exposed_visits,
+      rows.filter(r=>r.variant===v&&r.segment!=='all').reduce((n,r)=>n+r.exposed_visits,0));
+  }
+  console.log('Native pageview SQL fixtures passed: first variant per visit, reload deduplication, mixed visits retained, QA excluded, next-page engagement without consent storage, observed 20s, orphan events, host/path/date boundaries, exact coverage. No rows written.');
+} finally { await db.query('ROLLBACK'); await db.end(); }
