+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+
+# Use an official Node 22+ executable in PATH. Local .env is private/ignored.
+# Production secrets returned by Netlify are masked outside Netlify builds.
+export DOTENV_CONFIG_OVERRIDE=true
+pnpm --package=netlify-cli@27.20.1 dlx netlify deploy \
+  --context production \
+  --alias migration-check \
+  --site 834e8e23-92fd-4c79-9da5-d7d068df5ed7 \
+  --message 'Umami migration preview'
+pnpm exec tsx ops/verify-migration.ts https://migration-check--tgb-umami.netlify.app
