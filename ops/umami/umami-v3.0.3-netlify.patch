@@ -0,0 +1,116 @@
+// Fixed protocol for TGB-64. These bounds must match the live homepage release.
+export const HOME_EXPERIMENT_WEBSITE_ID = '388d24a4-9679-4b9c-992d-5ac0427b099c';
+export const HOME_EXPERIMENT_START = '2026-11-22T17:34:00.000Z';
+// User-authorized extension on 25 November; the original end was 6 December.
+export const HOME_EXPERIMENT_END = '2026-12-13T17:34:00.000Z';
+export type HomeExperimentSegment = 'all' | 'mobile' | 'desktop';
+export interface HomeExperimentRow {
+  variant: 'A' | 'B';
+  segment: HomeExperimentSegment;
+  exposed_visits: number;
+  engaged_visits: number;
+  engagement_pct: number | null;
+  next_page_visits: number;
+  time_and_section_visits: number;
+  mixed_or_qa_visits_excluded: number;
+}
+export interface HomeExperimentReport {
+  start: string;
+  end: string;
+  generatedAt: string;
+  through: string;
+  status: 'scheduled' | 'running' | 'ended';
+  rangeStart: string;
+  rangeEnd: string;
+  period: '24h' | '7d' | '30d' | 'all';
+  unit: 'hour' | 'day';
+  series: { bucket: string; variant: 'A' | 'B'; segment: HomeExperimentSegment; exposed_visits: number }[];
+  rows: HomeExperimentRow[];
+  collectionStart: string;
+  legacyRows: HomeExperimentRow[];
+  legacyCoverage: HomeExperimentReport['coverage'];
+  coverage: {
+    homepage_pageviews: number;
+    homepage_visits: number;
+    measured_visits: number;
+    excluded_visits: number;
+    unmeasured_visits: number;
+    measured_pct: number | null;
+    mixed_visits?: number;
+  };
+}
+
+export function homeExperimentStatus(now = Date.now()): HomeExperimentReport['status'] {
+  return now < Date.parse(HOME_EXPERIMENT_START)
+    ? 'scheduled'
+    : now < Date.parse(HOME_EXPERIMENT_END)
+      ? 'running'
+      : 'ended';
+}
+
+// Same visit-level SELECT as the website repository's report-home-experiment.mjs.
+// Values use Prisma's bound placeholders; no browser-supplied SQL or dates.
+const HOME_EXPERIMENT_VISITS_SQL = `WITH events AS (
+  SELECT e.visit_id, e.event_name, e.created_at,
+    max(d.string_value) FILTER (WHERE d.data_key = 'experiment') AS experiment,
+    max(d.string_value) FILTER (WHERE d.data_key = 'variant') AS variant,
+    max(d.string_value) FILTER (WHERE d.data_key = 'viewport') AS viewport,
+    max(d.string_value) FILTER (WHERE d.data_key = 'reason') AS reason,
+    max(d.string_value) FILTER (WHERE d.data_key = 'qa') AS qa
+  FROM website_event e JOIN event_data d ON d.website_event_id = e.event_id
+  WHERE e.website_id = {{websiteId::uuid}}
+    AND e.hostname IN ('tahitiguestboat.com', 'www.tahitiguestboat.com')
+    AND e.event_name IN ('home_intro_exposed', 'home_intro_engaged')
+    AND e.created_at >= {{startDate}} AND e.created_at < {{endDate}}
+  GROUP BY e.event_id, e.visit_id, e.event_name, e.created_at
+), coherent AS (
+  SELECT visit_id FROM events WHERE experiment = 'home-intro-v1'
+  GROUP BY visit_id HAVING count(DISTINCT variant) = 1 AND NOT bool_or(coalesce(qa, '') = 'true')
+), exposure AS (
+  SELECT DISTINCT ON (e.visit_id) e.visit_id, e.variant, e.viewport, e.created_at AS exposed_at
+  FROM events e JOIN coherent USING (visit_id)
+  WHERE e.experiment = 'home-intro-v1' AND e.event_name = 'home_intro_exposed'
+  ORDER BY e.visit_id, e.created_at
+), visits AS (
+  SELECT x.visit_id, x.variant, x.viewport,
+    bool_or(e.event_name = 'home_intro_engaged' AND e.created_at >= x.exposed_at) AS engaged,
+    bool_or(e.reason = 'next_page' AND e.created_at >= x.exposed_at) AS next_page,
+    bool_or(e.reason = '20s_and_section' AND e.created_at >= x.exposed_at) AS time_and_section
+  FROM exposure x LEFT JOIN events e ON e.visit_id = x.visit_id AND e.variant = x.variant AND e.experiment = 'home-intro-v1'
+  GROUP BY x.visit_id, x.variant, x.viewport
+)`;
+
+export const HOME_EXPERIMENT_REPORT_SQL = `${HOME_EXPERIMENT_VISITS_SQL}, groups AS (
+  SELECT a.variant, s.segment FROM (VALUES ('A'), ('B')) a(variant)
+  CROSS JOIN (VALUES ('all'), ('mobile'), ('desktop')) s(segment)
+)
+SELECT g.variant, g.segment, count(v.visit_id)::int AS exposed_visits,
+  count(v.visit_id) FILTER (WHERE v.engaged)::int AS engaged_visits,
+  round(100.0 * count(v.visit_id) FILTER (WHERE v.engaged) / nullif(count(v.visit_id), 0), 1) AS engagement_pct,
+  count(v.visit_id) FILTER (WHERE v.next_page)::int AS next_page_visits,
+  count(v.visit_id) FILTER (WHERE v.time_and_section)::int AS time_and_section_visits,
+  (SELECT count(DISTINCT visit_id) FROM events WHERE experiment='home-intro-v1') - (SELECT count(*) FROM coherent) AS mixed_or_qa_visits_excluded
+FROM groups g LEFT JOIN visits v ON v.variant = g.variant AND (g.segment = 'all' OR v.viewport = g.segment)
+GROUP BY g.variant, g.segment ORDER BY g.segment, g.variant;`;
+
+// Reconcile the exact homepage visit IDs, not a subtraction of unrelated totals.
+export const HOME_EXPERIMENT_TRAFFIC_SQL = `${HOME_EXPERIMENT_VISITS_SQL}, homepage AS (
+  SELECT visit_id, count(*)::int AS pageviews
+  FROM website_event
+  WHERE website_id = {{websiteId::uuid}}
+    AND hostname IN ('tahitiguestboat.com', 'www.tahitiguestboat.com')
+    AND event_type = 1 AND url_path = '/'
+    AND created_at >= {{startDate}} AND created_at < {{endDate}}
+  GROUP BY visit_id
+), excluded AS (
+  SELECT DISTINCT e.visit_id FROM events e
+  LEFT JOIN coherent c USING (visit_id)
+  WHERE e.experiment = 'home-intro-v1' AND c.visit_id IS NULL
+)
+SELECT coalesce(sum(h.pageviews), 0)::int AS homepage_pageviews,
+  count(*)::int AS homepage_visits,
+  count(*) FILTER (WHERE v.visit_id IS NOT NULL)::int AS measured_visits,
+  count(*) FILTER (WHERE x.visit_id IS NOT NULL)::int AS excluded_visits,
+  count(*) FILTER (WHERE v.visit_id IS NULL AND x.visit_id IS NULL)::int AS unmeasured_visits,
+  round(100.0 * count(*) FILTER (WHERE v.visit_id IS NOT NULL) / nullif(count(*), 0), 1) AS measured_pct
+FROM homepage h LEFT JOIN visits v USING (visit_id) LEFT JOIN excluded x USING (visit_id);`;
