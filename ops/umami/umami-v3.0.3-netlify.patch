+ }finally{
+  assert.equal((await fetch(base+`/api/websites/${id}`,{method:'DELETE',headers})).status,200);
+  const {rows:[row]}=await db.query('SELECT count(*)::int AS n FROM website WHERE website_id=$1',[id]);assert.equal(row.n,0);
+  console.log('Temporary QA website and data removed.');
+ }
+}finally{await db.end();}
