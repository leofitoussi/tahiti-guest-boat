+import { homeExperimentRange } from '../home-experiment-range';
+import { HOME_EXPERIMENT_END } from '../home-experiment-report';
+import { HOME_PAGEVIEW_COLLECTION_START } from '../home-pageview-report';
+
+test('uses rolling periods, clipped to the reliable collection and authorized stop', () => {
+  const now = Date.parse('2026-11-29T23:00:00Z');
+  const last24 = homeExperimentRange('24h', now);
+  expect(last24.start.toISOString()).toBe('2026-11-28T23:00:00.000Z');
+  expect(last24.end.getTime()).toBe(now);
+  expect(last24.unit).toBe('hour');
+  expect(homeExperimentRange('7d', now).start.toISOString()).toBe(HOME_PAGEVIEW_COLLECTION_START);
+  expect(homeExperimentRange('all', now).start.toISOString()).toBe(HOME_PAGEVIEW_COLLECTION_START);
+  expect(homeExperimentRange('30d', now).unit).toBe('day');
+  expect(homeExperimentRange('bogus', now)).toBeNull();
+  expect(homeExperimentRange('all', Date.parse(HOME_EXPERIMENT_END) + 86400000).end.toISOString()).toBe(HOME_EXPERIMENT_END);
+});
+
+test('the end is explicitly extended to 13 December, preserving the original start', () => {
+  expect(HOME_EXPERIMENT_END).toBe('2026-12-13T17:34:00.000Z');
+});
