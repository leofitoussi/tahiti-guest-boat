+
+jest.mock('@/lib/prisma', () => ({ __esModule: true, default: { rawQuery: jest.fn() } }));
+jest.mock('@/lib/request', () => ({ parseRequest: jest.fn() }));
+jest.mock('@/permissions', () => ({ canViewWebsite: jest.fn() }));
+
+const parse = jest.mocked(parseRequest);
+const canView = jest.mocked(canViewWebsite);
+const query = jest.mocked(prisma.rawQuery);
+const context = (websiteId = HOME_EXPERIMENT_WEBSITE_ID) => ({
+  params: Promise.resolve({ websiteId }),
+});
+const request = () => new Request('https://analytics.tahitiguestboat.com/api/test?startAt=0');
+
+beforeEach(() => {
+  jest.clearAllMocks();
+  parse.mockResolvedValue({ auth: { user: { id: 'owner' } } });
+  canView.mockResolvedValue(true);
+  query.mockReset();
+  query.mockImplementation(async sql =>
+    sql === HOME_PAGEVIEW_REPORT_SQL || sql === HOME_EXPERIMENT_REPORT_SQL
+      ? []
+      : [
+          {
+            homepage_pageviews: 0,
+            homepage_visits: 0,
+            measured_visits: 0,
+            excluded_visits: 0,
+            unmeasured_visits: 0,
+            measured_pct: null,
+          },
+        ],
+  );
+});
+afterEach(() => jest.restoreAllMocks());
+
+test('requires authentication before querying experiment data', async () => {
+  parse.mockResolvedValue({ error: () => Response.json({}, { status: 401 }) });
+  expect((await GET(request(), context())).status).toBe(401);
+  expect(query).not.toHaveBeenCalled();
+});
+
+test('does not expose the TGB report through another website', async () => {
+  expect((await GET(request(), context('other-site'))).status).toBe(404);
+  expect(query).not.toHaveBeenCalled();
+});
+
+test('checks website access even for an authenticated user', async () => {
+  canView.mockResolvedValue(false);
+  expect((await GET(request(), context())).status).toBe(401);
+  expect(query).not.toHaveBeenCalled();
+});
+
+test('keeps the protocol dates, bounds live data to now and serializes database numeric types', async () => {
+  const now = Date.parse(HOME_EXPERIMENT_START) + 60_000;
+  jest.spyOn(Date, 'now').mockReturnValue(now);
+  query.mockReset();
+  query
+    .mockResolvedValueOnce([{ engagement_pct: '50.0', mixed_or_qa_visits_excluded: 1n }])
+    .mockResolvedValueOnce([
+      {
+        homepage_pageviews: 18,
+        homepage_visits: 17,
+        measured_visits: 4,
+        excluded_visits: 1,
+        unmeasured_visits: 12,
+        measured_pct: '23.5',
+      },
+    ])
+    .mockResolvedValueOnce([])
+    .mockResolvedValueOnce([
+      {
+        homepage_pageviews: 0,
+        homepage_visits: 0,
+        measured_visits: 0,
+        excluded_visits: 0,
+        unmeasured_visits: 0,
+        measured_pct: null,
+      },
+    ]);
+  const response = await GET(request(), context());
+  const data = await response.json();
+  expect(response.headers.get('cache-control')).toBe('private, no-store');
+  expect(data.status).toBe('running');
+  expect(data.legacyCoverage).toEqual({
+    homepage_pageviews: 18,
+    homepage_visits: 17,
+    measured_visits: 4,
+    excluded_visits: 1,
+    unmeasured_visits: 12,
+    measured_pct: 23.5,
+  });
+  expect(query.mock.calls[1][1]).toEqual(query.mock.calls[0][1]);
+  expect(data.legacyRows).toEqual([{ engagement_pct: 50, mixed_or_qa_visits_excluded: 1 }]);
+  expect(query.mock.calls[0][1]).toEqual({
+    websiteId: HOME_EXPERIMENT_WEBSITE_ID,
+    startDate: new Date(HOME_EXPERIMENT_START),
+    endDate: new Date(now),
+  });
+});
+
+test('never includes events after the scheduled stop', async () => {
+  jest.spyOn(Date, 'now').mockReturnValue(Date.parse(HOME_EXPERIMENT_END) + 86400_000);
+  const data = await (await GET(request(), context())).json();
+  expect(data.status).toBe('ended');
+  expect(query.mock.calls[2][1].endDate).toEqual(new Date(HOME_EXPERIMENT_END));
+  expect(query.mock.calls[0][1].endDate).toEqual(new Date(HOME_PAGEVIEW_COLLECTION_START));
+});
+
+test('uses the same half-open fourteen-day window as the homepage', () => {
+  const start = Date.parse(HOME_EXPERIMENT_START);
+  const end = Date.parse(HOME_EXPERIMENT_END);
+  expect(end - start).toBe(14 * 86400_000);
+  expect(homeExperimentStatus(start - 1)).toBe('scheduled');
+  expect(homeExperimentStatus(start)).toBe('running');
+  expect(homeExperimentStatus(end - 1)).toBe('running');
+  expect(homeExperimentStatus(end)).toBe('ended');
+});
+
+test('counts native pageviews after the correction separately from the incomplete historical cohort', async () => {
+  const now = Date.parse(HOME_PAGEVIEW_COLLECTION_START) + 60_000;
+  jest.spyOn(Date, 'now').mockReturnValue(now);
+  const data = await (await GET(request(), context())).json();
+  expect(data.collectionStart).toBe(HOME_PAGEVIEW_COLLECTION_START);
+  expect(query.mock.calls[0][1].endDate).toEqual(new Date(HOME_PAGEVIEW_COLLECTION_START));
+  expect(query.mock.calls[2]).toEqual([
+    HOME_PAGEVIEW_REPORT_SQL,
+    {
+      websiteId: HOME_EXPERIMENT_WEBSITE_ID,
+      startDate: new Date(HOME_PAGEVIEW_COLLECTION_START),
+      endDate: new Date(now),
+    },
+  ]);
+  expect(query.mock.calls[3][0]).toBe(HOME_PAGEVIEW_TRAFFIC_SQL);
+});
