+#!/usr/bin/env python3
+"""Back up the source, or restore into an EMPTY Neon database. No reset/drop.
+
+Credentials are read from private files and sent over SSH stdin, never argv.
+Requires SSH to the source VPS and its existing PostgreSQL 16 container.
+"""
+import argparse
+import datetime
+import hashlib
+import json
+import os
+from pathlib import Path
+import shlex
+import subprocess
+from urllib.parse import unquote, urlsplit
+
+
+def private_file(path, mode):
+    return open(path, mode, opener=lambda p, flags: os.open(p, flags, 0o600))
+
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('action', choices=['backup', 'restore'])
+parser.add_argument('--source-context', type=Path, required=True)
+parser.add_argument('--ssh-key', type=Path, required=True)
+parser.add_argument('--ssh-port', type=int, default=22)
+parser.add_argument('--archive', type=Path, required=True)
+parser.add_argument('--connection-file', type=Path, help='Private JSON with direct Neon URL under key "direct"')
+args = parser.parse_args()
+os.umask(0o077)
+source = json.loads(args.source_context.read_text())
+ssh = ['ssh', '-i', str(args.ssh_key), '-p', str(args.ssh_port), '-o',
+       'IdentitiesOnly=yes', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=15',
+       'root@' + source['host']]
+
+
+def remote(command, **kwargs):
+    return subprocess.run(ssh + [shlex.join(command)], **kwargs)
+
+
+if args.action == 'backup':
+    if args.archive.exists():
+        parser.error('Archive already exists; choose a new timestamped filename')
+    args.archive.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+    partial = args.archive.with_suffix(args.archive.suffix + '.partial')
+    if partial.exists():
+        parser.error('Partial archive already exists; inspect it first')
+    command = ['docker', 'exec', source['db_container'], 'sh', '-c',
+               'export PGPASSWORD="$POSTGRES_PASSWORD"; exec pg_dump "$@"', 'sh',
+               '--format=custom', '--no-owner', '--no-acl', '-U',
+               source['database_user'], '-d', source['database']]
+    with private_file(partial, 'xb') as output:
+        result = remote(command, stdout=output, stderr=subprocess.PIPE)
+        output.flush()
+        os.fsync(output.fileno())
+    if result.returncode:
+        raise SystemExit(result.stderr.decode())
+    with partial.open('rb') as archive:
+        assert archive.read(5) == b'PGDMP', 'Invalid dump header'
+    # ssh inherits the file descriptor, not the Python reader's buffered offset.
+    with partial.open('rb') as archive:
+        catalogue = remote(['docker', 'exec', '-i', source['db_container'],
+                            'pg_restore', '--list'], stdin=archive,
+                           stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True)
+    with private_file(args.archive.with_suffix('.catalog.txt'), 'wb') as output:
+        output.write(catalogue.stdout)
+    partial.rename(args.archive)
+    manifest = {'archive': args.archive.name, 'bytes': args.archive.stat().st_size,
+                'sha256': hashlib.sha256(args.archive.read_bytes()).hexdigest(),
+                'created_at_utc': datetime.datetime.now(datetime.timezone.utc).isoformat(),
+                'catalogue_valid': True, 'source_image': source['app_image']}
+    with private_file(args.archive.with_suffix('.manifest.json'), 'w') as output:
+        json.dump(manifest, output, indent=2)
+    print(json.dumps(manifest))
+else:
+    if not args.connection_file:
+        parser.error('--connection-file is required for restore')
+    url = urlsplit(json.loads(args.connection_file.read_text())['direct'])
+    if not url.hostname or not url.hostname.endswith('.neon.tech') or '-pooler.' in url.hostname:
+        parser.error('Restore requires a direct (non-pooled) Neon hostname')
+    with args.archive.open('rb') as archive:
+        if archive.read(5) != b'PGDMP':
+            parser.error('Invalid dump header')
+    config = {'container': source['db_container'], 'env': {
+        'PGHOST': url.hostname, 'PGPORT': str(url.port or 5432),
+        'PGUSER': unquote(url.username or ''), 'PGPASSWORD': unquote(url.password or ''),
+        'PGDATABASE': unquote(url.path.lstrip('/')), 'PGSSLMODE': 'require',
+        'PGCONNECT_TIMEOUT': '20',
+    }}
+    code = '''import sys,json,os,subprocess
+c=json.loads(sys.stdin.buffer.readline()); data=sys.stdin.buffer.read()
+env=os.environ.copy(); env.update(c['env'])
+base=['docker','exec','-i']
+for key in c['env']: base.extend(['-e',key])
+base.append(c['container'])
+check=subprocess.run(base+['psql','-X','-At','-v','ON_ERROR_STOP=1','-c',
+ "SELECT count(*) FROM information_schema.tables WHERE table_schema='public' AND table_type='BASE TABLE'"],
+ env=env,input=b'',capture_output=True,check=True)
+if check.stdout.strip()!=b'0':
+ sys.exit('Target is not empty; refusing to overwrite any data')
+r=subprocess.run(base+['pg_restore','--dbname='+c['env']['PGDATABASE'],
+ '--no-owner','--no-acl','--exit-on-error','--single-transaction'],env=env,input=data)
+sys.exit(r.returncode)
+'''
+    payload = json.dumps(config).encode() + b'\n' + args.archive.read_bytes()
+    result = remote(['python3', '-c', code], input=payload)
+    if result.returncode:
+        raise SystemExit(result.returncode)
+    print(json.dumps({'restored': True, 'archive': args.archive.name,
