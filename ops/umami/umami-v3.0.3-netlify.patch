+  const makeDom=async (fixture:any,userAgent:string,optout=false)=>{
+   const dom=new JSDOM(`${fixture.opening.replace('388d24a4-9679-4b9c-992d-5ac0427b099c',id)}</script><script type="application/json" id="home-experiment-runtime">${fixture.runtime}</script><div data-home-post-intro><section>Section</section></div>`,{url:'https://tahitiguestboat.com/',runScripts:'outside-only'});
+   const w=dom.window;let clock=0,visible=true,focused=true,observe:any;const intervals=new Map<number,()=>void>();let next=1;
+   w.setInterval=(cb:any)=>{intervals.set(next,cb);return next++;};w.clearInterval=(key:number)=>intervals.delete(key);
+   Object.defineProperty(w.performance,'now',{value:()=>clock});
+   Object.defineProperty(w.document,'currentScript',{value:w.document.querySelector('script')});
+   Object.defineProperty(w.document,'readyState',{value:'complete'});
+   Object.defineProperty(w.document,'visibilityState',{get:()=>visible?'visible':'hidden'});
+   w.document.hasFocus=()=>focused;w.matchMedia=()=>({matches:false});
+   w.IntersectionObserver=class{constructor(cb:any){observe=cb;}observe(){}disconnect(){}};
+   if(fixture.choice!=='undecided')w.localStorage.setItem('tgb_cookie_consent',JSON.stringify({analytics:fixture.choice==='granted',advertising:false,savedAt:Date.now()}));
+   if(optout)w.localStorage.setItem('umami.disabled','1');
+   const initialStorage=JSON.stringify({...w.localStorage});const pending:Promise<any>[]=[];const bodies:any[]=[];const sends:any[]=[];
+   w.fetch=(url:string,init:any)=>{sends.push(JSON.parse(init.body));const p=fetch(url,{...init,headers:{...init.headers,'user-agent':userAgent}}).then(async response=>{assert.equal(response.status,200);bodies.push(await response.clone().json());return response;});pending.push(p);return p;};
+   w.eval(tracker);await Promise.all(pending);w.eval(fixture.client);
+   const advance=(ms:number)=>{for(let left=ms;left>0;left-=Math.min(1000,left)){clock+=Math.min(1000,left);for(const cb of intervals.values())cb();}};
+   return {w,dom,bodies,sends,advance,
+    section:()=>observe([{isIntersecting:true,intersectionRect:{height:150},boundingClientRect:{height:600}}]),
+    visible:(value:boolean)=>{visible=value;w.document.dispatchEvent(new w.Event('visibilitychange'));},
+    focus:(value:boolean)=>{focused=value;w.dispatchEvent(new w.Event(value?'focus':'blur'));},
