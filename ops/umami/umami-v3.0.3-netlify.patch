+import type { Metadata } from 'next';
+import { notFound } from 'next/navigation';
+import { HOME_EXPERIMENT_WEBSITE_ID } from '@/lib/home-experiment-report';
+import { HomeExperimentPage } from './HomeExperimentPage';
+
