diff --git a/src/app/(main)/websites/[websiteId]/home-experiment/HomeExperimentPage.tsx b/src/app/(main)/websites/[websiteId]/home-experiment/HomeExperimentPage.tsx
new file mode 100644
index 0000000..cb876ac
--- /dev/null
+++ b/src/app/(main)/websites/[websiteId]/home-experiment/HomeExperimentPage.tsx
@@ -0,0 +1,217 @@
+'use client';
+import { Button, Column, Row, Text } from '@umami/react-zen';
+import { useState } from 'react';
+import { LoadingPanel } from '@/components/common/LoadingPanel';
+import { Panel } from '@/components/common/Panel';
+import { useApi } from '@/components/hooks';
+import type { HomeExperimentReport, HomeExperimentSegment } from '@/lib/home-experiment-report';
+import styles from './HomeExperimentPage.module.css';
+
+const segments: { id: HomeExperimentSegment; label: string }[] = [
+  { id: 'all', label: 'Tous les appareils' },
+  { id: 'mobile', label: 'Mobile' },
+  { id: 'desktop', label: 'Ordinateur' },
+];
+const number = new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 1 });
+const date = new Intl.DateTimeFormat('fr-FR', {
+  dateStyle: 'medium',
+  timeStyle: 'short',
+  timeZone: 'Pacific/Tahiti',
+});
+
+export function HomeExperimentPage({ websiteId }: { websiteId: string }) {
+  const [segment, setSegment] = useState<HomeExperimentSegment>('all');
+  const { get, useQuery } = useApi();
+  const { data, error, isLoading, isFetching, refetch } = useQuery<HomeExperimentReport>({
+    queryKey: ['home-experiment', websiteId],
+    queryFn: () => get(`/websites/${websiteId}/home-experiment`),
+    refetchInterval: query => (query.state.data?.status === 'ended' ? false : 60_000),
+    refetchIntervalInBackground: false,
+  });
+  const rows = data?.rows.filter(row => row.segment === segment) ?? [];
+  const a = rows.find(row => row.variant === 'A');
+  const b = rows.find(row => row.variant === 'B');
+  const difference =
+    a?.exposed_visits && b?.exposed_visits
+      ? 100 * (b.engaged_visits / b.exposed_visits - a.engaged_visits / a.exposed_visits)
+      : null;
+  const excluded = data?.rows[0]?.mixed_or_qa_visits_excluded ?? 0;
+
+  return (
+    <Column gap>
+      <Row justifyContent="space-between" alignItems="center" gap wrap="wrap">
+        <h1 className={styles.title}>Test accueil A/B</h1>
+        <Button
+          onPress={() => {
+            void refetch();
+          }}
+          isDisabled={isFetching}
+        >
+          {isFetching ? 'Actualisation…' : 'Actualiser'}
+        </Button>
+      </Row>
+      <LoadingPanel data={data} isLoading={isLoading} error={error}>
+        {data && (
+          <>
+            <Panel>
+              <Row gap alignItems="center" wrap="wrap">
+                <strong>
+                  {data.status === 'ended'
+                    ? 'Terminé'
+                    : data.status === 'scheduled'
+                      ? 'À venir'
+                      : 'En cours'}
+                </strong>
+                <Text>Répartition 50/50 · 14 jours</Text>
+              </Row>
+              <Text>
+                Du {date.format(new Date(data.start))} au {date.format(new Date(data.end))} — heure
+                de Tahiti.
+              </Text>
+              <Text>Ce rapport couvre uniquement la période du test sur l’accueil français.</Text>
+              <p className={styles.note}>
+                {data.status === 'ended'
+                  ? 'Collecte du test arrêtée. Les nouvelles visites reçoivent l’accueil actuel. Aucun gagnant n’est désigné automatiquement.'
+                  : 'Résultats provisoires : les sessions en cours peuvent encore devenir engagées. Attendre la fin du test pour décider.'}
+              </p>
+            </Panel>
+            <Panel title="Trafic de l’accueil et couverture du test">
+              <Text>
+                {number.format(data.coverage.homepage_visits)} visites de l’accueil français, pour{' '}
+                {number.format(data.coverage.homepage_pageviews)} pages vues depuis la correction du{' '}
+                {date.format(new Date(data.collectionStart))} (hors QA).
+              </Text>
+              <Text>
+                {number.format(data.coverage.measured_visits)} visites retenues dans A/B
+                {data.coverage.measured_pct === null
+                  ? ''
+                  : ` (${number.format(data.coverage.measured_pct)} % du trafic de l’accueil)`}
+                {' · '}
+                {number.format(data.coverage.excluded_visits)} visites QA exclues
+                {' · '}
+                {number.format(data.coverage.unmeasured_visits)} sans exposition A/B mesurée.
+              </Text>
+              <p className={styles.note}>
+                La version A/B est jointe à la page vue Umami elle-même : aucune attente de
+                consentement, de stockage local ou de focus pour compter une visite déjà reçue par
+                Umami. Chaque visite est affectée à sa première version observée, même après un
+                rechargement. Les bloqueurs et l’exclusion propre au tracker continuent de
+                s’appliquer.
+              </p>
+              <Text>
+                {number.format(data.coverage.mixed_visits ?? 0)} visite(s) ayant vu A et B,
+                conservées dans leur première version observée. Sans mémorisation autorisée de
+                l’affectation, un retour peut afficher une autre version.
+              </Text>
+              <Text>
+                Une visite correspond ici à une visite Umami, pas à une personne unique ni à chaque
+                rechargement. La répartition 50/50 est aléatoire à l’affectation ; elle ne garantit
+                pas deux effectifs égaux.
+              </Text>
+            </Panel>
+            <Panel title="Historique avant la correction">
+              <Text>
+                {number.format(data.legacyCoverage.homepage_visits)} visites de l’accueil, dont{' '}
+                {number.format(data.legacyCoverage.measured_visits)} mesurées par l’ancien suivi
+                soumis au consentement. Ces chiffres incomplets restent séparés de la nouvelle
+                collecte.
+              </Text>
+              {data.legacyRows
+                .filter(row => row.segment === 'all')
+                .map(row => (
+                  <Text key={row.variant}>
+                    Version {row.variant} : {number.format(row.exposed_visits)} visites exposées,{' '}
+                    {number.format(row.engaged_visits)} engagées.
+                  </Text>
+                ))}
+            </Panel>
+            <Panel title="Comparer l’engagement observé">
+              <Row gap wrap="wrap" aria-label="Appareils">
+                {segments.map(({ id, label }) => (
+                  <Button
+                    key={id}
+                    variant={segment === id ? 'primary' : 'outline'}
+                    aria-pressed={segment === id}
+                    onPress={() => setSegment(id)}
+                  >
+                    {label}
+                  </Button>
+                ))}
+              </Row>
+              <div className={styles.scroll}>
+                <table className={styles.table}>
+                  <caption className={styles.caption}>
+                    Visites mesurées depuis la correction —{' '}
+                    {segments.find(item => item.id === segment)?.label}
+                  </caption>
+                  <thead>
+                    <tr>
+                      <th scope="col">Version</th>
+                      <th scope="col">Visites exposées</th>
+                      <th scope="col">Visites engagées</th>
+                      <th scope="col">Taux d’engagement observé</th>
+                    </tr>
+                  </thead>
+                  <tbody>
+                    {rows.map(row => (
+                      <tr key={row.variant}>
+                        <th scope="row">
+                          <strong>{row.variant}</strong>
+                          <span className={styles.variant}>
+                            {row.variant === 'A' ? 'Accueil actuel' : 'Nouvel accueil'}
+                          </span>
+                        </th>
+                        <td>{number.format(row.exposed_visits)}</td>
+                        <td>{number.format(row.engaged_visits)}</td>
+                        <td className={styles.rate}>
+                          {row.engagement_pct === null
+                            ? '—'
+                            : `${number.format(row.engagement_pct)} %`}
+                        </td>
+                      </tr>
+                    ))}
+                  </tbody>
+                </table>
+              </div>
+              <Text>
+                {difference === null
+                  ? 'L’écart apparaîtra lorsqu’au moins une visite exposée aura été mesurée dans chacune des deux versions.'
+                  : `Écart observé B − A : ${difference > 0 ? '+' : ''}${number.format(difference)} point${Math.abs(difference) === 1 ? '' : 's'} de pourcentage. Cet écart seul ne prouve pas une amélioration.`}
+              </Text>
+              <Text>
+                Le taux correspond aux visites avec engagement observé divisées par toutes les
+                visites exposées à cette version.
+              </Text>
+            </Panel>
+            <Panel title="Ce qui compte comme engagement">
+              <Text>
+                Une autre page du site ouverte après l’accueil, ou au moins 20 secondes au premier
+                plan sur l’accueil avec une section après l’introduction vue.
+              </Text>
+              <Text>
+                Le temps passé en arrière-plan, un rechargement ou un simple défilement sans les 20
+                secondes ne suffisent pas.
+              </Text>
+              <Text>
+                Toutes les visites de l’accueil enregistrées par Umami sont incluses, sans dépendre
+                du consentement ou du stockage local. La navigation vers une autre page est
+                déterminée par les pages vues de la même visite. Le signal « 20 secondes et section
+                » conserve son fonctionnement consenti : ce taux décrit donc l’engagement observé.
+              </Text>
+              <Text>
+                {number.format(excluded)} session{excluded === 1 ? '' : 's'} exclue
+                {excluded === 1 ? '' : 's'} pour QA depuis la correction.
+              </Text>
+            </Panel>
+            <p className={styles.note}>
+              Données consultées le {date.format(new Date(data.generatedAt))} (Tahiti).
+              {data.status === 'ended'
+                ? ' Période du test clôturée.'
+                : ' Actualisation chaque minute lorsque cet onglet est visible.'}
+            </p>
+          </>
+        )}
+      </LoadingPanel>
+    </Column>
+  );
+}
