+import { readFileSync } from 'node:fs';
+import path from 'node:path';
+import vm from 'node:vm';
+import * as React from 'react';
+import { renderToStaticMarkup } from 'react-dom/server';
+import ts from 'typescript';
+
+const source = readFileSync(path.join(process.cwd(), 'src/app/(main)/websites/[websiteId]/home-experiment/HomeExperimentPage.tsx'), 'utf8');
+const rows = ['all', 'mobile', 'desktop'].flatMap(segment => ['A', 'B'].map(variant => ({
+  segment, variant, exposed_visits: segment === 'mobile' ? 0 : variant === 'A' ? 3 : 2,
+  engaged_visits: 0, engagement_pct: segment === 'mobile' ? null : 0,
+})));
+const data = {
+  rows, series: ['all', 'desktop'].flatMap(segment => ['A', 'B'].map(variant => ({
+    segment, variant, bucket: '2026-11-25T20:00:00Z', exposed_visits: variant === 'A' ? 3 : 2,
+  }))),
+  rangeStart: '2026-11-25T19:00:00Z', rangeEnd: '2026-11-25T23:00:00Z',
+  end: '2026-12-13T17:34:00Z', generatedAt: '2026-11-25T23:00:00Z', unit: 'hour',
+};
+const get = jest.fn();
+const query = jest.fn((_options: any) => ({ data, error: null, isLoading: false }));
+const chart = jest.fn((_props: any) => React.createElement('canvas'));
+const box = ({ children }) => React.createElement('div', {}, children);
+const moduleObject = { exports: {} as any };
+const requireMock = (id: string) => {
+  if (id === '@umami/react-zen') return {
+    Column: box, Row: box, Text: box,
+    Button: ({ children }) => React.createElement('button', {}, children),
+    Select: ({ children, value }) => React.createElement('select', { defaultValue: value }, children),
+    ListItem: ({ children, id }) => React.createElement('option', { value: id }, children),
+    useTheme: () => ({ theme: 'light' }),
+  };
+  if (id === '@/components/hooks') return { useApi: () => ({ get, useQuery: query }) };
+  if (id === '@/components/charts/Chart') return { Chart: chart };
+  if (id === '@/components/common/Panel') return { Panel: ({ title, children }) => React.createElement('section', {}, React.createElement('h2', {}, title), children) };
+  if (id === '@/components/common/LoadingPanel') return { LoadingPanel: box };
+  if (id === '@/lib/colors') return { getThemeColors: () => ({ colors: { chart: { visitors: {}, views: {} } } }) };
+  if (id === '@/lib/home-experiment-range') return { HOME_EXPERIMENT_PERIODS: [{ id: '24h', label: 'Dernières 24 heures' }, { id: '7d', label: '7 derniers jours' }] };
+  if (id.endsWith('.css')) return { default: {} };
+  return require(id);
+};
+const compiled = ts.transpileModule(source, { compilerOptions: { module: ts.ModuleKind.CommonJS, jsx: ts.JsxEmit.ReactJSX } }).outputText;
+vm.runInNewContext(`(function(require,module,exports){${compiled}\n})`, {})(requireMock, moduleObject, moduleObject.exports);
+const { HomeExperimentPage } = moduleObject.exports;
+
+afterEach(() => { jest.restoreAllMocks(); jest.clearAllMocks(); });
+
+test('renders only the graph and comparison, with no refresh action or historical panels', async () => {
+  const html = renderToStaticMarkup(React.createElement(HomeExperimentPage, { websiteId: 'site' }));
+  expect((html.match(/<section>/g) || [])).toHaveLength(2);
+  expect(html).toContain('Visites par version');
+  expect(html).toContain('Comparer l’engagement observé');
+  expect(html).not.toMatch(/Actualiser|Synchroniser|Historique|couverture du test/);
+  expect(html).toContain('Dernières 24 heures');
+  expect(html).toContain('13 déc. 2026');
+  const options = query.mock.calls[0][0];
+  expect(options.queryKey).toEqual(['home-experiment', 'site', '24h']);
+  expect(options).toMatchObject({ staleTime: 0, refetchOnMount: 'always', refetchOnWindowFocus: 'always', refetchOnReconnect: 'always', refetchInterval: 15000, retry: 2 });
+  await options.queryFn();
+  expect(get).toHaveBeenCalledWith('/websites/site/home-experiment', { period: '24h' });
+  expect(chart.mock.calls[0][0].chartData.datasets.map(item => item.data.reduce((sum, n) => sum + n, 0))).toEqual([3, 2]);
+});
+
+test('a changed date gets its own request and mobile filters both the graph and table', () => {
+  jest.spyOn(require('react'), 'useState').mockReturnValueOnce(['mobile', jest.fn()] as any).mockReturnValueOnce(['7d', jest.fn()] as any);
+  const html = renderToStaticMarkup(React.createElement(HomeExperimentPage, { websiteId: 'site' }));
+  expect(query.mock.calls[0][0].queryKey).toEqual(['home-experiment', 'site', '7d']);
+  expect(html).toContain('A 0, B 0');
+  expect(chart.mock.calls[0][0].chartData.datasets.every(item => item.data.every(n => n === 0))).toBe(true);
+  expect(html).not.toContain('0 %');
+});
