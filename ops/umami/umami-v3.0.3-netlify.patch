+import { Client } from 'pg';
+import { HOME_PAGEVIEW_REPORT_SQL, HOME_PAGEVIEW_TRAFFIC_SQL, HOME_PAGEVIEW_SERIES_SQL } from '../src/lib/home-pageview-report';
+
+const fixture = `WITH fixture(id,visit,sec,kind,path,tag,screen,host) AS (VALUES
+  ('a1','a',1,1,'/','home-intro-v2:A','390x844','tahitiguestboat.com'),
+  ('a2','a',2,1,'/','home-intro-v2:A','390x844','tahitiguestboat.com'),
+  ('a3','a',3,1,'/contact/',NULL,'390x844','tahitiguestboat.com'),
+  ('b1','b',1,1,'/','home-intro-v2:B','1280x720','tahitiguestboat.com'),
+  ('b2','b',2,1,'/#contact','home-intro-v2:B','1280x720','tahitiguestboat.com'),
+  ('h1','hash',1,1,'/#contact','home-intro-v2:A','390x844','tahitiguestboat.com'),
+  ('m1','mixed',1,1,'/','home-intro-v2:A','1280x720','tahitiguestboat.com'),
+  ('m2','mixed',2,1,'/','home-intro-v2:B','1280x720','tahitiguestboat.com'),
+  ('q1','qa',1,1,'/','home-intro-v2:B:qa','1280x720','tahitiguestboat.com'),
+  ('u1','unknown',1,1,'/',NULL,'1280x720','tahitiguestboat.com'),
+  ('t1','time',1,1,'/','home-intro-v2:B','1280x720','tahitiguestboat.com'),
+  ('t2','time',22,2,'/',NULL,'1280x720','tahitiguestboat.com'),
+  ('o1','orphan',22,2,'/',NULL,'1280x720','tahitiguestboat.com'),
+  ('before','before',-1,1,'/','home-intro-v2:A','1280x720','tahitiguestboat.com'),
+  ('end','end',100,1,'/','home-intro-v2:A','1280x720','tahitiguestboat.com'),
+  ('preview','preview',1,1,'/','home-intro-v2:A','1280x720','preview.netlify.app'),
+  ('en','en',1,1,'/en/','home-intro-v2:A','1280x720','tahitiguestboat.com')
+), session AS (SELECT DISTINCT visit AS session_id, screen, $1::uuid AS website_id FROM fixture), website_event AS (
+ SELECT id AS event_id,visit AS visit_id,$2::timestamptz+sec*interval '1 second' AS created_at,
+  kind AS event_type,path AS url_path,tag,visit AS session_id,host AS hostname,$1::uuid AS website_id,
+  CASE WHEN kind=2 THEN 'home_intro_engaged' ELSE NULL END AS event_name
+ FROM fixture
+), event_data AS (
+ SELECT f.id AS website_event_id,d.key AS data_key,d.value AS string_value
+ FROM fixture f, LATERAL jsonb_each_text('{"reason":"20s_and_section","variant":"B","experiment":"home-intro-v1"}'::jsonb) d
+ WHERE f.kind=2
+), `;
+const bind = (sql: string) => fixture + sql.slice('WITH '.length)
+  .replaceAll('{{websiteId::uuid}}','$1::uuid').replaceAll('{{startDate}}','$2::timestamptz').replaceAll('{{endDate}}','$3::timestamptz');
+const db = new Client({ connectionString: process.env.DATABASE_URL });
+await db.connect();
+try {
+  await db.query('BEGIN READ ONLY');
+  const args = ['388d24a4-9679-4b9c-992d-5ac0427b099c','2026-11-25T06:00:00Z','2026-11-25T06:01:40Z'];
+  const { rows } = await db.query(bind(HOME_PAGEVIEW_REPORT_SQL),args);
+  const a=rows.find(r=>r.variant==='A'&&r.segment==='all');
+  const b=rows.find(r=>r.variant==='B'&&r.segment==='all');
+  assert.equal(a.exposed_visits,3); assert.equal(b.exposed_visits,2);
+  assert.equal(a.engaged_visits,1); assert.equal(b.engaged_visits,1);
+  assert.equal(a.next_page_visits,1); assert.equal(b.time_and_section_visits,1);
+  assert.equal(rows.find(r=>r.variant==='A'&&r.segment==='mobile').exposed_visits,2);
+  const { rows: [coverage] } = await db.query(bind(HOME_PAGEVIEW_TRAFFIC_SQL),args);
+  assert.deepEqual(coverage,{homepage_pageviews:9,homepage_visits:6,measured_visits:5,excluded_visits:1,unmeasured_visits:1,measured_pct:'83.3',mixed_visits:1});
+  for (const unit of ['hour', 'day']) {
+    const { rows: series } = await db.query(bind(HOME_PAGEVIEW_SERIES_SQL).replaceAll('{{unit}}', '$4::text'), [...args, unit]);
+    for (const row of rows) {
+      assert.equal(series.filter(point => point.variant === row.variant && point.segment === row.segment)
+        .reduce((sum, point) => sum + point.exposed_visits, 0), row.exposed_visits);
+    }
+  }
+  for (const v of ['A','B']) {
+    assert.equal(rows.find(r=>r.variant===v&&r.segment==='all').exposed_visits,
+      rows.filter(r=>r.variant===v&&r.segment!=='all').reduce((n,r)=>n+r.exposed_visits,0));
+  }
+  console.log('Native pageview SQL fixtures passed: first variant per visit, reload deduplication, mixed visits retained, QA excluded, next-page engagement without consent storage, observed 20s, orphan events, host/path/date boundaries, exact coverage. No rows written.');
+} finally { await db.query('ROLLBACK'); await db.end(); }
