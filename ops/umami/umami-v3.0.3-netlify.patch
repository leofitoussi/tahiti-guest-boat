+++ b/ops/verify-migration.ts
@@ -0,0 +1,64 @@
+import 'dotenv/config';
+import assert from 'node:assert/strict';
+import { Client } from 'pg';
+import { secret } from '../src/lib/crypto';
+import { createSecureToken } from '../src/lib/jwt';
+
+// Read-only smoke check. Uses a five-minute admin token held only in memory.
+// Reads APP_SECRET and DATABASE_URL from the ignored local .env file.
+const base = process.argv[2];
+assert(base?.startsWith('https://'), 'Provide the HTTPS migration preview URL');
+const db = new Client({ connectionString: process.env.DATABASE_URL });
+await db.connect();
+try {
+  const { rows: users } = await db.query(
+    `SELECT user_id, role FROM public."user"
+     WHERE role = 'admin' AND deleted_at IS NULL LIMIT 1`,
+  );
+  assert(users[0], 'Restored admin account missing');
+  const token = createSecureToken({ userId: users[0].user_id, role: users[0].role }, secret(), {
+    expiresIn: '5m',
+  });
+  async function get(path: string, auth = false) {
+    const response = await fetch(new URL(path, base), {
+      headers: auth ? { authorization: `Bearer ${token}` } : {},
+      signal: AbortSignal.timeout(60_000),
+    });
+    assert.equal(response.status, 200, `${path}: HTTP ${response.status}`);
+    return response;
+  }
+  assert.deepEqual(await (await get('/api/heartbeat')).json(), { ok: true });
+  assert((await (await get('/script.js')).text()).length > 1000, 'Tracker missing');
+  assert((await (await get('/login')).text()).includes('<html'), 'Login page missing');
+  const { rows: websites } = await db.query(
+    `SELECT w.website_id, w.name, count(e.event_id)::int AS pageviews
+     FROM public.website w LEFT JOIN public.website_event e
+       ON e.website_id = w.website_id AND e.event_type != 2
+     WHERE w.deleted_at IS NULL GROUP BY w.website_id, w.name`,
+  );
+  const start = Date.parse('2026-09-01T00:00:00Z');
+  const end = Date.now();
+  for (const website of websites) {
+    const path = `/api/websites/${website.website_id}/stats?startAt=${start}&endAt=${end}&timezone=UTC`;
+    const stats = await (await get(path, true)).json();
+    assert.equal(Number(stats.pageviews), website.pageviews, `${website.name}: history differs`);
+    console.log(
+      JSON.stringify({
+        website: website.name,
+        pageviews: Number(stats.pageviews),
+        historyMatches: true,
+      }),
+    );
+  }
+  console.log(
+    JSON.stringify({
+      heartbeat: true,
+      tracker: true,
+      login: true,
+      authenticatedStats: true,
+      websites: websites.length,
+    }),
+  );
+} finally {
+  await db.end();
+}
