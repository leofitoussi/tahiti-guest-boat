+    const args = [HOME_EXPERIMENT_WEBSITE_ID, selected.rangeStart, selected.rangeEnd];
+    const { rows: table } = await db.query(bind(HOME_PAGEVIEW_REPORT_SQL), args);
+    assert.deepEqual(selected.rows, normalize(table), `${period}: API/table differs from SQL`);
+    const { rows: series } = await db.query(bind(HOME_PAGEVIEW_SERIES_SQL), [...args, selected.unit]);
+    assert.deepEqual(selected.series, series.map(row => ({ ...row, bucket: row.bucket.toISOString() })), `${period}: API/chart differs from SQL`);
+    for (const row of selected.rows) {
+      assert.equal(selected.series.filter(point => point.variant === row.variant && point.segment === row.segment)
+        .reduce((sum, point) => sum + point.exposed_visits, 0), row.exposed_visits, `${period}: chart and table disagree`);
+    }
+  }
+  assert.equal((await get(`${path}?period=invalid`, true)).status, 400);
+  assert.deepEqual(await (await get('/api/heartbeat')).json(), { ok: true });
+  assert((await (await get('/script.js')).text()).length > 1000);
+  assert((await (await get('/login')).text()).includes('<html'));
+  assert.equal((await get(`/websites/${HOME_EXPERIMENT_WEBSITE_ID}/home-experiment`)).status, 200);
+  console.log(
+    JSON.stringify(
+      {
+        base,
+        authenticatedReport: true,
+        anonymousRejected: true,
+        databaseMatches: true,
+        segmentTotalsReconcile: true,
+        allDateFiltersMatchDatabaseAndChart: true,
+        heartbeat: true,
+        tracker: true,
+        login: true,
+        status: report.status,
+        rows: report.rows,
+        coverage: report.coverage,
+        collectionStart: report.collectionStart,
+        legacyCoverage: report.legacyCoverage,
+      },
+      null,
+      2,
+    ),
