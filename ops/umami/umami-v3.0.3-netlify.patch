@@ -0,0 +1,94 @@
+// TGB-68: native homepage pageviews carry the variant before tracker execution.
+// Updated to the site's actual published_at before publishing this report.
+export const HOME_PAGEVIEW_COLLECTION_START = '2026-11-25T06:31:07.153Z';
+
+const VISITS = `WITH pageviews AS (
+  SELECT e.event_id, e.visit_id, e.created_at, split_part(e.url_path, '#', 1) AS url_path, e.tag, s.screen
+  FROM website_event e LEFT JOIN session s ON s.session_id=e.session_id AND s.website_id=e.website_id
+  WHERE e.website_id = {{websiteId::uuid}}
+    AND e.hostname IN ('tahitiguestboat.com', 'www.tahitiguestboat.com')
+    AND e.event_type = 1 AND e.created_at >= {{startDate}} AND e.created_at < {{endDate}}
+), tagged AS (
+  SELECT *, split_part(tag, ':', 2) AS variant,
+    CASE WHEN screen ~ '^[0-9]{1,5}x[0-9]+$'
+      THEN CASE WHEN split_part(screen, 'x', 1)::int < 768 THEN 'mobile' ELSE 'desktop' END
+      ELSE 'desktop' END AS viewport
+  FROM pageviews WHERE url_path = '/' AND tag ~ '^home-intro-v2:[AB](:qa)?$'
+), qa AS (
+  SELECT DISTINCT visit_id FROM tagged WHERE tag LIKE '%:qa'
+), homepage AS (
+  SELECT p.* FROM pageviews p WHERE p.url_path = '/'
+    AND NOT EXISTS (SELECT 1 FROM qa WHERE qa.visit_id = p.visit_id)
+), exposure AS (
+  SELECT DISTINCT ON (t.visit_id) t.visit_id, t.variant, t.viewport, t.created_at AS exposed_at
+  FROM tagged t WHERE NOT EXISTS (SELECT 1 FROM qa WHERE qa.visit_id = t.visit_id)
+  ORDER BY t.visit_id, t.created_at, t.event_id
+), attention_events AS (
+  SELECT e.event_id, e.visit_id, e.created_at,
+    max(d.string_value) FILTER (WHERE d.data_key='experiment') AS experiment,
+    max(d.string_value) FILTER (WHERE d.data_key='variant') AS variant,
+    max(d.string_value) FILTER (WHERE d.data_key='active_ms') AS active_ms,
+    max(d.string_value) FILTER (WHERE d.data_key='section_seen') AS section_seen,
+    max(d.string_value) FILTER (WHERE d.data_key='qa') AS qa
+  FROM website_event e JOIN event_data d ON d.website_event_id=e.event_id
+  WHERE e.website_id={{websiteId::uuid}} AND e.event_name='home_intro_attention'
+    AND e.hostname IN ('tahitiguestboat.com', 'www.tahitiguestboat.com')
+    AND split_part(e.url_path, '#', 1)='/'
+    AND e.created_at >= {{startDate}} AND e.created_at < {{endDate}}
+  GROUP BY e.event_id, e.visit_id, e.created_at
+), attention_visits AS (
+  SELECT x.visit_id FROM exposure x JOIN attention_events a ON a.visit_id=x.visit_id
+    AND a.created_at >= x.exposed_at
+  WHERE a.experiment='home-intro-v1' AND a.variant IN ('A','B') AND coalesce(a.qa,'false') <> 'true'
+  GROUP BY x.visit_id
+  HAVING sum(CASE WHEN a.active_ms ~ '^[0-9]{1,5}$'
+    THEN least(20000, a.active_ms::int) ELSE 0 END) >= 20000
+    AND bool_or(a.section_seen='true')
+), visits AS (
+  SELECT x.*,
+    EXISTS (SELECT 1 FROM pageviews p WHERE p.visit_id = x.visit_id
+      AND p.created_at > x.exposed_at AND p.url_path <> '/'
+      AND p.url_path NOT LIKE '/home-%') AS next_page,
+    EXISTS (SELECT 1 FROM website_event e
+      JOIN event_data reason ON reason.website_event_id=e.event_id AND reason.data_key='reason' AND reason.string_value='20s_and_section'
+      JOIN event_data variant ON variant.website_event_id=e.event_id AND variant.data_key='variant' AND variant.string_value=x.variant
+      JOIN event_data experiment ON experiment.website_event_id=e.event_id AND experiment.data_key='experiment' AND experiment.string_value='home-intro-v1'
+      WHERE e.website_id = {{websiteId::uuid}} AND e.visit_id=x.visit_id
+        AND e.hostname IN ('tahitiguestboat.com', 'www.tahitiguestboat.com')
+        AND e.event_name='home_intro_engaged' AND e.created_at >= x.exposed_at
+        AND e.created_at < {{endDate}})
+      OR EXISTS (SELECT 1 FROM attention_visits a WHERE a.visit_id=x.visit_id) AS time_and_section
+  FROM exposure x
+)`;
+
+export const HOME_PAGEVIEW_REPORT_SQL = `${VISITS}, groups AS (
+  SELECT a.variant, s.segment FROM (VALUES ('A'), ('B')) a(variant)
+  CROSS JOIN (VALUES ('all'), ('mobile'), ('desktop')) s(segment)
+)
+SELECT g.variant, g.segment, count(v.visit_id)::int AS exposed_visits,
+  count(v.visit_id) FILTER (WHERE v.next_page OR v.time_and_section)::int AS engaged_visits,
+  round(100.0 * count(v.visit_id) FILTER (WHERE v.next_page OR v.time_and_section) / nullif(count(v.visit_id), 0), 1) AS engagement_pct,
+  count(v.visit_id) FILTER (WHERE v.next_page)::int AS next_page_visits,
+  count(v.visit_id) FILTER (WHERE v.time_and_section)::int AS time_and_section_visits,
+  (SELECT count(*)::int FROM qa) AS mixed_or_qa_visits_excluded
+FROM groups g LEFT JOIN visits v ON v.variant = g.variant AND (g.segment='all' OR v.viewport=g.segment)
+GROUP BY g.variant, g.segment ORDER BY g.segment, g.variant;`;
+
+export const HOME_PAGEVIEW_TRAFFIC_SQL = `${VISITS}
+SELECT (SELECT count(*)::int FROM homepage) AS homepage_pageviews,
+  count(DISTINCT h.visit_id)::int AS homepage_visits,
+  count(DISTINCT h.visit_id) FILTER (WHERE x.visit_id IS NOT NULL)::int AS measured_visits,
+  (SELECT count(*)::int FROM qa) AS excluded_visits,
+  count(DISTINCT h.visit_id) FILTER (WHERE x.visit_id IS NULL)::int AS unmeasured_visits,
+  round(100.0 * count(DISTINCT h.visit_id) FILTER (WHERE x.visit_id IS NOT NULL) / nullif(count(DISTINCT h.visit_id), 0), 1) AS measured_pct,
+  (SELECT count(*)::int FROM (SELECT t.visit_id FROM tagged t JOIN exposure x USING(visit_id)
+    GROUP BY t.visit_id HAVING count(DISTINCT t.variant)>1) mixed) AS mixed_visits
+FROM homepage h LEFT JOIN exposure x USING(visit_id);`;
+
+// Bucket the same deduplicated exposures as the table, in Tahiti time.
+export const HOME_PAGEVIEW_SERIES_SQL = `${VISITS}
+SELECT date_trunc({{unit}}, v.exposed_at AT TIME ZONE 'Pacific/Tahiti') AT TIME ZONE 'Pacific/Tahiti' AS bucket,
+  v.variant, s.segment, count(*)::int AS exposed_visits
+FROM visits v CROSS JOIN (VALUES ('all'), ('mobile'), ('desktop')) s(segment)
+WHERE s.segment='all' OR v.viewport=s.segment
+GROUP BY bucket, v.variant, s.segment ORDER BY bucket, v.variant, s.segment;`;
