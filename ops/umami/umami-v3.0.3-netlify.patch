+import 'dotenv/config';
+import assert from 'node:assert/strict';
+import { Client } from 'pg';
+import {
+  HOME_EXPERIMENT_END,
+  HOME_EXPERIMENT_REPORT_SQL,
+  HOME_EXPERIMENT_TRAFFIC_SQL,
+  HOME_EXPERIMENT_START,
+  HOME_EXPERIMENT_WEBSITE_ID,
+} from '../src/lib/home-experiment-report';
+
+// Entirely read-only: synthetic rows exist only within the SELECT's CTEs.
+// Exercise duplicate events, QA/mixed visits, ordering and reporting boundaries
+// without inserting/deleting events or changing the live analytics schema.
+const fixture = `WITH fixture(id, visit, seconds, name, variant, viewport, qa, host) AS (
+  VALUES
+    ('a1', 'a-engaged', 1, 'home_intro_exposed', 'A', 'mobile', NULL, 'tahitiguestboat.com'),
+    ('a2', 'a-engaged', 2, 'home_intro_exposed', 'A', 'mobile', NULL, 'tahitiguestboat.com'),
+    ('a3', 'a-engaged', 3, 'home_intro_engaged', 'A', 'mobile', NULL, 'tahitiguestboat.com'),
+    ('a4', 'a-engaged', 4, 'home_intro_engaged', 'A', 'mobile', NULL, 'tahitiguestboat.com'),
+    ('a5', 'a-not-engaged', 1, 'home_intro_exposed', 'A', 'desktop', NULL, 'tahitiguestboat.com'),
+    ('a6', 'a-order', 1, 'home_intro_engaged', 'A', 'desktop', NULL, 'tahitiguestboat.com'),
+    ('a7', 'a-order', 2, 'home_intro_exposed', 'A', 'desktop', NULL, 'tahitiguestboat.com'),
+    ('b1', 'b-engaged', 1, 'home_intro_exposed', 'B', 'desktop', NULL, 'tahitiguestboat.com'),
+    ('b2', 'b-engaged', 3, 'home_intro_engaged', 'B', 'desktop', NULL, 'tahitiguestboat.com'),
+    ('q1', 'qa', 1, 'home_intro_exposed', 'B', 'mobile', NULL, 'tahitiguestboat.com'),
+    ('q2', 'qa', 2, 'home_intro_engaged', 'B', 'mobile', 'true', 'tahitiguestboat.com'),
+    ('m1', 'mixed', 1, 'home_intro_exposed', 'A', 'mobile', NULL, 'tahitiguestboat.com'),
+    ('m2', 'mixed', 2, 'home_intro_engaged', 'B', 'mobile', NULL, 'tahitiguestboat.com'),
+    ('p1', 'preview', 1, 'home_intro_exposed', 'B', 'mobile', NULL, 'preview.netlify.app'),
+    ('x1', 'before-start', -1, 'home_intro_exposed', 'B', 'mobile', NULL, 'tahitiguestboat.com'),
+    ('x2', 'at-end', 1814400, 'home_intro_exposed', 'B', 'mobile', NULL, 'tahitiguestboat.com'),
+    ('x3', 'after-end', 1814401, 'home_intro_exposed', 'B', 'mobile', NULL, 'tahitiguestboat.com')
+), website_event AS (
+  SELECT id AS event_id, visit AS visit_id, name AS event_name, host AS hostname,
+    $1::uuid AS website_id, $2::timestamptz + seconds * interval '1 second' AS created_at,
+    2 AS event_type, '/' AS url_path
+  FROM fixture
+  UNION ALL
+  SELECT id, visit, NULL, 'tahitiguestboat.com', $1::uuid,
+    $2::timestamptz + interval '1 second', 1, '/'
+  FROM (VALUES ('pv1', 'a-engaged'), ('pv2', 'a-engaged'), ('pv3', 'b-engaged'),
+    ('pv4', 'qa'), ('pv5', 'mixed'), ('pv6', 'untracked'), ('pv7', 'untracked')) h(id, visit)
+), event_data AS (
+  SELECT id AS website_event_id, data.key AS data_key, data.value AS string_value
+  FROM fixture, LATERAL jsonb_each_text(jsonb_strip_nulls(jsonb_build_object(
+    'experiment', 'home-intro-v1', 'variant', variant, 'viewport', viewport,
+    'qa', qa, 'reason', 'next_page'
+  ))) data
+), `;
+const sql = HOME_EXPERIMENT_REPORT_SQL.replace('{{websiteId::uuid}}', '$1::uuid')
+  .replace('{{startDate}}', '$2::timestamptz')
+  .replace('{{endDate}}', '$3::timestamptz');
+const db = new Client({ connectionString: process.env.DATABASE_URL });
+await db.connect();
+try {
+  await db.query('BEGIN READ ONLY');
+  const { rows } = await db.query(fixture + sql.slice('WITH '.length), [
+    HOME_EXPERIMENT_WEBSITE_ID,
+    HOME_EXPERIMENT_START,
+    HOME_EXPERIMENT_END,
+  ]);
+  const find = (variant: string, segment: string) =>
+    rows.find(row => row.variant === variant && row.segment === segment);
+  assert.equal(rows.length, 6);
+  assert.equal(find('A', 'all').exposed_visits, 3);
+  assert.equal(find('A', 'all').engaged_visits, 1);
+  assert.equal(Number(find('A', 'all').engagement_pct), 33.3);
+  assert.equal(find('B', 'all').exposed_visits, 1);
+  assert.equal(find('B', 'all').engaged_visits, 1);
+  assert.equal(Number(find('B', 'all').engagement_pct), 100);
+  assert.equal(find('A', 'mobile').exposed_visits, 1);
+  assert.equal(find('A', 'desktop').exposed_visits, 2);
+  assert.equal(find('A', 'desktop').engaged_visits, 0);
+  assert.equal(find('B', 'mobile').exposed_visits, 0);
+  assert.equal(find('B', 'mobile').engagement_pct, null);
+  assert(rows.every(row => Number(row.mixed_or_qa_visits_excluded) === 2));
+  for (const variant of ['A', 'B']) {
+    for (const key of ['exposed_visits', 'engaged_visits']) {
+      assert.equal(
+        find(variant, 'all')[key],
+        find(variant, 'mobile')[key] + find(variant, 'desktop')[key],
+      );
+    }
+  }
+  const coverageSql = HOME_EXPERIMENT_TRAFFIC_SQL
+    .replaceAll('{{websiteId::uuid}}', '$1::uuid')
+    .replaceAll('{{startDate}}', '$2::timestamptz')
+    .replaceAll('{{endDate}}', '$3::timestamptz');
+  const { rows: [coverage] } = await db.query(fixture + coverageSql.slice('WITH '.length), [
+    HOME_EXPERIMENT_WEBSITE_ID, HOME_EXPERIMENT_START, HOME_EXPERIMENT_END,
+  ]);
+  assert.deepEqual(coverage, {
+    homepage_pageviews: 7, homepage_visits: 5, measured_visits: 2,
+    excluded_visits: 2, unmeasured_visits: 1, measured_pct: '40.0',
+  }, 'Coverage must reconcile actual homepage visit IDs, not subtract unrelated event totals');
+  console.log(
+    'Read-only SQL fixtures passed: deduplication, QA/mixed exclusion, ordering, boundaries, mobile/desktop and reconciliation.',
+  );
+} finally {
+  await db.query('ROLLBACK');
+  await db.end();
+}
