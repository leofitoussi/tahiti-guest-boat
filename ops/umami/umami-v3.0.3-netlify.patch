+    assert.equal(c.sends.filter(e=>e.payload.name).length,0);c.focus(true);
+   }
+   if(fixture.choice!=='granted')c.section();
+   c.advance(19_000);assert.equal(c.sends.filter(e=>e.payload.name).length,0);
+   c.advance(1000);await c.drain();
+   if(fixture.choice==='granted'){
+    assert.equal(c.sends.at(-1).payload.data.section_seen,'false');c.section();await c.drain();
+    assert.equal(c.sends.at(-1).payload.data.active_ms,'0');
+   }
+   c.section();c.advance(5000);await c.drain();
+   const signals=c.sends.filter(e=>e.payload.name==='home_intro_attention');
+   assert.equal(signals.reduce((sum,e)=>sum+Number(e.payload.data.active_ms),0),20_000);
+   assert(signals.some(e=>e.payload.data.section_seen==='true'));assert(signals.every(e=>e.payload.url==='/'));
