@@ -0,0 +1,131 @@
+'use client';
+import { Button, Column, ListItem, Row, Select, Text, useTheme } from '@umami/react-zen';
+import { useState } from 'react';
+import { Chart } from '@/components/charts/Chart';
+import { LoadingPanel } from '@/components/common/LoadingPanel';
+import { Panel } from '@/components/common/Panel';
+import { useApi } from '@/components/hooks';
+import { getThemeColors } from '@/lib/colors';
+import { HOME_EXPERIMENT_PERIODS, type HomeExperimentPeriod } from '@/lib/home-experiment-range';
+import type { HomeExperimentReport, HomeExperimentSegment } from '@/lib/home-experiment-report';
+import styles from './HomeExperimentPage.module.css';
+
+const segments: { id: HomeExperimentSegment; label: string }[] = [
+  { id: 'all', label: 'Tous les appareils' },
+  { id: 'mobile', label: 'Mobile' },
+  { id: 'desktop', label: 'Ordinateur' },
+];
+const number = new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 1 });
+const date = new Intl.DateTimeFormat('fr-FR', {
+  dateStyle: 'medium', timeStyle: 'short', timeZone: 'Pacific/Tahiti',
+});
+
+export const homeExperimentRefresh = {
+  staleTime: 0,
+  refetchOnMount: 'always' as const,
+  refetchOnWindowFocus: 'always' as const,
+  refetchOnReconnect: 'always' as const,
+  refetchInterval: 15_000,
+  refetchIntervalInBackground: false,
+  retry: 2,
+};
+
+export function HomeExperimentPage({ websiteId }: { websiteId: string }) {
+  const [segment, setSegment] = useState<HomeExperimentSegment>('all');
+  const [period, setPeriod] = useState<HomeExperimentPeriod>('24h');
+  const { theme } = useTheme();
+  const { colors } = getThemeColors(theme);
+  const { get, useQuery } = useApi();
+  const { data, error, isLoading } = useQuery<HomeExperimentReport>({
+    queryKey: ['home-experiment', websiteId, period],
+    queryFn: () => get(`/websites/${websiteId}/home-experiment`, { period }),
+    ...homeExperimentRefresh,
+  });
+  const rows = data?.rows.filter(row => row.segment === segment) ?? [];
+  const a = rows.find(row => row.variant === 'A');
+  const b = rows.find(row => row.variant === 'B');
+  const difference = a?.exposed_visits && b?.exposed_visits
+    ? 100 * (b.engaged_visits / b.exposed_visits - a.engaged_visits / a.exposed_visits) : null;
+  const buckets: number[] = [];
+  if (data) {
+    const step = data.unit === 'hour' ? 3600000 : 86400000;
+    // Tahiti is UTC-10 with no daylight saving changes.
+    const offset = 10 * 3600000;
+    const first = Math.floor((Date.parse(data.rangeStart) - offset) / step) * step + offset;
+    for (let value = first; value < Date.parse(data.rangeEnd); value += step) buckets.push(value);
+  }
+  const tickDate = new Intl.DateTimeFormat('fr-FR', data?.unit === 'hour'
+    ? { hour: '2-digit', minute: '2-digit', timeZone: 'Pacific/Tahiti' }
+    : { day: 'numeric', month: 'short', timeZone: 'Pacific/Tahiti' });
+  const chartData = {
+    labels: buckets.map(value => tickDate.format(value)),
+    datasets: ['A', 'B'].map((variant, index) => ({
+      label: variant === 'A' ? 'A · Accueil actuel' : 'B · Nouvel accueil',
+      data: buckets.map(value => data?.series?.find(point => point.variant === variant
+        && point.segment === segment && Date.parse(point.bucket) === value)?.exposed_visits ?? 0),
+      ...colors.chart[index === 0 ? 'visitors' : 'views'],
+      borderWidth: 1,
+    })),
+  };
+
+  return (
+    <Column gap>
+      <Row justifyContent="space-between" alignItems="center" gap wrap="wrap">
+        <h1 className={styles.title}>Test accueil A/B</h1>
+        <Select aria-label="Période du test" value={period}
+          onChange={value => setPeriod(value as HomeExperimentPeriod)}>
+          {HOME_EXPERIMENT_PERIODS.map(item => <ListItem key={item.id} id={item.id}>{item.label}</ListItem>)}
+        </Select>
+      </Row>
+      <Row gap wrap="wrap" aria-label="Appareils">
+        {segments.map(({ id, label }) => (
+          <Button key={id} variant={segment === id ? 'primary' : 'outline'}
+            aria-pressed={segment === id} onPress={() => setSegment(id)}>{label}</Button>
+        ))}
+      </Row>
+      <LoadingPanel data={data} isLoading={isLoading} error={data ? undefined : error}>
+        {data && <>
+          <Panel title="Visites par version">
+            <p className={styles.note}>
+              Accueil français · {date.format(new Date(data.rangeStart))} → {date.format(new Date(data.rangeEnd))} (Tahiti)
+            </p>
+            <div role="img" aria-label={`Visites par version : A ${a?.exposed_visits ?? 0}, B ${b?.exposed_visits ?? 0}`}>
+              <Chart type="bar" height="300px" chartData={chartData} animationDuration={0}
+                chartOptions={{
+                  scales: {
+                    x: { grid: { display: false }, ticks: { color: colors.chart.text, maxRotation: 0, maxTicksLimit: 12 } },
+                    y: { beginAtZero: true, ticks: { precision: 0, color: colors.chart.text }, grid: { color: colors.chart.line } },
+                  },
+                  plugins: { legend: { display: false }, tooltip: { enabled: true } },
+                }} />
+            </div>
+          </Panel>
+          <Panel title="Comparer l’engagement observé">
+            <div className={styles.scroll}>
+              <table className={styles.table}>
+                <caption className={styles.caption}>{segments.find(item => item.id === segment)?.label} · même période que le graphique</caption>
+                <thead><tr>
+                  <th scope="col">Version</th><th scope="col">Visites exposées</th>
+                  <th scope="col">Visites engagées</th><th scope="col">Taux d’engagement observé</th>
+                </tr></thead>
+                <tbody>{rows.map(row => <tr key={row.variant}>
+                  <th scope="row"><strong>{row.variant}</strong><span className={styles.variant}>
+                    {row.variant === 'A' ? 'Accueil actuel' : 'Nouvel accueil'}
+                  </span></th>
+                  <td>{number.format(row.exposed_visits)}</td><td>{number.format(row.engaged_visits)}</td>
+                  <td className={styles.rate}>{row.engagement_pct === null ? '—' : `${number.format(row.engagement_pct)} %`}</td>
+                </tr>)}</tbody>
+              </table>
+            </div>
+            <Text>{difference === null ? 'Pas encore de visites dans les deux versions sur cette période.'
+              : `Écart B − A : ${difference > 0 ? '+' : ''}${number.format(difference)} point${Math.abs(difference) === 1 ? '' : 's'}.`}</Text>
+            <p className={styles.note} role="status">
+              {error ? 'Connexion interrompue · nouvelle tentative automatique.'
+                : `Mis à jour à ${date.format(new Date(data.generatedAt))} · fin du test le ${date.format(new Date(data.end))} (Tahiti).`}
+            </p>
+          </Panel>
+        </>}
+      </LoadingPanel>
+    </Column>
+  );
+}
