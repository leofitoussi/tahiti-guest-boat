+import { HOME_EXPERIMENT_END } from './home-experiment-report';
+import { HOME_PAGEVIEW_COLLECTION_START } from './home-pageview-report';
+
+export const HOME_EXPERIMENT_PERIODS = [
+  { id: '24h', label: 'Dernières 24 heures' },
+  { id: '7d', label: '7 derniers jours' },
+  { id: '30d', label: '30 derniers jours' },
+  { id: 'all', label: 'Toute la période du test' },
+] as const;
+export type HomeExperimentPeriod = typeof HOME_EXPERIMENT_PERIODS[number]['id'];
+
+export function homeExperimentRange(period: string, now: number) {
+  if (!HOME_EXPERIMENT_PERIODS.some(item => item.id === period)) return null;
+  const durations = { '24h': 86400000, '7d': 7 * 86400000, '30d': 30 * 86400000 };
+  const end = Math.min(now, Date.parse(HOME_EXPERIMENT_END));
+  // Rolling presets remain relative to now, including after collection ends.
+  const start = Math.max(Date.parse(HOME_PAGEVIEW_COLLECTION_START),
+    period === 'all' ? 0 : now - durations[period]);
+  return { start: new Date(start), end: new Date(end), unit: period === '24h' ? 'hour' as const : 'day' as const };
+}
