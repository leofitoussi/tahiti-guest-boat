diff --git a/src/app/api/websites/[websiteId]/home-experiment/route.ts b/src/app/api/websites/[websiteId]/home-experiment/route.ts
new file mode 100644
index 0000000..9a23895
--- /dev/null
+++ b/src/app/api/websites/[websiteId]/home-experiment/route.ts
@@ -0,0 +1,92 @@
+import {
+  HOME_EXPERIMENT_END,
+  HOME_EXPERIMENT_REPORT_SQL,
+  HOME_EXPERIMENT_START,
+  HOME_EXPERIMENT_TRAFFIC_SQL,
+  HOME_EXPERIMENT_WEBSITE_ID,
+  homeExperimentStatus,
+} from '@/lib/home-experiment-report';
+import {
+  HOME_PAGEVIEW_COLLECTION_START,
+  HOME_PAGEVIEW_REPORT_SQL,
+  HOME_PAGEVIEW_TRAFFIC_SQL,
+  HOME_PAGEVIEW_SERIES_SQL,
+} from '@/lib/home-pageview-report';
+import { homeExperimentRange } from '@/lib/home-experiment-range';
+import prisma from '@/lib/prisma';
+import { parseRequest } from '@/lib/request';
+import { badRequest, notFound, unauthorized } from '@/lib/response';
+import { canViewWebsite } from '@/permissions';
+
+export async function GET(
+  request: Request,
+  { params }: { params: Promise<{ websiteId: string }> },
+) {
+  const { auth, error } = await parseRequest(request);
+  if (error) return error();
+  const { websiteId } = await params;
+  if (websiteId !== HOME_EXPERIMENT_WEBSITE_ID) return notFound();
+  if (!(await canViewWebsite(auth, websiteId))) return unauthorized();
+
+  const now = Date.now();
+  const period = new URL(request.url).searchParams.get('period') ?? 'all';
+  const range = homeExperimentRange(period, now);
+  if (!range) return badRequest({ message: 'Invalid report period' });
+  const through = new Date(Math.min(now, Date.parse(HOME_EXPERIMENT_END)));
+  const legacyRows = await prisma.rawQuery(HOME_EXPERIMENT_REPORT_SQL, {
+    websiteId,
+    startDate: new Date(HOME_EXPERIMENT_START),
+    endDate: new Date(Math.min(through.getTime(), Date.parse(HOME_PAGEVIEW_COLLECTION_START))),
+  });
+  const [legacyTraffic] = await prisma.rawQuery(HOME_EXPERIMENT_TRAFFIC_SQL, {
+    websiteId,
+    startDate: new Date(HOME_EXPERIMENT_START),
+    endDate: new Date(Math.min(through.getTime(), Date.parse(HOME_PAGEVIEW_COLLECTION_START))),
+  });
+  const collectionParams = {
+    websiteId,
+    startDate: range.start,
+    endDate: range.end,
+  };
+  const rows = await prisma.rawQuery(HOME_PAGEVIEW_REPORT_SQL, collectionParams);
+  const [traffic] = await prisma.rawQuery(HOME_PAGEVIEW_TRAFFIC_SQL, collectionParams);
+  const series = await prisma.rawQuery(HOME_PAGEVIEW_SERIES_SQL, { ...collectionParams, unit: range.unit });
+  const normalize = (rows: any[]) =>
+    rows.map(row => ({
+      ...row,
+      engagement_pct: row.engagement_pct === null ? null : Number(row.engagement_pct),
+      mixed_or_qa_visits_excluded: Number(row.mixed_or_qa_visits_excluded),
+    }));
+  return Response.json(
+    {
+      start: HOME_EXPERIMENT_START,
+      end: HOME_EXPERIMENT_END,
+      generatedAt: new Date(now).toISOString(),
+      through: through.toISOString(),
+      status: homeExperimentStatus(now),
+      period,
+      rangeStart: range.start.toISOString(),
+      rangeEnd: range.end.toISOString(),
+      unit: range.unit,
+      series,
+      coverage: {
+        ...traffic,
+        measured_pct: traffic.measured_pct === null ? null : Number(traffic.measured_pct),
+      },
+      collectionStart: HOME_PAGEVIEW_COLLECTION_START,
+      legacyRows: normalize(legacyRows),
+      legacyCoverage: {
+        ...legacyTraffic,
+        measured_pct:
+          legacyTraffic.measured_pct === null ? null : Number(legacyTraffic.measured_pct),
+      },
+      rows: normalize(rows),
+    },
+    {
+      headers: {
+        'Cache-Control': 'private, no-store',
+        'Netlify-CDN-Cache-Control': 'no-store',
+      },
+    },
+  );
+}
