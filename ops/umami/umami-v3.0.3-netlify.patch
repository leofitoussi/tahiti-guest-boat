@@ -0,0 +1,112 @@
+import { HOME_PAGEVIEW_COLLECTION_START, HOME_PAGEVIEW_REPORT_SQL, HOME_PAGEVIEW_TRAFFIC_SQL } from '../src/lib/home-pageview-report';
+import 'dotenv/config';
+import assert from 'node:assert/strict';
+import { Client } from 'pg';
+import { secret } from '../src/lib/crypto';
+import {
+  HOME_EXPERIMENT_END,
+  HOME_EXPERIMENT_REPORT_SQL,
+  HOME_EXPERIMENT_TRAFFIC_SQL,
+  HOME_EXPERIMENT_START,
+  HOME_EXPERIMENT_WEBSITE_ID,
+} from '../src/lib/home-experiment-report';
+import { createSecureToken } from '../src/lib/jwt';
+
+// Read-only production/preview check. The five-minute token stays in memory.
+const base = process.argv[2];
+assert(base?.startsWith('https://') || /^http:\/\/127\.0\.0\.1:\d+$/.test(base), 'Provide HTTPS or a local loopback test URL');
+const db = new Client({ connectionString: process.env.DATABASE_URL });
+await db.connect();
+try {
+  const { rows: users } = await db.query(
+    `SELECT user_id, role FROM public."user" WHERE role = 'admin' AND deleted_at IS NULL LIMIT 1`,
+  );
+  assert(users[0], 'Admin account missing');
+  const token = createSecureToken({ userId: users[0].user_id, role: users[0].role }, secret(), {
+    expiresIn: '5m',
+  });
+  const path = `/api/websites/${HOME_EXPERIMENT_WEBSITE_ID}/home-experiment`;
+  const get = (path: string, auth = false) =>
+    fetch(new URL(path, base), {
+      headers: auth ? { authorization: `Bearer ${token}` } : {},
+      signal: AbortSignal.timeout(60_000),
+    });
+  assert.equal((await get(path)).status, 401, 'Anonymous access must be rejected');
+  const response = await get(path, true);
+  assert.equal(response.status, 200, 'Authenticated report must be available');
+  const cacheDirectives = response.headers
+    .get('cache-control')
+    ?.split(',')
+    .map(value => value.trim());
+  assert.deepEqual(new Set(cacheDirectives), new Set(['private', 'no-store']));
+  const report = await response.json();
+  assert.equal(report.start, HOME_EXPERIMENT_START);
+  assert.equal(report.end, HOME_EXPERIMENT_END);
+  assert.equal(report.rows.length, 6);
+  const sql = HOME_PAGEVIEW_REPORT_SQL.replaceAll('{{websiteId::uuid}}', '$1::uuid')
+    .replaceAll('{{startDate}}', '$2::timestamptz')
+    .replaceAll('{{endDate}}', '$3::timestamptz');
+  const { rows: baseline } = await db.query(sql, [
+    HOME_EXPERIMENT_WEBSITE_ID,
+    HOME_PAGEVIEW_COLLECTION_START,
+    report.through,
+  ]);
+  const normalize = (rows: any[]) =>
+    rows.map(row => ({
+      ...row,
+      engagement_pct: row.engagement_pct === null ? null : Number(row.engagement_pct),
+      mixed_or_qa_visits_excluded: Number(row.mixed_or_qa_visits_excluded),
+    }));
+  assert.deepEqual(report.rows, normalize(baseline), 'API and direct database report differ');
+  const coverageSql = HOME_PAGEVIEW_TRAFFIC_SQL
+    .replaceAll('{{websiteId::uuid}}', '$1::uuid')
+    .replaceAll('{{startDate}}', '$2::timestamptz')
+    .replaceAll('{{endDate}}', '$3::timestamptz');
+  const { rows: [coverage] } = await db.query(coverageSql, [HOME_EXPERIMENT_WEBSITE_ID, HOME_PAGEVIEW_COLLECTION_START, report.through]);
+  assert.deepEqual(report.coverage, {
+    ...coverage, measured_pct: coverage.measured_pct === null ? null : Number(coverage.measured_pct),
+  });
+  assert.equal(report.coverage.homepage_visits, report.coverage.measured_visits + report.coverage.unmeasured_visits);
+  assert.equal(report.collectionStart, HOME_PAGEVIEW_COLLECTION_START);
+  const legacyEnd = new Date(Math.min(Date.parse(report.through), Date.parse(HOME_PAGEVIEW_COLLECTION_START)));
+  const bind = (sql: string) => sql.replaceAll('{{websiteId::uuid}}', '$1::uuid').replaceAll('{{startDate}}', '$2::timestamptz').replaceAll('{{endDate}}', '$3::timestamptz');
+  const { rows: legacy } = await db.query(bind(HOME_EXPERIMENT_REPORT_SQL), [HOME_EXPERIMENT_WEBSITE_ID, HOME_EXPERIMENT_START, legacyEnd]);
+  assert.deepEqual(report.legacyRows, normalize(legacy));
+  const { rows: [legacyCoverage] } = await db.query(bind(HOME_EXPERIMENT_TRAFFIC_SQL), [HOME_EXPERIMENT_WEBSITE_ID, HOME_EXPERIMENT_START, legacyEnd]);
+  assert.deepEqual(report.legacyCoverage, {...legacyCoverage, measured_pct: legacyCoverage.measured_pct === null ? null : Number(legacyCoverage.measured_pct)});
+  assert.equal(report.rows.filter((r:any)=>r.segment==='all').reduce((n:number,r:any)=>n+r.exposed_visits,0), report.coverage.measured_visits);
+  for (const variant of ['A', 'B']) {
+    const find = (segment: string) =>
+      report.rows.find(row => row.variant === variant && row.segment === segment);
+    for (const key of ['exposed_visits', 'engaged_visits']) {
+      assert.equal(find('all')[key], find('mobile')[key] + find('desktop')[key]);
+    }
+  }
+  assert.deepEqual(await (await get('/api/heartbeat')).json(), { ok: true });
+  assert((await (await get('/script.js')).text()).length > 1000);
+  assert((await (await get('/login')).text()).includes('<html'));
+  assert.equal((await get(`/websites/${HOME_EXPERIMENT_WEBSITE_ID}/home-experiment`)).status, 200);
+  console.log(
+    JSON.stringify(
+      {
+        base,
+        authenticatedReport: true,
+        anonymousRejected: true,
+        databaseMatches: true,
+        segmentTotalsReconcile: true,
+        heartbeat: true,
+        tracker: true,
+        login: true,
+        status: report.status,
+        rows: report.rows,
+        coverage: report.coverage,
+        collectionStart: report.collectionStart,
+        legacyCoverage: report.legacyCoverage,
+      },
+      null,
+      2,
+    ),
+  );
+} finally {
+  await db.end();
+}
