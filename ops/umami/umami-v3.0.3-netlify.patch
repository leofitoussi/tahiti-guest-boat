+   assert.equal(res.headers.get('x-tgb-home-variant'),variant);const html=await res.text();
+   const opening=html.match(/<script\b[^>]*src="https:\/\/analytics\.tahitiguestboat\.com\/script\.js"[^>]*>/)?.[0];assert(opening);
+   const runtime=html.match(/<script[^>]*id="home-experiment-runtime"[^>]*>([\s\S]*?)<\/script>/)?.[1];assert(runtime);
