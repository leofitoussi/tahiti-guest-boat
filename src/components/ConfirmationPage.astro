---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteSettings } from '../lib/cruises';
import { localizePath, type Locale } from '../lib/localization';
import { getSiteCopy } from '../lib/site-copy';
import { getGoogleAdsConfiguration } from '../lib/google-ads';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const settings = await getSiteSettings(locale);
const copy = getSiteCopy(locale).pages.thankYou;
const firstNameSeparator = locale === 'en' ? ', ' : ' ';
const tallyFormId = locale === 'fr' ? 'nPrj8V' : 'eqOGYl';
const googleAds = getGoogleAdsConfiguration(
  import.meta.env.PUBLIC_GOOGLE_ADS_ID,
  import.meta.env.PUBLIC_GOOGLE_ADS_CONVERSION_LABEL,
);
---

<BaseLayout title={copy.title} description={copy.description} settings={settings} locale={locale} noindex>
  <main
    data-confirmation
    data-tally-form-id={tallyFormId}
    data-google-ads-conversion={googleAds?.conversionDestination}
    class="flex min-h-[60vh] flex-col items-center justify-center bg-background px-6 py-32 text-center"
  >
    <p class="text-sm font-semibold uppercase tracking-widest text-[#285aaa]">{copy.eyebrow}</p>
    <h1 class="mt-4 font-[family-name:var(--font-family-heading)] text-4xl md:text-5xl">
      {copy.heading}<span id="confirmation-first-name" data-separator={firstNameSeparator}></span>!
    </h1>
    <p class="mt-6 max-w-md text-base text-muted-foreground">{copy.body}</p>
    <a
      href={localizePath('/', locale)}
      class="mt-10 inline-flex items-center justify-center rounded-[var(--radius-control)] bg-[#285aaa] px-8 py-3 text-sm font-semibold uppercase tracking-[0.12em] text-white transition hover:bg-[#1f4a91]"
    >
      {copy.backHome}
    </a>
  </main>
</BaseLayout>

<script>
  import { formatConfirmationFirstName, getConfirmationFirstName } from '../lib/confirmation';
  import { consumeTallySubmission } from '../lib/tally-submission';

  const firstName = formatConfirmationFirstName(getConfirmationFirstName(window.location.search));
  if (firstName) {
    const element = document.getElementById('confirmation-first-name');
    if (element) element.textContent = `${element.dataset.separator ?? ' '}${firstName}`;
  }

  const confirmation = document.querySelector<HTMLElement>('[data-confirmation]');
  const formId = confirmation?.dataset.tallyFormId;
  const conversionDestination = confirmation?.dataset.googleAdsConversion;
  const submissionId = new URLSearchParams(window.location.search).get('tallySubmissionId');

  if (formId && submissionId && conversionDestination) {
    try {
      const isConfirmedSubmission = consumeTallySubmission(
        window.sessionStorage,
        { formId, submissionId },
        Date.now(),
      );
      const gtag = (window as Window & { gtag?: (...args: unknown[]) => void }).gtag;

      if (isConfirmedSubmission && gtag) {
        gtag('event', 'conversion', { send_to: conversionDestination });
      }
    } catch {
      // Do not measure a confirmation page when its submission proof cannot be read.
    }
  }
</script>
