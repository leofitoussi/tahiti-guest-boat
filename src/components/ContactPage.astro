---
import ContactConversionPage from './ContactConversionPage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getReviews, getSiteSettings } from '../lib/cruises';
import { getUniquePageVersions } from '../lib/page-builder';
import { type Locale } from '../lib/localization';
import { getSiteCopy } from '../lib/site-copy';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getSiteCopy(locale);
const [pageVersions, settings, reviews] = await Promise.all([
  getUniquePageVersions('contactPage'),
  getSiteSettings(locale),
  getReviews(),
]);

const page = pageVersions[locale];
const title = page?.seoTitle ?? copy.pages.contact.title;
const description = page?.seoDescription ?? copy.pages.contact.description;
const alternatePaths =
  locale === 'en'
    ? pageVersions.fr
      ? { fr: '/contact/' }
      : {}
    : pageVersions.en
      ? { en: '/en/contact/' }
      : {};
---

<BaseLayout
  title={title}
  description={description}
  settings={settings}
  locale={locale}
  alternatePaths={alternatePaths}
  noindex={!page?.seo?.indexable}
>
  <main class="bg-background">
    <ContactConversionPage locale={locale} settings={settings} reviews={reviews} />
  </main>
</BaseLayout>
