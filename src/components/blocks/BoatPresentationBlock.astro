---
import { PortableText } from 'astro-portabletext';
import type { TypedObject } from 'astro-portabletext/types';
import Container from '../layout/Container.astro';
import Section from '../layout/Section.astro';
import { urlForImage } from '../../lib/sanity';

interface SanityImage {
  asset?: unknown;
  alt?: string;
  metadata?: {
    dimensions?: { width?: number; height?: number };
  };
}

interface Props {
  title?: TypedObject[];
  body?: TypedObject[];
  blueprintImages?: SanityImage[];
}

const { title = [], body = [], blueprintImages = [] } = Astro.props;

const resolvedImages = blueprintImages.filter((img) => img?.asset).map((img) => {
  const w = img.metadata?.dimensions?.width ?? 600;
  const h = img.metadata?.dimensions?.height ?? 800;
  return {
    src: urlForImage(img)?.width(600).quality(85).auto('format').url() ?? '',
    alt: img.alt ?? '',
    width: w,
    height: h,
  };
});
---

<Section padding="lg">
  <Container>
    <div class="flex flex-col gap-10">
      <!-- Full-width title -->
      {title.length > 0 && (
        <div class="boat-pres-title">
          <PortableText value={title} />
        </div>
      )}

      <!-- Body + blueprint images side by side -->
      <div class="grid gap-10 lg:grid-cols-[1fr_0.5fr] lg:items-start lg:gap-16">
        {body.length > 0 && (
          <div class="boat-pres-body">
            <PortableText value={body} />
          </div>
        )}

        {resolvedImages.length > 0 && (
          <div class="flex items-start justify-center gap-4 sm:gap-6">
            {resolvedImages.map((img) => (
              <img
                src={img.src}
                alt={img.alt}
                width={img.width}
                height={img.height}
                loading="lazy"
                decoding="async"
                class="h-auto w-full min-w-0 flex-1 object-contain"
              />
            ))}
          </div>
        )}
      </div>
    </div>
  </Container>
</Section>

<style>
  .boat-pres-title :global(h2),
  .boat-pres-title :global(h3),
  .boat-pres-title :global(h4) {
    margin: 0;
    font-family: var(--font-family-heading);
    font-size: clamp(2rem, 4.2vw, 3.6rem);
    line-height: 1.14;
    color: var(--foreground);
  }

  .boat-pres-title :global(strong) {
    font-weight: 700;
    color: var(--foreground);
  }

  .boat-pres-title :global(em) {
    font-style: italic;
  }

  .boat-pres-body {
    font-size: var(--font-size-base);
    line-height: var(--line-height-body);
    color: var(--foreground);
  }

  .boat-pres-body :global(p) {
    margin: 0;
  }

  .boat-pres-body :global(p + p) {
    margin-top: 1.125rem;
  }

  .boat-pres-body :global(strong) {
    font-weight: 700;
    color: var(--foreground);
  }

  .boat-pres-body :global(em) {
    font-style: italic;
  }

  .boat-pres-body :global(a) {
    color: var(--primary);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
