---
import { PortableText } from 'astro-portabletext';
import type { TypedObject } from 'astro-portabletext/types';
import Container from '../layout/Container.astro';
import Section from '../layout/Section.astro';
import { buttonVariants } from '../ui/button';
import { defaultLocale, localizeHref, type Locale } from '../../lib/localization';

interface FaqItem {
  _key: string;
  question: string;
  answer?: TypedObject[];
}

interface Props {
  title?: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
  items?: FaqItem[];
  locale?: Locale;
}

const {
  title = 'Foire aux questions',
  description,
  ctaLabel,
  ctaHref,
  items = [],
  locale = defaultLocale,
} = Astro.props;

function portableTextToPlainText(blocks: TypedObject[] = []): string {
  return (blocks as any[])
    .filter((b) => b._type === 'block')
    .map((b) => (b.children ?? []).map((c: any) => c.text ?? '').join(''))
    .join(' ');
}

const jsonLd =
  items.length > 0
    ? JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: items.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: portableTextToPlainText(item.answer),
          },
        })),
      })
    : null;
---

<Section padding="lg">
  <Container>
    <div class="grid gap-12 lg:grid-cols-[2fr_3fr] lg:gap-20">

      <!-- Left: title, description, CTA -->
      <div class="flex flex-col gap-6 lg:pt-1">
        <h2 class="font-heading text-4xl font-bold leading-tight text-foreground md:text-5xl">
          {title}
        </h2>
        {description && (
          <p class="text-base leading-relaxed text-muted-foreground">{description}</p>
        )}
        {ctaLabel && ctaHref && (
          <div class="pt-2">
            <a
              href={localizeHref(ctaHref, locale)}
              class={buttonVariants({ variant: 'outline', size: 'default', className: 'w-fit' })}
            >
              {ctaLabel}
            </a>
          </div>
        )}
      </div>

      <!-- Right: accordion -->
      <div>
        {items.map((item) => (
          <details class="faq-item border-b border-border">
            <summary class="faq-summary flex cursor-pointer list-none items-center justify-between gap-4 py-5 [&::-webkit-details-marker]:hidden">
              <span class="text-base font-semibold text-foreground">{item.question}</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="faq-chevron shrink-0 text-muted-foreground transition-transform duration-300"
                aria-hidden="true"
              >
                <path d="M6 9l6 6 6-6" />
              </svg>
            </summary>
            <div class="faq-answer pb-5 text-sm leading-relaxed text-muted-foreground">
              {item.answer && item.answer.length > 0 && (
                <PortableText value={item.answer} />
              )}
            </div>
          </details>
        ))}
      </div>

    </div>
  </Container>
</Section>

{jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}

<style>
  /* First item gets a top border */
  .faq-item:first-child {
    border-top: 1px solid var(--border);
  }

  /* Chevron rotation when open */
  details[open] .faq-chevron {
    transform: rotate(180deg);
  }

  /* Answer portable text */
  .faq-answer :global(p) {
    margin: 0.4rem 0;
  }
  .faq-answer :global(p:first-child) {
    margin-top: 0;
  }
  .faq-answer :global(ul),
  .faq-answer :global(ol) {
    margin: 0.75rem 0;
    padding-left: 1.5rem;
  }
  .faq-answer :global(ul) {
    list-style-type: disc;
  }
  .faq-answer :global(ol) {
    list-style-type: decimal;
  }
  .faq-answer :global(li) {
    margin: 0.3rem 0;
  }
  .faq-answer :global(a) {
    color: var(--foreground);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .faq-answer :global(strong) {
    font-weight: 600;
    color: var(--foreground);
  }
</style>
