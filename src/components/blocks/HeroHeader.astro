---
import { buttonVariants } from '../ui/button';
import Container from '../layout/Container.astro';
import Section from '../layout/Section.astro';
import { heroImageSources } from '../../lib/sanity';
import { defaultLocale, localizeHref, type Locale } from '../../lib/localization';

interface Cta {
  label: string;
  href: string;
}

interface SanityImage {
  asset?: unknown;
  alt?: string;
  metadata?: {
    dimensions?: { width?: number; height?: number };
  };
}

interface Props {
  eyebrow?: string; // kept for API compatibility, not rendered
  title: string;
  body?: string;
  primaryCta?: Cta;
  secondaryCta?: Cta;
  image?: SanityImage;
  locale?: Locale;
}

const { title, body, primaryCta, secondaryCta, image, locale = defaultLocale } = Astro.props;

const hero = image ? heroImageSources(image) : undefined;
---

{
  hero && (
    <div class="h-[60vh] w-full overflow-hidden bg-muted">
      <img
        src={hero.src}
        srcset={hero.srcset}
        sizes={hero.sizes}
        alt={image?.alt || ''}
        width={hero.width}
        height={hero.height}
        loading="eager"
        decoding="async"
        fetchpriority="high"
        class="h-full w-full object-cover"
      />
    </div>
  )
}

<Section padding="lg">
  <Container>
    <div class="grid gap-10 lg:grid-cols-2 lg:items-start">
      <h1 class="font-heading font-semibold leading-tight text-foreground">
        {title}
      </h1>
      <div class="flex flex-col gap-6">
        {body && <p class="text-lg leading-relaxed text-muted-foreground md:text-xl">{body}</p>}
        {
          (primaryCta || secondaryCta) && (
            <div class="flex flex-wrap gap-3">
              {primaryCta && (
                <a href={localizeHref(primaryCta.href, locale)} class={buttonVariants({ variant: 'primary', size: 'lg' })}>
                  {primaryCta.label}
                </a>
              )}
              {secondaryCta && (
                <a href={localizeHref(secondaryCta.href, locale)} class={buttonVariants({ variant: 'outline', size: 'lg' })}>
                  {secondaryCta.label}
                </a>
              )}
            </div>
          )
        }
      </div>
    </div>
  </Container>
</Section>
