---
/**
 * PageBuilder — dispatcher pur.
 *
 * Reçoit un tableau de blocs Sanity et rend le bon composant selon _type.
 * Les blocs dynamiques reçoivent leurs données depuis les ressources globales
 * du site, afin de garder un seul point d'assemblage côté page.
 */
import HeroHeader from './HeroHeader.astro';
import HomeHero from './HomeHero.astro';
import EditorialBlock from './EditorialBlock.astro';
import MasonryGallery from './MasonryGallery.astro';
import MarqueeGallery from './MarqueeGallery.astro';
import VideoFeature from './VideoFeature.astro';
import FullWidthImageBlock from '../cruises/FullWidthImageBlock.astro';
import BookingBlock from '../cruises/BookingBlock.astro';
import RelatedCruisesBlock from '../cruises/RelatedCruisesBlock.astro';
import CruiseInspirationBlock from './CruiseInspirationBlock.astro';
import ReviewsBlock from '../cruises/ReviewsBlock.astro';
import PracticalInfoBlock from './PracticalInfoBlock.astro';
import WhyUsBlock from '../cruises/WhyUsBlock.astro';
import type { CruisePageSummary, Review, SiteSettings } from '../../lib/cruises';
import { defaultLocale, type Locale } from '../../lib/localization';

interface Props {
  blocks: Record<string, unknown>[];
  settings?: SiteSettings | null;
  reviews?: Review[];
  cruises?: CruisePageSummary[];
  locale?: Locale;
}

const { blocks = [], settings = null, reviews = [], cruises = [], locale = defaultLocale } = Astro.props;
---

{
  blocks.map((block: any) => {
    switch (block._type) {
      case 'heroHeaderBlock':
        return (
          <HeroHeader
            eyebrow={block.keywords?.[0]}
            title={block.title}
            body={block.body}
            primaryCta={block.primaryCtaLabel && block.primaryCtaLink ? { label: block.primaryCtaLabel, href: block.primaryCtaLink } : undefined}
            secondaryCta={block.secondaryCtaLabel && block.secondaryCtaLink ? { label: block.secondaryCtaLabel, href: block.secondaryCtaLink } : undefined}
            image={block.image}
            locale={locale}
          />
        );

      case 'homeHeroBlock':
        return (
          <HomeHero
            keywords={block.keywords}
            title={block.title}
            body={block.body}
            primaryCtaLabel={block.primaryCtaLabel}
            primaryCtaLink={block.primaryCtaLink}
            secondaryCtaLabel={block.secondaryCtaLabel}
            secondaryCtaLink={block.secondaryCtaLink}
            image={block.image}
            locale={locale}
          />
        );

      case 'galleryBlock':
        return (
          <MasonryGallery
            eyebrow={block.eyebrow}
            title={block.title}
            images={block.images ?? []}
            layout={block.layout ?? 'bleed-rows'}
            columns={block.columns ?? 3}
            gap={block.gap ?? 'md'}
          />
        );

      case 'marqueeGalleryBlock':
        return (
          <MarqueeGallery
            eyebrow={block.eyebrow}
            title={block.title}
            row1={block.row1 ?? []}
            row2={block.row2 ?? []}
            row3={block.row3 ?? []}
          />
        );

      case 'editorialBlock':
        return (
          <EditorialBlock
            title={block.title}
            body={block.body}
            image={block.image}
            desktopLayout={block.desktopLayout ?? 'image-text'}
            mobileLayout={block.mobileLayout ?? 'text-image'}
            primaryCtaLabel={block.primaryCtaLabel}
            primaryCtaLink={block.primaryCtaLink}
            secondaryCtaLabel={block.secondaryCtaLabel}
            secondaryCtaLink={block.secondaryCtaLink}
            locale={locale}
          />
        );

      case 'videoFeatureBlock':
        return (
          <VideoFeature
            iconImage={block.iconImage}
            title={block.title}
            body={block.body}
            ctaLabel={block.ctaLabel}
            ctaUrl={block.ctaUrl}
            youtubeUrl={block.youtubeUrl}
            posterImage={block.posterImage}
            locale={locale}
          />
        );

      case 'fullWidthImageBlock':
        return <FullWidthImageBlock block={block} />;

      case 'practicalInfoBlock':
        return (
          <PracticalInfoBlock
            sectionTitle={block.sectionTitle as string | undefined}
            leftColumn={block.leftColumn as any}
            rightColumn={block.rightColumn as any}
          />
        );

      case 'whyUsBlock':
        return <WhyUsBlock settings={settings} locale={locale} />;

      case 'reviewsBlock':
        return <ReviewsBlock reviews={reviews} locale={locale} />;

      case 'bookingBlock':
        return <BookingBlock settings={settings} locale={locale} />;

      case 'relatedCruisesBlock':
        return <RelatedCruisesBlock cruises={cruises} locale={locale} />;

      case 'cruiseInspirationBlock':
        return (
          <CruiseInspirationBlock
            headingPrefix={block.headingPrefix as string | undefined}
            headingHighlight={block.headingHighlight as string | undefined}
            subtitle={block.subtitle as string | undefined}
            cards={block.cards as any}
          />
        );

      default:
        return null;
    }
  })
}
