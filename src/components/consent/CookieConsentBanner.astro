---
import {
  CONSENT_STORAGE_KEY,
} from '../../lib/cookie-consent';
import { defaultLocale, localizePath, type Locale } from '../../lib/localization';
import { getSiteCopy } from '../../lib/site-copy';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const copy = getSiteCopy(locale).cookies;
const policyHref = locale === 'en' ? '/en/cookie-policy/' : localizePath('/politique-de-cookies-ue', locale);
---

<div
  id="cookie-consent"
  data-cookie-consent
  data-cookie-consent-key={CONSENT_STORAGE_KEY}
  class="fixed inset-x-4 bottom-4 z-50 hidden max-h-[calc(100vh-2rem)] overflow-y-auto rounded-[var(--radius-panel)] border border-border bg-background p-6 text-foreground shadow-lg lg:left-1/2 lg:right-auto lg:w-[calc(100%-3rem)] lg:max-w-6xl lg:-translate-x-1/2"
  role="dialog"
  aria-label={copy.title}
  aria-describedby="cookie-consent-description"
  aria-modal="false"
  tabindex="-1"
  hidden
>
  <div class="lg:flex lg:items-center lg:gap-8">
    <p id="cookie-consent-description" class="text-sm leading-relaxed text-muted-foreground lg:min-w-0 lg:flex-1">
      {copy.description} {copy.policyPrefix}{' '}
      <a href={policyHref} class="font-semibold text-primary underline underline-offset-4">{copy.policyLabel}</a>.
    </p>

    <div class="mt-6 flex flex-col gap-3 lg:mt-0 lg:flex-none lg:flex-row lg:flex-nowrap" data-cookie-consent-actions>
      <button
        type="button"
        data-cookie-consent-action="reject"
        class="inline-flex min-h-11 w-full items-center justify-center whitespace-nowrap rounded-[var(--radius-control)] border border-border bg-background px-5 text-sm font-semibold tracking-[0.1em] text-foreground uppercase transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50 lg:w-auto lg:min-w-[10.5rem]"
      >
        {copy.rejectAll}
      </button>
      <button
        type="button"
        data-cookie-consent-action="customize"
        aria-expanded="false"
        aria-controls="cookie-consent-preferences"
        class="inline-flex min-h-11 w-full items-center justify-center whitespace-nowrap rounded-[var(--radius-control)] border border-border bg-background px-5 text-sm font-semibold tracking-[0.1em] text-foreground uppercase transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50 lg:w-auto lg:min-w-[10.5rem]"
      >
        {copy.customize}
      </button>
      <button
        type="button"
        data-cookie-consent-action="accept"
        class="inline-flex min-h-11 w-full items-center justify-center whitespace-nowrap rounded-[var(--radius-control)] bg-primary px-5 text-sm font-semibold tracking-[0.1em] text-primary-foreground uppercase transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50 lg:w-auto lg:min-w-[10.5rem]"
      >
        {copy.acceptAll}
      </button>
    </div>
  </div>

  <form id="cookie-consent-preferences" data-cookie-consent-preferences class="mt-6 hidden border-t border-border pt-6" hidden>
    <fieldset>
      <legend class="text-base font-semibold">{copy.preferencesTitle}</legend>
      <div class="mt-4 grid gap-4">
        <label class="flex gap-3 text-sm">
          <input
            type="checkbox"
            data-cookie-consent-analytics
            class="mt-1 size-4 accent-[var(--brand-primary)]"
          />
          <span>
            <span class="block font-semibold">{copy.analyticsLabel}</span>
            <span class="mt-1 block leading-relaxed text-muted-foreground">{copy.analyticsDescription}</span>
          </span>
        </label>
        <label class="flex gap-3 text-sm">
          <input
            type="checkbox"
            data-cookie-consent-advertising
            class="mt-1 size-4 accent-[var(--brand-primary)]"
          />
          <span>
            <span class="block font-semibold">{copy.advertisingLabel}</span>
            <span class="mt-1 block leading-relaxed text-muted-foreground">{copy.advertisingDescription}</span>
          </span>
        </label>
      </div>
    </fieldset>
    <button
      type="submit"
      data-cookie-consent-action="save"
      class="mt-6 inline-flex min-h-11 w-full items-center justify-center rounded-[var(--radius-control)] bg-primary px-5 text-sm font-semibold tracking-[0.1em] text-primary-foreground uppercase transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50 sm:w-auto"
    >
      {copy.save}
    </button>
  </form>
</div>

<script>
  import { mountCookieConsent } from '../../lib/cookie-consent-client';

  const root = document.querySelector<HTMLElement>('[data-cookie-consent]');
  if (root) mountCookieConsent(root);
</script>
