---
import CruiseImageTextBlock from './CruiseImageTextBlock.astro';
import type { BoatBlock } from '../../lib/cruises';
import { defaultLocale, type Locale } from '../../lib/localization';

interface Props {
  block: BoatBlock;
  locale?: Locale;
}

const { block, locale = defaultLocale } = Astro.props;
---

<CruiseImageTextBlock
  heading={block.heading}
  body={block.body}
  image={block.image}
  ctaLabel={block.ctaLabel}
  ctaUrl={block.ctaUrl}
  desktopLayout={block.desktopLayout ?? 'text-image'}
  locale={locale}
/>
