---
import Container from '../layout/Container.astro';
import Section from '../layout/Section.astro';
import { buttonVariants } from '../ui/button';
import type { SiteSettings } from '../../lib/cruises';
import { defaultLocale, localizeHref, type Locale } from '../../lib/localization';
import { getSiteCopy } from '../../lib/site-copy';

interface Props {
  settings?: SiteSettings | null;
  locale?: Locale;
  destinationLabel?: string | null;
}

const { settings, locale = defaultLocale, destinationLabel } = Astro.props;
const copy = getSiteCopy(locale);
const booking = settings?.bookingEmbed;
const baseTitle = booking?.title || copy.blocks.bookingTitle;
const title = destinationLabel ? `${baseTitle} ${destinationLabel}` : baseTitle;
const ctaLabel = booking?.fallbackCtaLabel || copy.blocks.bookingFallbackCta;
const ctaUrl = booking?.fallbackCtaUrl || '/contact';
---

<Section padding="lg" class="bg-background">
  <Container>
    <div class="grid gap-12 lg:grid-cols-[1fr_1.25fr] lg:items-start">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-primary">{copy.blocks.bookingEyebrow}</p>
        <h2 class="mt-3 font-heading font-semibold leading-tight text-foreground">{title}</h2>
        <div class="prose prose-sm mt-6 text-muted-foreground" set:html={copy.blocks.bookingBodyHtml} />
      </div>
      {
        booking?.embedUrl ? (
          <div>
            <iframe
              data-tally-src={booking.embedUrl}
              loading="lazy"
              width="100%"
              height="500"
              frameborder="0"
              marginheight="0"
              marginwidth="0"
              title={title}
              class="w-full"
            />
            <script is:inline defer src="https://tally.so/widgets/embed.js" />
          </div>
        ) : (
          <div class="rounded-[var(--radius-surface)] border p-8">
            <p class="mb-6 max-w-xl text-muted-foreground">{copy.blocks.bookingFallbackDescription}</p>
            <a href={localizeHref(ctaUrl, locale)} class={buttonVariants({ variant: 'default' })}>{ctaLabel}</a>
          </div>
        )
      }
    </div>
  </Container>
</Section>
