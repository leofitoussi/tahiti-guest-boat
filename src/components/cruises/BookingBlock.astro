---
import Container from '../layout/Container.astro';
import Section from '../layout/Section.astro';
import { buttonVariants } from '../ui/button';
import type { SiteSettings } from '../../lib/cruises';
import { defaultLocale, localizeHref, type Locale } from '../../lib/localization';
import { getSiteCopy } from '../../lib/site-copy';

interface Props {
  settings?: SiteSettings | null;
  locale?: Locale;
  destinationLabel?: string | null;
}

const { settings, locale = defaultLocale, destinationLabel } = Astro.props;
const copy = getSiteCopy(locale);
const booking = settings?.bookingEmbed;
const baseTitle = booking?.title || copy.blocks.bookingTitle;
const title = destinationLabel ? `${baseTitle} ${destinationLabel}` : baseTitle;
const ctaLabel = booking?.fallbackCtaLabel || copy.blocks.bookingFallbackCta;
const ctaUrl = booking?.fallbackCtaUrl || '/contact';
---

<Section padding="lg" class="bg-brand-secondary text-white">
  <Container>
    <div class="grid gap-8 lg:grid-cols-[0.75fr_1.25fr] lg:items-start">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand-accent">{copy.blocks.bookingEyebrow}</p>
        <h2 class="mt-3 font-heading font-semibold leading-tight">{title}</h2>
        {booking?.providerName && <p class="mt-4 text-sm text-white/70">{copy.blocks.bookingProviderPrefix} {booking.providerName}</p>}
      </div>
      {
        booking?.embedUrl ? (
          <iframe
            src={booking.embedUrl}
            title={title}
            loading="lazy"
            class="h-[720px] w-full rounded-[var(--radius-surface)] border border-white/15 bg-white"
          />
        ) : (
          <div class="rounded-[var(--radius-surface)] border border-white/15 p-8">
            <p class="mb-6 max-w-xl text-white/75">{copy.blocks.bookingFallbackDescription}</p>
            <a href={localizeHref(ctaUrl, locale)} class={buttonVariants({ variant: 'secondary' })}>{ctaLabel}</a>
          </div>
        )
      }
    </div>
  </Container>
</Section>
