---
import type { CruisePageSummary } from '../../lib/cruises';
import type { Locale } from '../../lib/localization';
import { buildCruisePath } from '../../lib/cruise-routes';
import { urlForImage } from '../../lib/sanity';

interface Props {
  cruise: CruisePageSummary;
  locale: Locale;
  discoverLabel: string;
  reveal?: boolean;
}

const { cruise, locale, discoverLabel, reveal = false } = Astro.props;
const imageUrl = cruise.heroImage
  ? urlForImage(cruise.heroImage)?.width(760).height(507).fit('crop').quality(82).auto('format').url()
  : undefined;
const cruisePath = buildCruisePath(cruise.slug, locale);
---

<article class="cruise-archive-card" data-reveal-card={reveal ? '' : undefined}>
  <a href={cruisePath} class="block">
    {
      imageUrl ? (
        <img
          src={imageUrl}
          alt={cruise.heroImage?.alt || ''}
          width="760"
          height="507"
          loading="lazy"
          decoding="async"
          class="cruise-archive-card__image"
        />
      ) : (
        <div class="cruise-archive-card__image cruise-archive-card__image--empty" aria-hidden="true" />
      )
    }
  </a>

  <div class="cruise-archive-card__content">
    <h3>
      <a href={cruisePath}>{cruise.heroTitle || cruise.title}</a>
    </h3>
    {cruise.excerpt && <p>{cruise.excerpt}</p>}
    <a href={cruisePath} class="cruise-archive-card__cta">
      {discoverLabel}
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M9 18l6-6-6-6" />
      </svg>
    </a>
  </div>
</article>

<style>
  .cruise-archive-card {
    min-width: 0;
  }

  .cruise-archive-card__image {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    background: var(--muted);
  }

  .cruise-archive-card__image--empty {
    background: var(--muted);
  }

  .cruise-archive-card__content {
    margin-top: var(--space-5);
  }

  h3 {
    font-size: var(--heading-4);
    font-weight: 600;
    line-height: 1.16;
    color: var(--foreground);
  }

  h3 a {
    text-decoration: none;
    transition: color 160ms ease;
  }

  h3 a:hover {
    color: var(--primary);
  }

  p {
    display: -webkit-box;
    overflow: hidden;
    margin: var(--space-2) 0 0;
    color: var(--muted-foreground);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-body);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
  }

  .cruise-archive-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-top: var(--space-3);
    color: var(--primary);
    font-size: var(--font-size-sm);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 160ms ease;
  }

  .cruise-archive-card__cta:hover {
    color: color-mix(in oklab, var(--primary) 80%, transparent);
  }
</style>
