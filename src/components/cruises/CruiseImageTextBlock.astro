---
import Container from '../layout/Container.astro';
import Section from '../layout/Section.astro';
import { buttonVariants } from '../ui/button';
import CruiseHeading from './CruiseHeading.astro';
import CruisePortableText from './CruisePortableText.astro';
import { urlForImage } from '../../lib/sanity';
import { defaultLocale, localizeHref, type Locale } from '../../lib/localization';
import type { SanityImage } from '../../lib/blog';
import type { TypedObject } from 'astro-portabletext/types';

interface Props {
  heading?: TypedObject[] | string;
  body?: TypedObject[];
  image?: SanityImage;
  ctaLabel?: string;
  ctaUrl?: string;
  desktopLayout?: 'image-text' | 'text-image';
  locale?: Locale;
}

const {
  heading,
  body,
  image,
  ctaLabel,
  ctaUrl,
  desktopLayout = 'image-text',
  locale = defaultLocale,
} = Astro.props;

const hasHeading = Array.isArray(heading) ? heading.length > 0 : Boolean(heading);
const hasContent = hasHeading || (body && body.length > 0) || image;
if (!hasContent) return;

const imageUrl = image ? urlForImage(image)?.width(1200).height(760).fit('crop').quality(84).auto('format').url() : undefined;
const imageFirst = desktopLayout === 'image-text';
---

<Section padding="lg" class="bg-background">
  <Container>
    <div class="grid gap-10 lg:grid-cols-[1fr_1fr] lg:items-stretch">
      <div class:list={['flex flex-col gap-6 py-6 lg:py-10', imageFirst && 'lg:order-2']}>
        <CruiseHeading
          as="h2"
          value={heading}
          class="font-heading text-[clamp(2rem,3.5vw,3.25rem)] leading-[1.1] text-foreground"
        />
        {body && body.length > 0 && <CruisePortableText value={body} />}
        {
          ctaLabel && ctaUrl && (
            <a href={localizeHref(ctaUrl, locale)} class={buttonVariants({ className: 'w-fit' })}>
              {ctaLabel}
            </a>
          )
        }
      </div>
      {
        imageUrl && (
          <img
            src={imageUrl}
            alt={image?.alt || ''}
            width="1200"
            height="760"
            loading="lazy"
            decoding="async"
            class:list={['aspect-[1200/760] h-full w-full object-cover shadow-sm ring-1 ring-border/70', imageFirst && 'lg:order-1']}
            style={{ backgroundColor: image?.metadata?.palette?.dominant?.background || 'var(--muted)' }}
          />
        )
      }
    </div>
  </Container>
</Section>
