---
import Container from '../layout/Container.astro';
import Section from '../layout/Section.astro';
import CruisePortableText from './CruisePortableText.astro';
import type { CruiseIntro } from '../../lib/cruises';
import { urlForImage } from '../../lib/sanity';

interface Props {
  block?: CruiseIntro;
}

const { block } = Astro.props;

const headingValue = Array.isArray(block?.heading) ? block.heading : undefined;
const legacyHeading = typeof block?.heading === 'string' ? block.heading : undefined;
const hasHeading = Boolean((headingValue && headingValue.length > 0) || legacyHeading);
const hasContent = block && (hasHeading || (block.body && block.body.length > 0) || block.image);
if (!hasContent) return;

const imageUrl = block.image
  ? urlForImage(block.image)?.width(1100).height(900).fit('crop').quality(84).auto('format').url()
  : undefined;
---

<Section padding="lg" class="bg-background">
  <Container>
    <div class="grid gap-12 lg:grid-cols-[0.92fr_1fr] lg:items-center xl:gap-16">
      <div class="flex flex-col gap-7">
        {headingValue && headingValue.length > 0 && <CruisePortableText value={headingValue} class="cruise-intro-heading" />}
        {legacyHeading && <h2 class="font-heading text-4xl leading-tight !text-primary md:text-6xl">{legacyHeading}</h2>}
        {block.body && block.body.length > 0 && <CruisePortableText value={block.body} class="cruise-intro-body" />}
      </div>
      {
        imageUrl && (
          <img
            src={imageUrl}
            alt={block.image?.alt || ''}
            width="1100"
            height="900"
            loading="lazy"
            decoding="async"
            class="aspect-[1.22] w-full rounded-[var(--radius-panel)] object-cover shadow-sm"
            style={{ backgroundColor: block.image?.metadata?.palette?.dominant?.background || 'var(--muted)' }}
          />
        )
      }
    </div>
  </Container>
</Section>

<style>
  .cruise-intro-heading :global(h2) {
    margin: 0;
    font-family: var(--font-family-heading);
    font-size: 2.25rem;
    line-height: 1.08;
    color: var(--primary);
  }

  .cruise-intro-heading :global(strong) {
    font-weight: 700;
  }

  .cruise-intro-heading :global(em) {
    font-style: italic;
  }

  .cruise-intro-body :global(p) {
    margin: 1.25rem 0;
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  @media (min-width: 768px) {
    .cruise-intro-heading :global(h2) {
      font-size: 3.75rem;
    }
  }
</style>
