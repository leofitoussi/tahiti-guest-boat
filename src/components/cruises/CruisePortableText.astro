---
import { PortableText } from 'astro-portabletext';
import type { TypedObject } from 'astro-portabletext/types';
import PortableImage from '../blog/PortableImage.astro';

interface Props {
  value?: TypedObject[];
  class?: string;
}

const { value = [], class: className } = Astro.props;
const components = {
  type: {
    image: PortableImage,
  },
};
---

<div class:list={['cruise-content', className]}>
  <PortableText value={value} components={components} />
</div>

<style>
  /* text-base / leading-relaxed */
  .cruise-content {
    color: var(--foreground);
    font-size: 1rem;
    line-height: 1.625;
  }

  .cruise-content :global(p) {
    margin: 1rem 0;
  }

  /* ── Modifier : intro / feature body (video-feature-body) ── */
  .cruise-content.video-feature-body :global(p) {
    margin: 0;
    font-size: 1.125rem; /* text-lg */
    line-height: 1.625;  /* leading-relaxed */
    color: var(--muted-foreground);
  }
  @media (min-width: 768px) {
    .cruise-content.video-feature-body :global(p) {
      font-size: 1.25rem; /* md:text-xl */
    }
  }
  .cruise-content.video-feature-body :global(strong) {
    font-weight: 700;
    color: var(--foreground);
  }

  /* ── Modifier : video feature title ── */
  .cruise-content.video-feature-title :global(h2) {
    margin: 0;
    color: var(--foreground);
  }

  .cruise-content :global(h2) {
    margin: 2.25rem 0 1rem;
    color: var(--primary);
  }

  .cruise-content :global(h3) {
    margin: 2rem 0 0.75rem;
  }

  .cruise-content :global(blockquote) {
    margin: 2rem 0;
    border-left: 4px solid var(--primary);
    padding-left: 1.25rem;
    color: var(--muted-foreground);
    font-family: var(--font-family-heading);
    font-size: 1.3rem;
    line-height: 1.6;
  }

  /* Tailwind's preflight resets list markers; restore them for editorial lists. */
  .cruise-content :global(ul),
  .cruise-content :global(ol) {
    margin: 1.25rem 0;
    padding-left: 1.5rem;
    list-style-position: outside;
  }

  .cruise-content :global(ul) {
    list-style-type: disc;
  }

  .cruise-content :global(ol) {
    list-style-type: decimal;
  }

  .cruise-content :global(li) {
    margin: 0.45rem 0;
  }

  .cruise-content :global(a) {
    color: var(--primary);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cruise-content :global(img) {
    border-radius: var(--radius-surface);
  }
</style>
