---
import Container from '../layout/Container.astro';
import CruiseHeading from './CruiseHeading.astro';
import type { CruiseTeaser } from '../../lib/cruises';
import { urlForImage } from '../../lib/sanity';

interface Props {
  block?: CruiseTeaser;
}

const { block } = Astro.props;

const imageUrl = block?.image
  ? urlForImage(block.image)?.width(1600).height(900).fit('crop').quality(84).auto('format').url()
  : undefined;
const placeholder = block?.image
  ? urlForImage(block.image)?.width(40).height(23).fit('crop').blur(18).quality(35).auto('format').url()
  : undefined;

const hasHeadline = Array.isArray(block?.headline) ? block.headline.length > 0 : Boolean(block?.headline);
const hasContent = hasHeadline || Boolean(imageUrl);

// Icons are frontend-owned and consistent across all cruise pages
const markers = [
  {
    label: 'Capacité',
    value: block?.capacity,
    svgPaths: [
      'M12 11.25a3.25 3.25 0 1 0 0-6.5 3.25 3.25 0 0 0 0 6.5Z',
      'M5.75 19.25c.74-3.1 3.04-5.05 6.25-5.05s5.51 1.95 6.25 5.05',
      'M18.2 10.2a2.45 2.45 0 0 0 .2-4.78',
      'M20.5 17.75a5.7 5.7 0 0 0-3-3.02',
    ],
  },
  {
    label: 'Durée minimum',
    value: block?.minimumDuration,
    svgPaths: [
      'M6.75 3.75v2.5',
      'M17.25 3.75v2.5',
      'M5.25 6h13.5c.83 0 1.5.67 1.5 1.5v11c0 .83-.67 1.5-1.5 1.5H5.25c-.83 0-1.5-.67-1.5-1.5v-11c0-.83.67-1.5 1.5-1.5Z',
      'M3.75 10h16.5',
      'M12 13.25v3.25l2.25 1.25',
    ],
  },
  {
    label: 'Tarif',
    value: block?.pricing,
    svgPaths: [
      'M7.25 4.75h9.5c.83 0 1.5.67 1.5 1.5v13l-6.25-3-6.25 3v-13c0-.83.67-1.5 1.5-1.5Z',
      'M9.5 9.25h5',
      'M9.5 12.25h3.25',
    ],
  },
].filter((m): m is typeof m & { value: string } => Boolean(m.value));
---

{
  hasContent && (
    <section class="overflow-hidden bg-background">
      <div class="bg-brand-secondary pb-28 pt-14 text-white md:pb-44 md:pt-20">
        <Container>
          <div class="mx-auto flex max-w-5xl flex-col items-center text-center">
            <img
              src="/images/tahiti-guest-boat-catamaran-signature.svg"
              alt="Tahiti Guest Boat catamaran"
              width="124"
              height="124"
              loading="lazy"
              decoding="async"
              class="mb-8 size-24 object-contain md:mb-10 md:size-28"
            />
            <CruiseHeading
              as="h2"
              value={block?.headline}
              class="max-w-5xl font-heading text-4xl leading-tight !text-white md:text-6xl"
            />
            {markers.length > 0 && (
              <dl class="mt-8 flex max-w-3xl flex-col items-center justify-center gap-5 text-base text-white/90 sm:flex-row sm:flex-wrap md:mt-10 md:gap-8 md:text-lg">
                {markers.map((marker) => (
                  <div class="flex items-center gap-3">
                    <dt class="sr-only">{marker.label}</dt>
                    <dd class="flex items-center gap-3">
                      <svg
                        viewBox="0 0 24 24"
                        class="size-6 shrink-0 text-white"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.7"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        {marker.svgPaths.map((path) => (
                          <path d={path} />
                        ))}
                      </svg>
                      <span>{marker.value}</span>
                    </dd>
                  </div>
                ))}
              </dl>
            )}
          </div>
        </Container>
      </div>
      {imageUrl && (
        <Container class="-mt-20 md:-mt-32">
            <img
              src={imageUrl}
              alt={block?.image?.alt || ''}
              width="1600"
              height="900"
              loading="lazy"
              decoding="async"
              class="mx-auto aspect-[16/9] w-full max-w-[92rem] rounded-[var(--radius-panel)] object-cover shadow-sm"
              style={{
                backgroundImage: placeholder ? `url(${placeholder})` : undefined,
                backgroundColor: block?.image?.metadata?.palette?.dominant?.background || 'var(--muted)',
                backgroundSize: 'cover',
                backgroundPosition: 'center',
              }}
            />
        </Container>
      )}
      <div class="h-12 bg-background md:h-16" />
    </section>
  )
}
