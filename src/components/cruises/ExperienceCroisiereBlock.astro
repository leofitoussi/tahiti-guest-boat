---
import Container from '../layout/Container.astro';
import Section from '../layout/Section.astro';
import CruisePortableText from './CruisePortableText.astro';
import type { ExperienceCroisiere } from '../../lib/cruises';
import { urlForImage } from '../../lib/sanity';

interface Props {
  block?: ExperienceCroisiere;
}

const { block } = Astro.props;

const hasContent = block && (block.heading || (block.body && block.body.length > 0) || block.image);
if (!hasContent) return;

const imageUrl = block.image ? urlForImage(block.image)?.width(1080).height(800).fit('crop').quality(82).auto('format').url() : undefined;
---

<Section padding="lg" class="bg-muted/30">
  <Container>
    <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
      <div class="flex flex-col gap-6">
        {block.heading && <h2 class="experience-heading">{block.heading}</h2>}
        {block.body && block.body.length > 0 && <CruisePortableText value={block.body} />}
      </div>
      {
        imageUrl && (
          <img
            src={imageUrl}
            alt={block.image?.alt || ''}
            width="1080"
            height="800"
            loading="lazy"
            decoding="async"
            class="aspect-[1.35] w-full rounded-[var(--radius-surface)] object-cover shadow-sm ring-1 ring-border/70"
            style={{ backgroundColor: block.image?.metadata?.palette?.dominant?.background || 'var(--muted)' }}
          />
        )
      }
    </div>
  </Container>
</Section>

<style>
  .experience-heading {
    margin: 0;
    font-family: var(--font-family-heading);
    font-size: clamp(2rem, 3.5vw, 3.25rem);
    line-height: 1.1;
    color: var(--foreground);
  }
</style>
