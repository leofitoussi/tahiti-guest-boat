---
import { buttonVariants } from '../ui/button';
import Container from '../layout/Container.astro';
import type { CruiseHeroBlock } from '../../lib/cruises';
import { urlForImage } from '../../lib/sanity';
import { defaultLocale, localizeHref, type Locale } from '../../lib/localization';
import { getSiteCopy } from '../../lib/site-copy';

interface Props {
  block: CruiseHeroBlock;
  locale?: Locale;
}

const { block, locale = defaultLocale } = Astro.props;
const copy = getSiteCopy(locale);
const imageUrl = block.backgroundImage
  ? urlForImage(block.backgroundImage)?.width(1800).height(980).fit('crop').quality(84).auto('format').url()
  : undefined;
const placeholder = block.backgroundImage
  ? urlForImage(block.backgroundImage)?.width(40).height(22).fit('crop').blur(18).quality(35).auto('format').url()
  : undefined;
---

<section class="relative isolate min-h-[76vh] overflow-hidden bg-brand-secondary text-white">
  {
    imageUrl ? (
      <img
        src={imageUrl}
        alt={block.backgroundImage?.alt || ''}
        width="1800"
        height="980"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover"
        style={{
          backgroundImage: placeholder ? `url(${placeholder})` : undefined,
          backgroundSize: 'cover',
          backgroundPosition: 'center',
        }}
      />
    ) : (
      <div class="absolute inset-0 bg-brand-secondary" />
    )
  }
  <div class="absolute inset-0 bg-brand-secondary/45" />
  <Container class="relative flex min-h-[76vh] items-center justify-center text-center pt-24">
    <div class="max-w-4xl">
      <h1 class="font-heading font-semibold leading-tight">{block.title}</h1>
      {
        block.ctaLabel && block.ctaUrl && (
          <a
            href={localizeHref(block.ctaUrl, locale)}
            class="mt-8 inline-flex items-center justify-center bg-brand-accent px-8 py-3 text-sm font-semibold uppercase tracking-[0.12em] text-brand-secondary underline underline-offset-4 transition-opacity hover:opacity-90"
          >
            {block.ctaLabel}
          </a>
        )
      }
    </div>
  </Container>
</section>
