---
import Container from '../layout/Container.astro';
import CruiseHeading from './CruiseHeading.astro';
import type { CruiseHeroBlock } from '../../lib/cruises';
import { urlForImage } from '../../lib/sanity';
import { defaultLocale, localizeHref, type Locale } from '../../lib/localization';

interface Props {
  block: CruiseHeroBlock;
  locale?: Locale;
}

const { block, locale = defaultLocale } = Astro.props;
const imageUrl = block.backgroundImage
  ? urlForImage(block.backgroundImage)?.width(1800).height(980).fit('crop').quality(84).auto('format').url()
  : undefined;
const placeholder = block.backgroundImage
  ? urlForImage(block.backgroundImage)?.width(40).height(22).fit('crop').blur(18).quality(35).auto('format').url()
  : undefined;
const overlayOpacity = Math.min(100, Math.max(0, block.overlayOpacity ?? 0));
---

<section class="relative isolate min-h-[76vh] bg-brand-secondary text-white">
  <div
    class="absolute inset-0 overflow-hidden"
    style="border-bottom-left-radius: 50% 4rem; border-bottom-right-radius: 50% 4rem;"
  >
    {
      imageUrl ? (
        <img
          src={imageUrl}
          alt={block.backgroundImage?.alt || ''}
          width="1800"
          height="980"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="absolute inset-0 h-full w-full object-cover"
          style={{
            backgroundImage: placeholder ? `url(${placeholder})` : undefined,
            backgroundSize: 'cover',
            backgroundPosition: 'center',
          }}
        />
      ) : (
        <div class="absolute inset-0 bg-brand-secondary" />
      )
    }
    {
      overlayOpacity > 0 && (
        <div class="absolute inset-0" style={{ backgroundColor: `rgba(0, 0, 0, ${overlayOpacity / 100})` }} />
      )
    }
  </div>
  <Container class="relative flex min-h-[76vh] items-center justify-center text-center pt-24">
    <div class="max-w-4xl">
      <CruiseHeading
        as="h1"
        value={block.title}
        class="font-heading font-semibold leading-tight text-white! [text-shadow:0_2px_8px_rgba(0,0,0,0.35)]"
      />
      {
        block.ctaLabel && block.ctaUrl && (
          <a
            href={localizeHref(block.ctaUrl, locale)}
            class="mt-8 inline-flex items-center justify-center bg-brand-accent px-8 py-3 text-sm font-semibold uppercase tracking-[0.12em] text-brand-secondary underline underline-offset-4 shadow-lg transition-opacity hover:opacity-90"
          >
            {block.ctaLabel}
          </a>
        )
      }
    </div>
  </Container>
</section>
