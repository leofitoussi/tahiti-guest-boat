---
import Container from '../layout/Container.astro';
import Section from '../layout/Section.astro';
import type { PitchBlock } from '../../lib/cruises';

interface Props {
  block: PitchBlock;
}

const { block } = Astro.props;
---

<Section padding="lg" class="bg-background">
  <Container>
    <div class="grid gap-10 md:grid-cols-[1fr_0.75fr] md:items-start">
      <p class="max-w-3xl font-heading text-3xl leading-snug text-foreground md:text-5xl">{block.accroche}</p>
      {
        block.badges && block.badges.length > 0 && (
          <div class="grid gap-3 sm:grid-cols-2 md:grid-cols-1">
            {block.badges.map((badge) => (
            <div class="flex items-center gap-3 border-b border-border/70 py-4">
              {badge.icon && <span class="text-2xl" aria-hidden="true">{badge.icon}</span>}
              <span class="text-sm font-bold uppercase tracking-[0.14em] text-muted-foreground">{badge.label}</span>
            </div>
            ))}
          </div>
        )
      }
    </div>
  </Container>
</Section>
