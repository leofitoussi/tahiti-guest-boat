---
import Container from '../layout/Container.astro';
import Section from '../layout/Section.astro';
import type { CruisePageSummary } from '../../lib/cruises';
import { urlForImage } from '../../lib/sanity';
import { defaultLocale, localizePath, type Locale } from '../../lib/localization';
import { buildCruisePath } from '../../lib/cruise-routes';
import { getSiteCopy } from '../../lib/site-copy';

interface Props {
  cruises?: CruisePageSummary[];
  locale?: Locale;
  title?: string;
}

const { cruises = [], locale = defaultLocale, title } = Astro.props;
const copy = getSiteCopy(locale);
---

{
  cruises.length > 0 && (
    <Section padding="lg" class="bg-muted/30">
      <Container>
        <div class="mb-10 max-w-3xl">
          <p class="text-sm font-bold uppercase tracking-[0.16em] text-primary">{copy.blocks.relatedCruisesEyebrow}</p>
          <h2 class="mt-3 font-heading font-semibold leading-tight text-foreground">{title || copy.blocks.relatedCruisesTitle}</h2>
        </div>
        <div class="flex overflow-x-auto gap-6 pb-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
          {cruises.map((cruise) => {
            const imageUrl = cruise.heroImage ? urlForImage(cruise.heroImage)?.width(760).height(500).fit('crop').quality(82).auto('format').url() : undefined;
            const cruisePath = locale === 'fr'
              ? localizePath(`/nos-croisieres/${cruise.slug}/`, locale)
              : buildCruisePath(cruise.slug, locale);

            return (
              <article class="min-w-[270px] w-[270px] shrink-0 overflow-hidden rounded-[var(--radius-surface)] border border-border/70 bg-card shadow-xs transition hover:-translate-y-1 hover:shadow-md md:min-w-[320px] md:w-[320px]">
                <a href={cruisePath} class="block">
                  {imageUrl ? (
                    <img src={imageUrl} alt={cruise.heroImage?.alt || ''} width="760" height="500" loading="lazy" decoding="async" class="aspect-[1.52] w-full object-cover" />
                  ) : (
                    <div class="aspect-[1.52] bg-muted" />
                  )}
                </a>
                <div class="p-6">
                  <h3 class="font-heading font-semibold leading-tight" style="font-size: var(--heading-4)">
                    <a href={cruisePath} class="transition hover:text-primary">{cruise.title}</a>
                  </h3>
                  {cruise.excerpt && <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-muted-foreground">{cruise.excerpt}</p>}
                  <a
                    href={cruisePath}
                    class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-primary underline underline-offset-4 transition hover:text-primary/80"
                  >
                    {copy.blocks.discoverCta}
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M9 18l6-6-6-6" />
                    </svg>
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      </Container>
    </Section>
  )
}
