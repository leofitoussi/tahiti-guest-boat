---
import Container from '../layout/Container.astro';
import Grid from '../layout/Grid.astro';
import Section from '../layout/Section.astro';
import type { CruisePageSummary } from '../../lib/cruises';
import { urlForImage } from '../../lib/sanity';

interface Props {
  cruises?: CruisePageSummary[];
}

const { cruises = [] } = Astro.props;
---

{
  cruises.length > 0 && (
    <Section padding="lg" class="bg-muted/30">
      <Container>
        <div class="mb-10 max-w-3xl">
          <p class="text-sm font-bold uppercase tracking-[0.16em] text-primary">À découvrir aussi</p>
          <h2 class="mt-3 font-heading font-semibold leading-tight text-foreground">Autres inspirations de croisière</h2>
        </div>
        <Grid columns={3}>
          {cruises.map((cruise) => {
            const imageUrl = cruise.heroImage ? urlForImage(cruise.heroImage)?.width(760).height(500).fit('crop').quality(82).auto('format').url() : undefined;

            return (
              <article class="overflow-hidden rounded-[var(--radius-surface)] border border-border/70 bg-card shadow-xs transition hover:-translate-y-1 hover:shadow-md">
                <a href={`/nos-croisieres/${cruise.slug}/`} class="block">
                  {imageUrl ? (
                    <img src={imageUrl} alt={cruise.heroImage?.alt || ''} width="760" height="500" loading="lazy" decoding="async" class="aspect-[1.52] w-full object-cover" />
                  ) : (
                    <div class="aspect-[1.52] bg-muted" />
                  )}
                </a>
                <div class="p-6">
                  <h3 class="font-heading font-semibold leading-tight">
                    <a href={`/nos-croisieres/${cruise.slug}/`} class="transition hover:text-primary">{cruise.heroTitle || cruise.title}</a>
                  </h3>
                  {cruise.excerpt && <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-muted-foreground">{cruise.excerpt}</p>}
                </div>
              </article>
            );
          })}
        </Grid>
      </Container>
    </Section>
  )
}
