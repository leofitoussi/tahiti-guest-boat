---
import Container from '../layout/Container.astro';
import Section from '../layout/Section.astro';
import type { Review } from '../../lib/cruises';
import { urlForImage } from '../../lib/sanity';
import { defaultLocale, type Locale } from '../../lib/localization';
import { formatReviewDate, getLocalizedReviewContent } from '../../lib/reviews';
import { getSiteCopy } from '../../lib/site-copy';

interface Props {
  reviews?: Review[];
  locale?: Locale;
}

const { reviews = [], locale = defaultLocale } = Astro.props;
const copy = getSiteCopy(locale);
const average = reviews.length
  ? reviews.reduce((sum, review) => sum + (review.rating || 0), 0) / reviews.length
  : 0;

const reviewCountLabel = locale === 'en' ? 'reviews' : 'avis';
const reviewBlockId = crypto.randomUUID();
---

<Section padding="lg" class="bg-background pb-8 md:pb-12">
  <Container>
    <div class="mb-10 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-primary">{copy.blocks.reviewsEyebrow}</p>
        <h2 class="mt-3 font-heading font-semibold leading-tight text-foreground">{copy.blocks.reviewsTitle}</h2>
      </div>
      {reviews.length > 0 && <p class="text-sm font-bold uppercase tracking-[0.14em] text-muted-foreground">{average.toFixed(1)}/5 · {reviews.length} {reviewCountLabel}</p>}
    </div>
    {
      reviews.length > 0 ? (
        <div class="-mr-5 md:-mr-8 flex snap-x snap-mandatory overflow-x-auto scroll-smooth gap-4 pb-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
          {reviews.map((review, index) => {
            const authorImageUrl = review.authorImage
              ? urlForImage(review.authorImage)?.width(96).height(96).fit('crop').auto('format').url()
              : undefined;
            const formattedDate = formatReviewDate(review.date, locale);
            const reviewContent = getLocalizedReviewContent(review, locale);
            const reviewBodyId = `review-body-${reviewBlockId}-${index}`;

            return (
              <article data-review-card class="snap-start shrink-0 self-start w-[300px] sm:w-[320px] lg:w-[340px] rounded-[var(--radius-surface)] border border-border/70 bg-card p-6 shadow-xs">
                <div class="mb-5 flex items-center gap-3">
                  {authorImageUrl && (
                    <img src={authorImageUrl} alt="" width="48" height="48" loading="lazy" decoding="async" class="size-12 rounded-full object-cover" />
                  )}
                  <div>
                    <h3 class="!text-base font-semibold text-foreground">{review.name}</h3>
                    <p class="text-sm text-muted-foreground">
                      {review.rating || 0}/5
                      {review.source === 'google' && (
                        <>
                          {' · '}
                          {review.sourceUrl ? (
                            <a href={review.sourceUrl} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/30">
                              {copy.blocks.reviewsGoogleLinkLabel}
                            </a>
                          ) : 'Google'}
                        </>
                      )}
                      {formattedDate ? ` · ${formattedDate}` : ''}
                    </p>
                  </div>
                </div>
                {reviewContent.displayBody && (
                  <p id={reviewBodyId} data-review-body aria-live="polite" class="text-base leading-relaxed text-muted-foreground">
                    {reviewContent.displayBody}
                  </p>
                )}
                {reviewContent.displayBody && (
                  <div data-review-actions hidden class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
                    <button
                      type="button"
                      hidden
                      data-review-expand-toggle
                      data-expand-label={copy.blocks.reviewsExpandLabel}
                      data-collapse-label={copy.blocks.reviewsCollapseLabel}
                      aria-controls={reviewBodyId}
                      aria-expanded="false"
                      class="inline-flex min-h-11 w-fit cursor-pointer items-center border-0 bg-transparent p-0 text-sm font-bold text-primary underline underline-offset-4 transition-colors hover:text-primary/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/30"
                    >
                      {copy.blocks.reviewsExpandLabel}
                    </button>
                      {reviewContent.canToggle && reviewContent.originalBody && (
                        <button
                          type="button"
                          hidden
                          data-review-translation-toggle="true"
                          data-original-body={reviewContent.originalBody}
                          data-translated-body={reviewContent.displayBody}
                          data-original-label={copy.blocks.reviewsOriginalLabel}
                          data-translation-label={copy.blocks.reviewsTranslationLabel}
                          aria-controls={reviewBodyId}
                          aria-pressed="false"
                          class="inline-flex min-h-11 w-fit cursor-pointer items-center border-0 bg-transparent p-0 text-sm font-bold text-primary underline underline-offset-4 transition-colors hover:text-primary/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/30"
                        >
                          {copy.blocks.reviewsOriginalLabel}
                        </button>
                      )}
                  </div>
                )}
                {review.source !== 'google' && review.sourceUrl && (
                  <a
                    href={review.sourceUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-5 inline-flex min-h-11 items-center text-sm font-bold text-primary underline underline-offset-4 transition-colors hover:text-primary/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/30"
                  >
                    {copy.blocks.reviewsLinkLabel}
                  </a>
                )}
              </article>
            );
          })}
          <div class="shrink-0 w-5 md:w-8" aria-hidden="true" />
        </div>
      ) : (
        <div class="border border-dashed border-border p-8 text-center text-muted-foreground">
          {copy.blocks.reviewsFallbackDescription}
        </div>
      )
    }
  </Container>
</Section>

<script>
  const initializeReviewControls = () => {
    document.querySelectorAll<HTMLElement>('[data-review-card]').forEach((card) => {
      if (card.dataset.reviewControlsBound === 'true') return;

      const body = card.querySelector<HTMLElement>('[data-review-body]');
      const actions = card.querySelector<HTMLElement>('[data-review-actions]');
      const expandButton = card.querySelector<HTMLButtonElement>('[data-review-expand-toggle]');
      const translationButton = card.querySelector<HTMLButtonElement>('[data-review-translation-toggle]');
      if (!body || !actions || !expandButton) return;

      card.dataset.reviewControlsBound = 'true';
      // Without JavaScript, leave the complete stored text readable.
      body.classList.add('line-clamp-6');
      if (translationButton) translationButton.hidden = false;

      const updateExpansion = () => {
        const expanded = expandButton.getAttribute('aria-expanded') === 'true';
        expandButton.hidden = !expanded && body.scrollHeight <= body.clientHeight + 1;
        actions.hidden = expandButton.hidden && (!translationButton || translationButton.hidden);
      };

      expandButton.addEventListener('click', () => {
        const expanded = expandButton.getAttribute('aria-expanded') !== 'true';
        expandButton.setAttribute('aria-expanded', String(expanded));
        body.classList.toggle('line-clamp-6', !expanded);
        expandButton.textContent = expanded
          ? expandButton.dataset.collapseLabel ?? ''
          : expandButton.dataset.expandLabel ?? '';
        updateExpansion();
      });

      translationButton?.addEventListener('click', () => {
        const showingOriginal = translationButton.getAttribute('aria-pressed') === 'true';
        const shouldShowOriginal = !showingOriginal;
        const nextBody = shouldShowOriginal ? translationButton.dataset.originalBody : translationButton.dataset.translatedBody;

        if (!nextBody) return;

        body.textContent = nextBody;
        translationButton.setAttribute('aria-pressed', String(shouldShowOriginal));
        translationButton.textContent = shouldShowOriginal
          ? translationButton.dataset.translationLabel ?? ''
          : translationButton.dataset.originalLabel ?? '';
        updateExpansion();
      });

      updateExpansion();
      void document.fonts.ready.then(updateExpansion);
      const observer = new ResizeObserver(updateExpansion);
      observer.observe(body);
      document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
    });
  };

  initializeReviewControls();
  document.addEventListener('astro:page-load', initializeReviewControls);
</script>
