---
import Container from '../layout/Container.astro';
import Grid from '../layout/Grid.astro';
import Section from '../layout/Section.astro';
import type { Review } from '../../lib/cruises';
import { urlForImage } from '../../lib/sanity';
import { defaultLocale, type Locale } from '../../lib/localization';
import { getSiteCopy } from '../../lib/site-copy';

interface Props {
  reviews?: Review[];
  locale?: Locale;
}

const { reviews = [], locale = defaultLocale } = Astro.props;
const copy = getSiteCopy(locale);
const average = reviews.length
  ? reviews.reduce((sum, review) => sum + (review.rating || 0), 0) / reviews.length
  : 0;
---

<Section padding="lg" class="bg-background">
  <Container>
    <div class="mb-10 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-primary">{copy.blocks.reviewsEyebrow}</p>
        <h2 class="mt-3 font-heading font-semibold leading-tight text-foreground">{copy.blocks.reviewsTitle}</h2>
      </div>
      {reviews.length > 0 && <p class="text-sm font-bold uppercase tracking-[0.14em] text-muted-foreground">{average.toFixed(1)}/5 · {reviews.length} avis</p>}
    </div>
    {
      reviews.length > 0 ? (
        <Grid columns={3}>
          {reviews.map((review) => {
            const authorImageUrl = review.authorImage ? urlForImage(review.authorImage)?.width(96).height(96).fit('crop').auto('format').url() : undefined;

            return (
              <article class="rounded-[var(--radius-surface)] border border-border/70 bg-card p-6 shadow-xs">
                <div class="mb-5 flex items-center gap-3">
                  {authorImageUrl ? (
                    <img src={authorImageUrl} alt="" width="48" height="48" loading="lazy" decoding="async" class="size-12 rounded-full object-cover" />
                  ) : (
                    <div class="grid size-12 place-items-center rounded-full bg-muted font-bold text-primary">{review.name?.slice(0, 1) || '?'}</div>
                  )}
                  <div>
                    <h3 class="font-bold text-foreground">{review.name}</h3>
                    <p class="text-sm text-muted-foreground">{review.rating || 0}/5{review.source === 'google' ? ' · Google' : ''}</p>
                  </div>
                </div>
                <p class="text-base leading-relaxed text-muted-foreground">{review.body}</p>
                {review.sourceUrl && <a href={review.sourceUrl} class="mt-5 inline-block text-sm font-bold text-primary underline underline-offset-4">{copy.blocks.reviewsLinkLabel}</a>}
              </article>
            );
          })}
        </Grid>
      ) : (
        <div class="border border-dashed border-border p-8 text-center text-muted-foreground">
          {copy.blocks.reviewsFallbackDescription}
        </div>
      )
    }
  </Container>
</Section>
