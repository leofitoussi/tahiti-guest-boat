---
import Container from '../layout/Container.astro';
import Grid from '../layout/Grid.astro';
import Section from '../layout/Section.astro';
import type { SiteSettings } from '../../lib/cruises';
import { defaultLocale, type Locale } from '../../lib/localization';
import { getSiteCopy } from '../../lib/site-copy';

interface Props {
  settings?: SiteSettings | null;
  locale?: Locale;
}

const { settings, locale = defaultLocale } = Astro.props;
const copy = getSiteCopy(locale);
const title = settings?.whyUsTitle || copy.blocks.whyUsTitle;
const description = settings?.whyUsDescription;
const argumentsList = settings?.whyUsArguments?.length
  ? settings.whyUsArguments
  : [
      { icon: '⚓', body: 'Une croisière privée pensée autour de votre rythme, de vos envies et de la météo.' },
      { icon: '☀️', body: 'Une expérience conviviale, simple et attentive, loin des programmes standardisés.' },
      { icon: '🌊', body: 'Une connaissance sensible des lagons, des mouillages et de la vie à bord.' },
    ];

const hasHeadings = argumentsList.some((item) => item.heading);
---

{hasHeadings ? (
  <Section padding="lg" class="bg-muted/30">
    <Container>
      <div class="grid gap-12 md:grid-cols-[2fr_3fr] md:items-start md:gap-16">
        <div class="flex flex-col gap-5">
          <h2 class="font-heading text-3xl font-semibold leading-tight text-foreground md:text-4xl">
            {title}
          </h2>
          {description && (
            <p class="text-lg leading-relaxed text-muted-foreground">{description}</p>
          )}
        </div>

        <div class="grid grid-cols-1 gap-0 sm:grid-cols-2">
          {argumentsList.map((item) => (
            <div class="border-t border-border/60 px-2 py-5">
              {item.heading && (
                <h3 class="font-heading text-base font-semibold leading-snug text-foreground">
                  {item.heading}
                </h3>
              )}
              <p class:list={['text-sm leading-relaxed text-muted-foreground', item.heading ? 'mt-2' : '']}>
                {item.body}
              </p>
            </div>
          ))}
        </div>
      </div>
    </Container>
  </Section>
) : (
  <Section padding="lg" class="bg-muted/30">
    <Container>
      <div class="mb-10 max-w-3xl">
        <h2 class="font-heading font-semibold leading-tight text-foreground">{title}</h2>
      </div>
      <Grid columns={3}>
        {argumentsList.map((item) => (
          <div class="rounded-[var(--radius-surface)] border border-border/70 bg-card p-6 shadow-xs">
            {item.icon && <span class="text-3xl" aria-hidden="true">{item.icon}</span>}
            <p class="mt-4 text-base leading-relaxed text-muted-foreground">{item.body}</p>
          </div>
        ))}
      </Grid>
    </Container>
  </Section>
)}
