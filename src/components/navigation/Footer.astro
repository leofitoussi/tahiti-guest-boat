---
interface FooterLink {
  label: string;
  href: string;
}

interface Props {
  brandName?: string;
  footerLinks?: FooterLink[];
  footerText?: string;
}

const {
  brandName = 'Tahiti Guest Boat',
  footerLinks = [],
  footerText,
} = Astro.props;

const year = new Date().getFullYear();
---

<footer class="border-t border-border/70 bg-muted/40">
  <div class="mx-auto grid max-w-site gap-8 px-5 py-12 md:grid-cols-[1fr_auto] md:px-8">
    <div class="flex flex-col gap-3">
      <a href="/" class="font-heading text-2xl font-semibold tracking-[0.16em] text-primary uppercase">{brandName}</a>
      {footerText ? (
        <p class="max-w-xl text-sm leading-relaxed text-muted-foreground">{footerText}</p>
      ) : (
        <p class="max-w-xl text-sm leading-relaxed text-muted-foreground">
          Croisieres privees et experiences lagon en Polynesie francaise.
        </p>
      )}
      <p class="text-sm text-muted-foreground">© {year} {brandName}</p>
    </div>

    {footerLinks.length > 0 && (
      <div class="flex flex-col gap-3 md:items-end">
        <nav class="flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold uppercase tracking-[0.14em]" aria-label="Navigation footer">
          {footerLinks.map((item) => (
            <a href={item.href} class="transition hover:text-primary">{item.label}</a>
          ))}
        </nav>
      </div>
    )}
  </div>
</footer>
