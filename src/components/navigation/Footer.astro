---
import { defaultLocale, type Locale } from '../../lib/localization';
import { getSiteCopy } from '../../lib/site-copy';

interface FooterLink {
  label: string;
  href: string;
}

interface Props {
  brandName?: string;
  homeHref?: string;
  logoUrl?: string;
  logoAlt?: string;
  footerLinks?: FooterLink[];
  cruiseLinks?: FooterLink[];
  cruisesNavigationLabel?: string;
  footerText?: string;
  contactEmail?: string;
  contactPhone?: string;
  navigationLabel?: string;
  locale?: Locale;
}

const {
  brandName = 'Tahiti Guest Boat',
  homeHref = '/',
  logoUrl,
  logoAlt = 'Logo Tahiti Guest Boat',
  footerLinks = [],
  cruiseLinks = [],
  cruisesNavigationLabel = 'Croisières',
  contactEmail,
  contactPhone,
  locale = defaultLocale,
} = Astro.props;
const copy = getSiteCopy(locale);
const navigationLabel = Astro.props.navigationLabel ?? copy.shell.footerNavigationLabel;

const year = new Date().getFullYear();
const phoneHref = contactPhone
  ? `tel:${contactPhone.replace(/[^+\d]/g, '')}`
  : undefined;
---

<footer class="bg-[var(--brand-secondary)] text-white">
  <div class="border-t border-white/15">
    <div class="mx-auto grid max-w-site gap-12 px-5 py-16 md:grid-cols-[1.15fr_0.55fr_0.65fr] md:px-8 lg:gap-16 lg:py-20">
      <div class="flex flex-col items-start gap-8">
        <a
          href={homeHref}
          class="inline-flex min-h-16 items-center transition-opacity hover:opacity-85 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/80"
          aria-label={brandName}
        >
          {
            logoUrl ? (
              <img src={logoUrl} alt={logoAlt} class="h-14 w-auto object-contain brightness-0 invert" width="220" height="74" />
            ) : (
              <span class="font-heading text-2xl font-semibold tracking-[0.16em] text-white uppercase">{brandName}</span>
            )
          }
        </a>
        {(contactEmail || contactPhone) && (
          <div class="flex flex-col gap-3 text-base font-medium text-white/82">
            {contactEmail && (
              <a
                href={`mailto:${contactEmail}`}
                class="inline-flex min-h-8 items-center transition hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/80"
              >
                {contactEmail}
              </a>
            )}
            {contactPhone && (
              <a
                href={phoneHref}
                class="inline-flex min-h-8 items-center transition hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/80"
              >
                {contactPhone}
              </a>
            )}
          </div>
        )}
      </div>

      {footerLinks.length > 0 && (
        <div class="flex flex-col gap-6">
          <p class="text-sm font-semibold uppercase tracking-[0.22em] text-white/62">{navigationLabel}</p>
          <nav class="flex flex-col gap-3 text-base font-medium" aria-label={navigationLabel}>
            {footerLinks.map((item) => (
              <a
                href={item.href}
                class="flex min-h-8 items-center text-white/84 transition hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/80"
              >
                {item.label}
              </a>
            ))}
          </nav>
        </div>
      )}

      {cruiseLinks.length > 0 && (
        <div class="flex flex-col gap-6">
          <p class="text-sm font-semibold uppercase tracking-[0.22em] text-white/62">{cruisesNavigationLabel}</p>
          <nav class="flex flex-col gap-3 text-base font-medium" aria-label={cruisesNavigationLabel}>
            {cruiseLinks.map((item) => (
              <a
                href={item.href}
                class="flex min-h-8 items-center leading-snug text-white/84 transition hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/80"
              >
                {item.label}
              </a>
            ))}
          </nav>
        </div>
      )}
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-site px-5 py-6 text-sm text-white/64 md:px-8">
      <p>© {year} {brandName}</p>
    </div>
  </div>
</footer>
