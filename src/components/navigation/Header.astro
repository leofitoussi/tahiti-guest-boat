---
import { DesktopNavigation } from './DesktopNavigation';
import { MobileDrawer } from './MobileDrawer';
import { buildLanguageSwitcher, defaultLocale, type LanguageSwitcherOption, type Locale } from '../../lib/localization';
import { getSiteCopy } from '../../lib/site-copy';

interface NavItem {
  label: string;
  href: string;
  hasDropdown?: boolean;
}

interface CruiseLink {
  label: string;
  href: string;
}

interface Props {
  logoUrl?: string;
  logoAlt?: string;
  brandName?: string;
  homeHref?: string;
  navItems?: NavItem[];
  cruiseLinks?: CruiseLink[];
  ctaLabel?: string;
  ctaHref?: string;
  mobileMenuLabel?: string;
  closeMenuLabel?: string;
  navigationLabel?: string;
  languageOptions?: LanguageSwitcherOption[];
  locale?: Locale;
}

const {
  logoUrl,
  logoAlt = 'Tahiti Guest Boat',
  brandName = 'Tahiti Guest Boat',
  homeHref = '/',
  navItems = [],
  cruiseLinks = [],
  ctaLabel,
  ctaHref = '/contact',
  locale = defaultLocale,
  languageOptions = buildLanguageSwitcher(locale),
} = Astro.props;
const copy = getSiteCopy(locale);
const mobileMenuLabel = Astro.props.mobileMenuLabel ?? copy.shell.mobileMenuLabel;
const navigationLabel = Astro.props.navigationLabel ?? copy.shell.navigationLabel;
---

<header class="border-b border-border/70 bg-background">
  <div class="mx-auto flex h-20 max-w-site items-center justify-between px-5 md:px-8">
    <a href={homeHref} class="flex min-w-0 items-center gap-3" aria-label={brandName}>
      {
        logoUrl ? (
          <img src={logoUrl} alt={logoAlt} class="h-12 w-auto shrink-0 object-contain" width="192" height="64" />
        ) : (
          <span class="font-heading text-2xl font-semibold tracking-[0.16em] text-primary uppercase">{brandName}</span>
        )
      }
    </a>

    <DesktopNavigation
      navItems={navItems}
      cruiseLinks={cruiseLinks}
      ctaLabel={ctaLabel}
      ctaHref={ctaHref}
      locale={locale}
      languageOptions={languageOptions}
    />

    <div class="md:hidden">
      <MobileDrawer
        navItems={navItems}
        cruiseLinks={cruiseLinks}
        ctaLabel={ctaLabel}
        ctaHref={ctaHref}
        menuLabel={mobileMenuLabel}
        closeMenuLabel={Astro.props.closeMenuLabel}
        navigationLabel={navigationLabel}
        locale={locale}
        languageOptions={languageOptions}
        client:media="(max-width: 767px)"
      />
    </div>
  </div>
</header>
