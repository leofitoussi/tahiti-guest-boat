---
interface NavItem {
  label: string;
  href: string;
  hasDropdown?: boolean;
}

interface Props {
  logoUrl?: string;
  logoAlt?: string;
  navItems: NavItem[];
  ctaLabel?: string;
  ctaHref?: string;
}

const { logoUrl, logoAlt = 'Tahiti Guest Boat', navItems, ctaLabel, ctaHref } = Astro.props;
---

<header class="border-b border-border/70 bg-background shadow-sm">
  <div class="mx-auto flex h-20 max-w-site items-center justify-between px-5 md:px-8">
    <a href="/" class="flex h-full items-center" aria-label="Tahiti Guest Boat">
      {
        logoUrl ? (
          <img src={logoUrl} alt={logoAlt} class="h-12 w-auto object-contain" width="300" height="92" />
        ) : (
          <div class="flex items-center gap-3 text-primary">
            <div class="relative h-14 w-14" aria-hidden="true">
              <div class="absolute left-5 top-1 h-12 w-7 skew-x-[-12deg] rounded-t-full bg-primary" />
              <div class="absolute bottom-2 left-1 h-1 w-12 rounded-full bg-primary" />
              <div class="absolute bottom-0 left-0 h-1 w-14 rounded-full bg-primary" />
            </div>
            <div class="leading-none">
              <p class="font-heading text-[2.15rem] font-semibold tracking-[0.16em] uppercase">Tahiti</p>
              <p class="font-heading text-[1.15rem] font-semibold italic tracking-[0.26em] uppercase">Guest Boat</p>
            </div>
          </div>
        )
      }
    </a>

    <nav class="hidden items-center gap-10 pr-1 text-sm font-semibold uppercase tracking-[0.14em] text-foreground md:flex">
      {
        navItems.map((item) => (
          <a href={item.href} class="inline-flex items-center gap-3 whitespace-nowrap transition-colors hover:text-primary">
            {item.label}
            {item.hasDropdown && <span class="mt-1 h-0 w-0 border-x-[6px] border-t-[7px] border-x-transparent border-t-current" />}
          </a>
        ))
      }
      {
        ctaLabel && (
          <a
            href={ctaHref || '/contact'}
            class="inline-flex h-11 items-center rounded-[var(--radius-control)] bg-primary px-7 text-sm font-semibold tracking-[0.12em] uppercase text-primary-foreground transition-colors hover:bg-primary/90"
          >
            {ctaLabel}
          </a>
        )
      }
    </nav>

    <button class="mr-1 flex h-11 w-11 items-center justify-center rounded-[var(--radius-control)] border border-border/70 text-primary transition-colors hover:bg-muted md:hidden" aria-label="Ouvrir le menu">
      <span class="flex flex-col gap-1.5">
        <span class="block h-[2px] w-5 rounded-full bg-current"></span>
        <span class="block h-[2px] w-5 rounded-full bg-current"></span>
        <span class="block h-[2px] w-5 rounded-full bg-current"></span>
      </span>
    </button>
  </div>
</header>
