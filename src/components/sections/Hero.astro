---
import SiteHeader from '../navigation/SiteHeader.astro';

interface ImageData {
  url?: string;
  srcset?: string;
  sizes?: string;
  alt?: string;
  width?: number;
  height?: number;
  background?: string;
  lqip?: string;
}

interface NavItem {
  label: string;
  href: string;
  hasDropdown?: boolean;
}

interface Props {
  logo?: ImageData;
  navItems: NavItem[];
  reservationLabel?: string;
  reservationHref?: string;
  image?: ImageData;
  keywords: string[];
  title: string;
  body?: string;
  primaryCta?: {
    label?: string;
    href?: string;
  };
  secondaryCta?: {
    label?: string;
    href?: string;
  };
}

const {
  logo,
  navItems,
  reservationLabel,
  reservationHref,
  image,
  keywords,
  title,
  body,
  primaryCta,
  secondaryCta,
} = Astro.props;
---

<SiteHeader
  logoUrl={logo?.url}
  logoAlt={logo?.alt}
  navItems={navItems}
  ctaLabel={reservationLabel}
  ctaHref={reservationHref}
/>

<main class="bg-white">
  <section class="relative overflow-hidden bg-[#b9eef2]">
    {
      image?.url ? (
        <div
          class="h-[424px] w-full bg-cover bg-center sm:h-[640px] md:h-[716px]"
          style={{
            backgroundColor: image.background || '#b9eef2',
            backgroundImage: image.lqip ? `url(${image.lqip})` : undefined,
          }}
        >
          <img
            src={image.url}
            srcset={image.srcset}
            sizes={image.sizes || '100vw'}
            alt={image.alt || ''}
            class="h-full w-full object-cover object-center"
            width={image.width || 2048}
            height={image.height || 716}
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
      ) : (
        <div class="h-[424px] w-full bg-[linear-gradient(180deg,#bfe9ff_0%,#7eddea_28%,#14b5c2_58%,#77e4e5_100%)] sm:h-[640px] md:h-[716px]">
          <div class="h-full w-full bg-[radial-gradient(ellipse_at_38%_24%,rgba(95,91,35,.72)_0%,rgba(95,91,35,.56)_18%,rgba(95,91,35,0)_33%),radial-gradient(ellipse_at_34%_66%,rgba(0,70,90,.36)_0%,rgba(0,70,90,0)_24%)]" />
        </div>
      )
    }
  </section>

  <section class="relative mx-auto max-w-[1760px] px-5 pb-10 pt-0 md:grid md:grid-cols-[320px_1fr] md:gap-10 md:px-12 md:pb-12 md:pt-11 lg:grid-cols-[430px_1fr]">
    <div class="-mt-12 mb-16 rounded-t-lg bg-white px-4 py-5 shadow-[0_-1px_0_rgba(0,0,0,.04)] md:mt-32 md:mb-0 md:rounded-none md:bg-transparent md:px-0 md:py-0 md:shadow-none">
      <div class="grid grid-cols-3 gap-3 text-center font-serif text-[22px] leading-tight text-[#071a3a] sm:text-[28px] md:block md:text-left md:text-[64px] lg:text-[64px]">
        {
          keywords.map((keyword, index) => (
            <p class:list={['md:mb-8', index === keywords.length - 1 && 'font-bold italic']}>{keyword}</p>
          ))
        }
      </div>
    </div>

    <div class="md:pt-0">
      <h1 class="max-w-[1120px] font-serif text-[50px] font-bold leading-[1.18] text-[#285aaa] sm:text-[68px] md:text-[64px] lg:text-[70px]">
        {title}
      </h1>
      {
        body && (
          <p class="mt-8 max-w-[1340px] text-[25px] leading-[1.62] text-[#111827] md:text-[23px] md:leading-[1.72] lg:text-[24px]">
            {body}
          </p>
        )
      }

      <div class="mt-8 grid gap-8 md:flex md:gap-8">
        {
          primaryCta?.label && (
            <a
              href={primaryCta.href || '/contact'}
              class="inline-flex min-h-[76px] items-center justify-center rounded-lg bg-[#285aaa] px-9 text-center text-[24px] font-bold text-white underline decoration-2 underline-offset-2 transition hover:bg-[#1f4a91] md:min-h-[74px]"
            >
              {primaryCta.label}
            </a>
          )
        }
        {
          secondaryCta?.label && (
            <a
              href={secondaryCta.href || '#'}
              class="inline-flex min-h-[76px] items-center justify-center rounded-lg border-2 border-[#285aaa] px-9 text-center text-[24px] font-bold text-[#285aaa] underline decoration-2 underline-offset-2 transition hover:bg-[#eef4ff] md:min-h-[74px]"
            >
              {secondaryCta.label}
            </a>
          )
        }
      </div>
    </div>
  </section>
</main>
