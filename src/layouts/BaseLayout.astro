---
import '../styles/global.css';
import Header from '../components/navigation/Header.astro';
import Footer from '../components/navigation/Footer.astro';
import { getSiteSettings } from '../lib/cruises';
import { urlForImage } from '../lib/sanity';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Croisieres privees et experiences lagon en Polynesie francaise avec Tahiti Guest Boat.',
} = Astro.props;

const settings = await getSiteSettings();

const navItems = settings?.nav?.map((item) => ({
  label: item.label ?? '',
  href: item.href ?? '#',
  hasDropdown: item.hasDropdown ?? false,
})) ?? [];

const logoUrl = settings?.logo
  ? urlForImage(settings.logo)?.width(360).auto('format').url()
  : undefined;

const logoAlt = settings?.logoAlt ?? 'Logo';

const brandName = settings?.siteName ?? 'Tahiti Guest Boat';

const ctaLabel = settings?.reservationText ?? 'Réserver';
const ctaHref = settings?.reservationLink ?? '/reservation';

const footerLinks = settings?.footerLinks?.map((l) => ({
  label: l.label ?? '',
  href: l.url ?? '#',
})) ?? [];

const footerText = settings?.footerText;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <Header
      logoUrl={logoUrl ?? undefined}
      logoAlt={logoAlt}
      brandName={brandName}
      navItems={navItems}
      ctaLabel={ctaLabel}
      ctaHref={ctaHref}
    />
    <slot />
    <Footer brandName={brandName} footerLinks={footerLinks} footerText={footerText} />
  </body>
</html>
