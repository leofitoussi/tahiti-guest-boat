---
import '../styles/global.css';
import Header from '../components/navigation/Header.astro';
import Footer from '../components/navigation/Footer.astro';
import { getCruisePages, getSiteSettings, type SiteSettings } from '../lib/cruises';
import { buildLayoutViewModel } from '../lib/site-settings';
import { urlForImage } from '../lib/sanity';
import { buildLocalizedMetadata, defaultLocale, type Locale } from '../lib/localization';
import { getSiteCopy } from '../lib/site-copy';

interface Props {
  title: string;
  description?: string;
  image?: string;
  settings?: SiteSettings | null;
  locale?: Locale;
  alternatePaths?: Partial<Record<Locale, string>>;
  noindex?: boolean;
  structuredData?: Record<string, unknown>[];
  heroPreload?: { srcset: string; sizes: string };
}

const {
  title,
  description,
  image,
  settings: providedSettings,
  locale = defaultLocale,
  alternatePaths = {},
  noindex = false,
  structuredData = [],
  heroPreload,
} = Astro.props;

const copy = getSiteCopy(locale);
const [settings, cruisePages] = await Promise.all([
  providedSettings ? Promise.resolve(providedSettings) : getSiteSettings(locale),
  getCruisePages(locale),
]);

const logoUrl = settings?.logo
  ? urlForImage(settings.logo)?.width(360).auto('format').url()
  : undefined;
const layoutViewModel = buildLayoutViewModel(settings, logoUrl, locale, cruisePages);
const metadata = buildLocalizedMetadata(Astro.url.pathname, {
  locale,
  siteUrl: Astro.site?.href,
  alternatePaths,
});
---

<!doctype html>
<html lang={metadata.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description ?? copy.shell.defaultDescription} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />
    {heroPreload && (
      <link
        rel="preload"
        as="image"
        imagesrcset={heroPreload.srcset}
        imagesizes={heroPreload.sizes}
        fetchpriority="high"
      />
    )}
    <link rel="canonical" href={metadata.canonical} />
    {metadata.alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.locale} href={alternate.path} />
    ))}
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description ?? copy.shell.defaultDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={metadata.canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description ?? copy.shell.defaultDescription} />
    {image && <meta name="twitter:image" content={image} />}
    {structuredData.map((data) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(data)} />
    ))}
  </head>
  <body>
    <Header
      logoUrl={layoutViewModel.logoUrl}
      logoAlt={layoutViewModel.logoAlt}
      brandName={layoutViewModel.brandName}
      homeHref={layoutViewModel.homeHref}
      navItems={layoutViewModel.navItems}
      ctaLabel={layoutViewModel.ctaLabel}
      ctaHref={layoutViewModel.ctaHref}
      cruiseLinks={layoutViewModel.cruiseLinks}
      mobileMenuLabel={layoutViewModel.mobileMenuLabel}
      navigationLabel={layoutViewModel.navigationLabel}
    />
    <slot />
    <Footer
      brandName={layoutViewModel.brandName}
      homeHref={layoutViewModel.homeHref}
      logoUrl={layoutViewModel.logoUrl}
      logoAlt={layoutViewModel.logoAlt}
      footerLinks={layoutViewModel.footerLinks}
      cruiseLinks={layoutViewModel.cruiseLinks}
      cruisesNavigationLabel={layoutViewModel.cruisesNavigationLabel}
      footerText={layoutViewModel.footerText}
      contactEmail={layoutViewModel.contactEmail}
      contactPhone={layoutViewModel.contactPhone}
      navigationLabel={layoutViewModel.footerNavigationLabel}
    />
  </body>
</html>
