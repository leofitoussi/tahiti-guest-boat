---
import BlogContent from '../../components/blog/BlogContent.astro';
import TableOfContents from '../../components/blog/TableOfContents.astro';
import Container from '../../components/layout/Container.astro';
import Section from '../../components/layout/Section.astro';
import { buttonVariants } from '../../components/ui/button';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatPostDate, getAllBlogSlugs, getBlogPost, type BlogPost } from '../../lib/blog';
import { buildLocalizedMetadata, defaultLocale, localizePath } from '../../lib/localization';
import { extractHeadings } from '../../lib/portable-text-headings';
import { getSiteCopy } from '../../lib/site-copy';
import { urlForImage } from '../../lib/sanity';
import { buildBlogPostingStructuredData } from '../../lib/blog-seo';

const locale = defaultLocale;
const copy = getSiteCopy(locale);

export async function getStaticPaths() {
  const slugs = await getAllBlogSlugs(defaultLocale);

  return slugs.map(({ slug }) => ({
    params: { slug },
    props: { post: { slug } },
  }));
}

const summary = Astro.props.post as BlogPost;
const post = (await getBlogPost(summary.slug, locale)) || summary;
const headings = extractHeadings(post.body);

const title = post.seoTitle || `${post.title} | Tahiti Guest Boat`;
const description = post.seoDescription || post.excerpt || copy.pages.blogPost.fallbackDescription;
const mainImageUrl = post.mainImage
  ? urlForImage(post.mainImage)?.width(1440).height(810).fit('crop').quality(84).auto('format').url()
  : undefined;
const secondaryCruises = post.secondaryCruises ?? [];
const metadata = buildLocalizedMetadata(Astro.url.pathname, {
  locale,
  siteUrl: Astro.site?.href,
});
const structuredData = [
  buildBlogPostingStructuredData(post, {
    canonicalUrl: metadata.canonical,
    siteUrl: (Astro.site?.href ?? 'https://tahiti-guest-boat.com/').replace(/\/$/, ''),
    image: mainImageUrl,
  }),
];
---

<BaseLayout
  title={title}
  description={description}
  image={mainImageUrl}
  imageWidth={1440}
  imageHeight={810}
  locale={locale}
  structuredData={structuredData}
  noindex={!post.seo?.indexable}
>
  <main class="bg-background">
    <article>

      {/* Hero */}
      <Section padding="lg" class="border-b border-border/70 bg-muted/30">
        <Container class="max-w-[960px]">
          <a
            href={localizePath('/blog/', locale)}
            class={buttonVariants({ variant: 'ghost', className: 'mb-6 w-fit px-0 text-muted-foreground hover:text-foreground' })}
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="mr-1.5">
              <path d="M13 8H3M7 12l-4-4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {copy.pages.blogPost.backToBlog}
          </a>
          <div class="flex flex-col gap-5">
            {post.updatedAt ? (
              <time
                datetime={post.updatedAt}
                class="text-sm font-medium tracking-wide text-muted-foreground uppercase"
              >
                {copy.pages.blogPost.updatedOn} {formatPostDate(post.updatedAt, locale)}
              </time>
            ) : post.publishedAt && (
              <time
                datetime={post.publishedAt}
                class="text-sm font-medium tracking-wide text-muted-foreground uppercase"
              >
                {formatPostDate(post.publishedAt, locale)}
              </time>
            )}
            <h1
              class="font-heading font-semibold leading-[--line-height-heading] text-foreground"
              style="font-size: var(--heading-1)"
            >
              {post.title}
            </h1>
            {post.excerpt && (
              <p class="max-w-2xl text-xl leading-relaxed text-muted-foreground">
                {post.excerpt}
              </p>
            )}
          </div>
        </Container>
      </Section>

      {/* Main image */}
      {mainImageUrl && (
        <div class="border-b border-border/70">
          <Container class="px-0 sm:px-5 md:px-8">
            <figure>
              <img
                src={mainImageUrl}
                alt={post.mainImage?.alt || ''}
                width="1440"
                height="810"
                loading="eager"
                decoding="async"
                fetchpriority="high"
                class="max-h-[600px] w-full object-cover sm:rounded-b-[var(--radius-surface)]"
                style={{ backgroundColor: post.mainImage?.metadata?.palette?.dominant?.background || 'var(--muted)' }}
              />
              {post.mainImage?.caption && (
                <figcaption class="px-5 py-3 text-sm text-muted-foreground sm:px-1">
                  {post.mainImage.caption}
                </figcaption>
              )}
            </figure>
          </Container>
        </div>
      )}

      <div class="mx-auto w-full max-w-[960px] px-5 md:px-8 lg:grid lg:grid-cols-[minmax(0,1fr)_220px] lg:gap-12 lg:items-start">
        <div>
          {/* Body */}
          <Section padding="lg" class="lg:py-20">
            {/* TOC mobile — replié en tête, masqué sur desktop */}
            <div class="lg:hidden">
              <TableOfContents headings={headings} label={copy.pages.blogPost.tableOfContents} variant="mobile" />
            </div>

            <div class="max-w-[68ch]">
              <BlogContent value={post.body} />
            </div>
          </Section>

          {/* Related cruises */}
          {(post.primaryCruise || secondaryCruises.length > 0) && (
            <Section padding="lg" class="border-t border-border/70 bg-muted/30 lg:py-20">
              <div class="max-w-[860px]">
                <p class="mb-8 text-xs font-semibold tracking-widest text-muted-foreground uppercase">
                  {copy.pages.blogPost.primaryCruise}
                </p>
                <div class="grid gap-5 sm:grid-cols-2">
                  {post.primaryCruise && (() => {
                    const cruiseImageUrl = post.primaryCruise.heroImage
                      ? urlForImage(post.primaryCruise.heroImage)?.width(640).height(380).fit('crop').quality(82).auto('format').url()
                      : undefined;
                    return (
                      <article class="group overflow-hidden rounded-[var(--radius-surface)] border border-border/70 bg-card shadow-xs transition hover:shadow-md">
                        {cruiseImageUrl && (
                          <div class="overflow-hidden">
                            <img
                              src={cruiseImageUrl}
                              alt={post.primaryCruise.heroImage?.alt || post.primaryCruise.heroTitle || ''}
                              width="640"
                              height="380"
                              loading="lazy"
                              decoding="async"
                              class="aspect-[5/3] w-full object-cover transition duration-500 group-hover:scale-[1.02]"
                              style={{ backgroundColor: post.primaryCruise.heroImage?.metadata?.palette?.dominant?.background || 'var(--muted)' }}
                            />
                          </div>
                        )}
                        <div class="flex flex-col gap-4 p-6">
                          <h2 class="font-heading text-2xl font-semibold leading-tight text-foreground">
                            {post.primaryCruise.heroTitle || post.primaryCruise.title}
                          </h2>
                          {post.primaryCruise.excerpt && (
                            <p class="text-sm leading-relaxed text-muted-foreground">{post.primaryCruise.excerpt}</p>
                          )}
                          <a
                            href={localizePath(`/nos-croisieres/${post.primaryCruise.slug}/`, locale)}
                            class={buttonVariants({ variant: 'primary', className: 'mt-2 w-fit' })}
                          >
                            {copy.pages.blogPost.discoverCruise}
                          </a>
                        </div>
                      </article>
                    );
                  })()}

                  {secondaryCruises.length > 0 && (
                    <div class="flex flex-col gap-4">
                      {secondaryCruises.map((cruise) => {
                        const cruiseImageUrl = cruise.heroImage
                          ? urlForImage(cruise.heroImage)?.width(480).height(200).fit('crop').quality(80).auto('format').url()
                          : undefined;
                        return (
                          <a
                            href={localizePath(`/nos-croisieres/${cruise.slug}/`, locale)}
                            class="group flex items-center gap-4 overflow-hidden rounded-[var(--radius-surface)] border border-border/70 bg-card p-4 shadow-xs transition hover:shadow-md hover:-translate-y-0.5"
                          >
                            {cruiseImageUrl && (
                              <div class="shrink-0 overflow-hidden rounded-[var(--radius-control)]">
                                <img
                                  src={cruiseImageUrl}
                                  alt={cruise.heroImage?.alt || cruise.heroTitle || ''}
                                  width="96"
                                  height="72"
                                  loading="lazy"
                                  decoding="async"
                                  class="h-18 w-24 object-cover transition duration-500 group-hover:scale-[1.04]"
                                  style={{ backgroundColor: cruise.heroImage?.metadata?.palette?.dominant?.background || 'var(--muted)' }}
                                />
                              </div>
                            )}
                            <div class="min-w-0 flex-1">
                              <h3 class="font-heading text-lg font-semibold leading-tight text-foreground transition group-hover:text-primary">
                                {cruise.heroTitle || cruise.title}
                              </h3>
                              {cruise.excerpt && (
                                <p class="mt-1 line-clamp-2 text-sm leading-relaxed text-muted-foreground">{cruise.excerpt}</p>
                              )}
                            </div>
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="shrink-0 text-muted-foreground transition group-hover:text-primary group-hover:translate-x-0.5">
                              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          </a>
                        );
                      })}
                    </div>
                  )}
                </div>
              </div>
            </Section>
          )}
        </div>

        {/* TOC desktop — sidebar sticky */}
        <div class="hidden lg:block lg:sticky lg:self-start lg:pt-6" style="top: var(--toc-sticky-top, 6rem);">
          <TableOfContents headings={headings} label={copy.pages.blogPost.tableOfContents} variant="desktop" />
        </div>
      </div>

    </article>
  </main>
</BaseLayout>
