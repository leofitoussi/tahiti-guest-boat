---
import SiteHeader from '../../components/navigation/SiteHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBlogPosts, formatPostDate } from '../../lib/blog';
import { urlForImage } from '../../lib/sanity';

const posts = await getBlogPosts();
const navItems = [
  { label: 'Notre bateau', href: '/notre-bateau', hasDropdown: true },
  { label: 'Nos croisières', href: '/nos-croisieres', hasDropdown: true },
  { label: 'Notre blog', href: '/blog', hasDropdown: false },
];
---

<BaseLayout
  title="Blog | Tahiti Guest Boat"
  description="Articles, conseils et inspirations pour préparer une croisiere en Polynesie avec Tahiti Guest Boat."
>
  <SiteHeader navItems={navItems} ctaLabel="Réserver" ctaHref="/reservation" />

  <main class="bg-white">
    <section class="mx-auto max-w-[1180px] px-5 pb-12 pt-16 md:px-8 md:pb-16 md:pt-24">
      <p class="text-sm font-bold uppercase tracking-[0.18em] text-[#285aaa]">Notre blog</p>
      <h1 class="mt-4 max-w-[900px] font-serif text-[44px] font-bold leading-tight text-[#071a3a] md:text-[68px]">
        Conseils et inspirations pour naviguer en Polynésie
      </h1>
      <p class="mt-6 max-w-[760px] text-xl leading-8 text-[#344054]">
        Retrouvez les derniers articles de Tahiti Guest Boat pour préparer votre expérience dans les lagons.
      </p>
    </section>

    <section class="mx-auto max-w-[1180px] px-5 pb-20 md:px-8">
      {
        posts.length > 0 ? (
          <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => {
              const imageUrl = post.mainImage
                ? urlForImage(post.mainImage)?.width(760).height(500).fit('crop').quality(82).auto('format').url()
                : undefined;

              return (
                <article class="overflow-hidden rounded-lg border border-[#d9e3ef] bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-md">
                  <a href={`/blog/${post.slug}`} class="block">
                    <div class="aspect-[1.52] bg-[#eef4f8]">
                      {imageUrl ? (
                        <img
                          src={imageUrl}
                          alt={post.mainImage?.alt || ''}
                          width="760"
                          height="500"
                          loading="lazy"
                          decoding="async"
                          class="h-full w-full object-cover"
                        />
                      ) : (
                        <div class="h-full w-full bg-[linear-gradient(135deg,#d9f4f6_0%,#b6dde9_50%,#eef4f8_100%)]" />
                      )}
                    </div>
                    <div class="p-6">
                      {post.publishedAt && (
                        <p class="text-sm font-bold uppercase tracking-[0.12em] text-[#526071]">
                          {formatPostDate(post.publishedAt)}
                        </p>
                      )}
                      <h2 class="mt-3 font-serif text-[30px] font-bold leading-tight text-[#071a3a]">{post.title}</h2>
                      {post.excerpt && <p class="mt-4 text-base leading-7 text-[#344054]">{post.excerpt}</p>}
                      <p class="mt-5 font-bold text-[#285aaa] underline underline-offset-4">Lire l’article</p>
                    </div>
                  </a>
                </article>
              );
            })}
          </div>
        ) : (
          <div class="rounded-lg border border-dashed border-[#b7c7d8] bg-[#f7f8fb] px-6 py-12 text-center">
            <h2 class="font-serif text-[32px] font-bold text-[#071a3a]">Aucun article publié pour le moment</h2>
            <p class="mx-auto mt-3 max-w-[620px] text-lg leading-8 text-[#344054]">
              Les articles ajoutés dans Sanity Studio apparaîtront ici après publication et rebuild du site.
            </p>
          </div>
        )
      }
    </section>
  </main>
</BaseLayout>
