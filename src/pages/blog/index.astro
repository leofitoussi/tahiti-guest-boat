---
import Container from '../../components/layout/Container.astro';
import Grid from '../../components/layout/Grid.astro';
import Section from '../../components/layout/Section.astro';
import { Badge } from '../../components/ui/badge';
import { buttonVariants } from '../../components/ui/button';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../../components/ui/card';
import { Separator } from '../../components/ui/separator';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBlogPosts, formatPostDate } from '../../lib/blog';
import { urlForImage } from '../../lib/sanity';

const posts = await getBlogPosts();
---

<BaseLayout
  title="Blog | Tahiti Guest Boat"
  description="Articles, conseils et inspirations pour préparer une croisiere en Polynesie avec Tahiti Guest Boat."
>
  <main class="bg-background">
    <Section padding="lg" class="border-b border-border/70 bg-muted/30">
      <Container>
        <div class="flex max-w-4xl flex-col gap-5">
          <Badge>Notre blog</Badge>
          <h1 class="font-heading font-semibold leading-tight text-foreground">
            Conseils et inspirations pour naviguer en Polynésie
          </h1>
          <p class="max-w-3xl text-lg leading-relaxed text-muted-foreground md:text-xl">
            Retrouvez les derniers articles de Tahiti Guest Boat pour préparer votre expérience dans les lagons.
          </p>
        </div>
      </Container>
    </Section>

    <Section padding="lg">
      <Container>
      {
        posts.length > 0 ? (
          <Grid columns={3}>
            {posts.map((post) => {
              const imageUrl = post.mainImage
                ? urlForImage(post.mainImage)?.width(760).height(500).fit('crop').quality(82).auto('format').url()
                : undefined;

              return (
                <Card className="transition hover:-translate-y-1 hover:shadow-md">
                  <a href={`/blog/${post.slug}`} class="block">
                    {imageUrl ? (
                      <img
                        src={imageUrl}
                        alt={post.mainImage?.alt || ''}
                        width="760"
                        height="500"
                        loading="lazy"
                        decoding="async"
                        class="aspect-[1.52] w-full object-cover"
                      />
                    ) : (
                      <div class="aspect-[1.52] w-full bg-muted" />
                    )}
                  </a>
                  <CardHeader>
                    <div class="flex flex-col gap-3">
                      {post.publishedAt && (
                        <Badge variant="secondary">{formatPostDate(post.publishedAt)}</Badge>
                      )}
                      <CardTitle>
                        <a href={`/blog/${post.slug}`} class="transition hover:text-primary">{post.title}</a>
                      </CardTitle>
                      {post.excerpt && <CardDescription>{post.excerpt}</CardDescription>}
                    </div>
                  </CardHeader>
                  <CardContent>
                    <Separator className="mb-5" />
                    <a href={`/blog/${post.slug}`} class={buttonVariants({ variant: 'ghost', className: 'px-0' })}>
                      Lire l'article
                    </a>
                  </CardContent>
                </Card>
              );
            })}
          </Grid>
        ) : (
          <Card className="border border-dashed border-border text-center">
            <CardHeader>
              <CardTitle>Aucun article publié pour le moment</CardTitle>
              <CardDescription className="mx-auto max-w-2xl">
                Les articles ajoutés dans Sanity Studio apparaîtront ici après publication et rebuild du site.
              </CardDescription>
            </CardHeader>
          </Card>
        )
      }
      </Container>
    </Section>
  </main>
</BaseLayout>
