---
import PageBuilder from '../components/blocks/PageBuilder.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCruisePages, getReviews, getSiteSettings } from '../lib/cruises';
import { getUniquePage } from '../lib/page-builder';
import { defaultLocale } from '../lib/localization';
import { getSiteCopy } from '../lib/site-copy';

const locale = defaultLocale;
const copy = getSiteCopy(locale);

const page = await getUniquePage('contactPage', locale);
const [settings, reviews, cruises] = await Promise.all([
  getSiteSettings(locale),
  getReviews(3),
  getCruisePages(locale),
]);

const title = page?.seoTitle ?? copy.pages.contact.title;
const description = page?.seoDescription ?? copy.pages.contact.description;
const pageBuilder = (page?.pageBuilder as Record<string, unknown>[] | undefined) ?? [];
---

<BaseLayout title={title} description={description} settings={settings} locale={locale}>
  <main class="bg-background">
    <PageBuilder blocks={pageBuilder} settings={settings} reviews={reviews} cruises={cruises.slice(0, 3)} locale={locale} />
  </main>
</BaseLayout>
