---
import LegalPageView from '../../components/legal/LegalPageView.astro';
import { getLegalPage, getLegalPages, getLegalTranslationVersions, type LegalPage } from '../../lib/legal-pages';
import { buildLegalAlternatePaths } from '../../lib/legal-routes';

const locale = 'en' as const;

export async function getStaticPaths() {
  const pages = await getLegalPages('en');

  return pages.map((page) => ({
    params: { slug: page.slug },
    props: { slug: page.slug },
  }));
}

const { slug } = Astro.props;
const page = (await getLegalPage(slug, locale)) as LegalPage | null;

if (!page) {
  return;
}

const translations = await getLegalTranslationVersions(page);
const alternatePaths = buildLegalAlternatePaths(translations, locale);
---

<LegalPageView page={page} locale={locale} alternatePaths={alternatePaths} />
