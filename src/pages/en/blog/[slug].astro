---
import BlogArticlePage from '../../../components/blog/BlogArticlePage.astro';
import { getAllBlogSlugs, getBlogPost, getBlogTranslationVersions, type BlogPost } from '../../../lib/blog';
import { buildBlogAlternatePaths } from '../../../lib/blog-routes';

const locale = 'en' as const;

export async function getStaticPaths() {
  const slugs = await getAllBlogSlugs('en');

  return slugs.map(({ slug }) => ({
    params: { slug },
    props: { post: { slug } },
  }));
}

const summary = Astro.props.post as { slug: string };
const post = (await getBlogPost(summary.slug, locale)) as BlogPost | null;

if (!post) {
  return;
}

const translations = await getBlogTranslationVersions(post);
const alternatePaths = buildBlogAlternatePaths(translations, locale);
---

<BlogArticlePage post={post} locale={locale} alternatePaths={alternatePaths} />
