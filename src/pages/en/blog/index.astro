---
import Container from '../../../components/layout/Container.astro';
import Section from '../../../components/layout/Section.astro';
import { Badge } from '../../../components/ui/badge';
import { Card, CardDescription, CardHeader, CardTitle } from '../../../components/ui/card';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getBlogPosts, formatPostDate } from '../../../lib/blog';
import { localizePath } from '../../../lib/localization';
import { getSiteCopy } from '../../../lib/site-copy';
import { urlForImage } from '../../../lib/sanity';

const locale = 'en' as const;
const copy = getSiteCopy(locale);
const posts = await getBlogPosts(locale);
const [featured, ...rest] = posts;
---

<BaseLayout
  title={copy.pages.blogIndex.title}
  description={copy.pages.blogIndex.description}
  locale={locale}
  alternatePaths={{ fr: '/blog/' }}
>
  <main class="bg-background">
    <Section padding="lg" class="border-b border-border/70 bg-muted/30">
      <Container>
        <div class="flex max-w-3xl flex-col gap-4">
          <Badge>{copy.pages.blogIndex.badge}</Badge>
          <h1 class="font-heading font-semibold leading-[--line-height-heading] text-foreground" style="font-size: var(--heading-2)">
            {copy.pages.blogIndex.heading}
          </h1>
          <p class="max-w-2xl text-lg leading-relaxed text-muted-foreground md:text-xl">{copy.pages.blogIndex.intro}</p>
        </div>
      </Container>
    </Section>

    {posts.length === 0 && (
      <Section padding="lg">
        <Container>
          <Card className="border border-dashed border-border text-center">
            <CardHeader>
              <CardTitle>{copy.pages.blogIndex.emptyTitle}</CardTitle>
              <CardDescription className="mx-auto max-w-2xl">{copy.pages.blogIndex.emptyDescription}</CardDescription>
            </CardHeader>
          </Card>
        </Container>
      </Section>
    )}

    {featured && (
      <Section padding="lg">
        <Container>
          <a
            href={localizePath(`/blog/${featured.slug}/`, locale)}
            class="group mb-14 grid overflow-hidden rounded-[var(--radius-surface)] border border-border/70 bg-card shadow-sm transition hover:shadow-md md:grid-cols-2"
            aria-label={featured.title}
          >
            {(() => {
              const imageUrl = featured.mainImage
                ? urlForImage(featured.mainImage)?.width(900).height(600).fit('crop').quality(84).auto('format').url()
                : undefined;
              return imageUrl ? (
                <div class="overflow-hidden">
                  <img src={imageUrl} alt={featured.mainImage?.alt || ''} width="900" height="600" loading="eager" decoding="async" class="h-full min-h-64 w-full object-cover" />
                </div>
              ) : (
                <div class="min-h-64 w-full bg-muted" />
              );
            })()}
            <div class="flex flex-col justify-between gap-6 p-8 md:p-10 lg:p-12">
              <div class="flex flex-col gap-4">
                {featured.updatedAt ? (
                  <span class="text-sm font-medium text-muted-foreground">{copy.pages.blogIndex.updatedOn} {formatPostDate(featured.updatedAt, locale)}</span>
                ) : featured.publishedAt && (
                  <span class="text-sm font-medium text-muted-foreground">{formatPostDate(featured.publishedAt, locale)}</span>
                )}
                <h2 class="font-heading font-semibold leading-tight text-foreground transition group-hover:text-primary" style="font-size: var(--heading-4)">{featured.title}</h2>
                {featured.excerpt && <p class="leading-relaxed text-muted-foreground">{featured.excerpt}</p>}
              </div>
              <span class="text-sm font-semibold text-primary">{copy.pages.blogIndex.readArticle}</span>
            </div>
          </a>

          {rest.length > 0 && (
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {rest.map((post) => {
                const imageUrl = post.mainImage
                  ? urlForImage(post.mainImage)?.width(600).height(400).fit('crop').quality(82).auto('format').url()
                  : undefined;

                return (
                  <article class="group flex flex-col overflow-hidden rounded-[var(--radius-surface)] border border-border/70 bg-card shadow-xs transition hover:shadow-md hover:-translate-y-0.5">
                    <a href={localizePath(`/blog/${post.slug}/`, locale)} class="overflow-hidden" tabindex="-1" aria-hidden="true">
                      {imageUrl ? <img src={imageUrl} alt={post.mainImage?.alt || ''} width="600" height="400" loading="lazy" decoding="async" class="aspect-[3/2] w-full object-cover" /> : <div class="aspect-[3/2] w-full bg-muted" />}
                    </a>
                    <div class="flex flex-1 flex-col gap-3 p-6">
                      {post.updatedAt ? <span class="text-xs font-medium text-muted-foreground">{copy.pages.blogIndex.updatedOn} {formatPostDate(post.updatedAt, locale)}</span> : post.publishedAt && <span class="text-xs font-medium text-muted-foreground">{formatPostDate(post.publishedAt, locale)}</span>}
                      <h2 class="font-heading font-semibold leading-tight text-foreground" style="font-size: var(--heading-6)">
                        <a href={localizePath(`/blog/${post.slug}/`, locale)} class="transition hover:text-primary">{post.title}</a>
                      </h2>
                      {post.excerpt && <p class="line-clamp-3 text-sm leading-relaxed text-muted-foreground">{post.excerpt}</p>}
                      <div class="mt-auto pt-4"><a href={localizePath(`/blog/${post.slug}/`, locale)} class="text-sm font-semibold text-primary">{copy.pages.blogIndex.readArticle}</a></div>
                    </div>
                  </article>
                );
              })}
            </div>
          )}
        </Container>
      </Section>
    )}
  </main>
</BaseLayout>
