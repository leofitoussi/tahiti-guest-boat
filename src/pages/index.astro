---
import PageBuilder from '../components/blocks/PageBuilder.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getActivities, getCruisePages, getReviews, getSiteSettings } from '../lib/cruises';
import { heroImageSources, isSanityConfigured } from '../lib/sanity';
import { defaultLocale } from '../lib/localization';
import { getSiteCopy } from '../lib/site-copy';
import { localizedDocumentFields } from '../lib/sanity-localization';
import { pageBuilderFields } from '../lib/page-builder';
import { sanityClient } from 'sanity:client';

// ─── Types ───────────────────────────────────────────────────────────────────

interface HomePage {
  seoTitle?: string;
  seoDescription?: string;
  pageBuilder?: Record<string, unknown>[];
}

// ─── Query Sanity ─────────────────────────────────────────────────────────────

// La homepage est un singleton épinglé sur cet ID dans le Studio (cf. sanity.config.ts).
// On cible explicitement ce document pour éviter qu'un doublon `homePage` plus récemment
// modifié ne soit servi à la place (sinon `order(_updatedAt desc)[0]` choisit le mauvais).
const HOME_PAGE_ID = 'f512860b-c337-4a81-b057-a93acdc2c961';

const HOME_QUERY = `*[_id == $homeId && !(_id in path("drafts.**"))][0]{
  ${localizedDocumentFields},
  seoTitle,
  seoDescription,
  ${pageBuilderFields}
}`;

// ─── Fetch ────────────────────────────────────────────────────────────────────

const home = isSanityConfigured
  ? await sanityClient.fetch<HomePage | null>(HOME_QUERY, { homeId: HOME_PAGE_ID }).catch(() => null)
  : null;

const [settings, reviews, cruises, activities] = await Promise.all([
  getSiteSettings(defaultLocale),
  getReviews(3),
  getCruisePages(defaultLocale),
  getActivities(defaultLocale),
]);

// ─── Page builder ─────────────────────────────────────────────────────────────

const pageBuilder = (home?.pageBuilder as Record<string, unknown>[] | undefined) ?? [];
const copy = getSiteCopy(defaultLocale);

// ─── SEO ─────────────────────────────────────────────────────────────────────

const seoTitle = home?.seoTitle ?? copy.pages.home.title;
const seoDescription = home?.seoDescription ?? copy.pages.home.description;

// Preload de l'image hero (LCP) : mêmes sources que le <img> pour éviter un double téléchargement.
const heroBlock = pageBuilder.find(
  (block) => block._type === 'heroHeaderBlock' || block._type === 'homeHeroBlock'
);
const heroImage = heroBlock?.image as Parameters<typeof heroImageSources>[0] | undefined;
const heroSources = heroImage ? heroImageSources(heroImage) : undefined;
const heroPreload = heroSources ? { srcset: heroSources.srcset, sizes: heroSources.sizes } : undefined;
---

<BaseLayout title={seoTitle} description={seoDescription} settings={settings} locale={defaultLocale} heroPreload={heroPreload}>
  <main class="bg-background">
    <PageBuilder blocks={pageBuilder} settings={settings} reviews={reviews} cruises={cruises.slice(0, 3)} activities={activities} locale={defaultLocale} />
  </main>
</BaseLayout>
