---
import HeroBlock from '../../components/cruises/HeroBlock.astro';
import CruiseTeaserBlock from '../../components/cruises/CruiseTeaserBlock.astro';
import CruiseGalleryBlock from '../../components/cruises/CruiseGalleryBlock.astro';
import CruiseIntroBlock from '../../components/cruises/CruiseIntroBlock.astro';
import IntroductionDestinationBlock from '../../components/cruises/IntroductionDestinationBlock.astro';
import BateauRecommandeBlock from '../../components/cruises/BateauRecommandeBlock.astro';
import BoatBlock from '../../components/cruises/BoatBlock.astro';
import ItineraryBlock from '../../components/cruises/ItineraryBlock.astro';
import WhyUsBlock from '../../components/cruises/WhyUsBlock.astro';
import ReviewsBlock from '../../components/cruises/ReviewsBlock.astro';
import BookingBlock from '../../components/cruises/BookingBlock.astro';
import RelatedCruisesBlock from '../../components/cruises/RelatedCruisesBlock.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getCruisePage,
  getCruisePages,
  getRelatedCruises,
  getReviews,
  getSiteSettings,
  type CruisePage,
} from '../../lib/cruises';
import { buildCruiseSeoImage, buildCruiseStructuredData } from '../../lib/cruise-seo';
import { buildLocalizedMetadata, defaultLocale } from '../../lib/localization';
import { getSiteCopy } from '../../lib/site-copy';

const locale = defaultLocale;
const copy = getSiteCopy(locale);

export async function getStaticPaths() {
  const cruises = await getCruisePages(defaultLocale);

  return cruises.map((cruise) => ({
    params: { slug: cruise.slug },
    props: { cruise },
  }));
}

const summary = Astro.props.cruise;
const cruise = ((await getCruisePage(summary.slug, locale)) || summary) as CruisePage;
const [settings, reviews, relatedCruises] = await Promise.all([
  getSiteSettings(locale),
  getReviews(3),
  getRelatedCruises(cruise.slug, locale),
]);

const title = cruise.seoTitle || `${cruise.title} | Tahiti Guest Boat`;
const description = cruise.seoDescription || cruise.excerpt || 'Croisière privée en catamaran avec Tahiti Guest Boat.';
const hero = cruise.hero || { title: cruise.title };
const boat = cruise.boat || {};
const itinerary = cruise.itinerary || { title: copy.blocks.itineraryTitle, steps: [] };
const metadata = buildLocalizedMetadata(Astro.url.pathname, {
  locale,
  siteUrl: Astro.site?.href,
});
const seoImage = buildCruiseSeoImage(cruise);
const structuredData = [
  buildCruiseStructuredData(cruise, {
    canonicalUrl: metadata.canonical,
    relatedCruises,
    siteName: settings?.siteName,
  }),
];
---

<BaseLayout
  title={title}
  description={description}
  image={seoImage}
  settings={settings}
  locale={locale}
  structuredData={structuredData}
>
  <main class="bg-background">
    <HeroBlock block={hero} locale={locale} />
    <CruiseTeaserBlock block={cruise.cruiseTeaser} />
    <CruiseGalleryBlock block={cruise.gallery} />
    <CruiseIntroBlock block={cruise.cruiseIntro} />
    <IntroductionDestinationBlock block={cruise.introductionDestination} />
    <BateauRecommandeBlock block={cruise.bateauRecommande} locale={locale} />
    <BoatBlock block={boat} locale={locale} />
    <ItineraryBlock block={itinerary} locale={locale} />
    <WhyUsBlock settings={settings} locale={locale} />
    <ReviewsBlock reviews={reviews} locale={locale} />
    <BookingBlock settings={settings} locale={locale} destinationLabel={cruise.destinationLabel} />
    <RelatedCruisesBlock cruises={relatedCruises} locale={locale} />
  </main>
</BaseLayout>
