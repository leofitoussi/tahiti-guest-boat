---
import Container from '../../components/layout/Container.astro';
import Section from '../../components/layout/Section.astro';
import { Badge } from '../../components/ui/badge';
import CruiseArchiveReveal from '../../components/cruises/CruiseArchiveReveal.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCruisePages } from '../../lib/cruises';
import { defaultLocale } from '../../lib/localization';
import { getSiteCopy } from '../../lib/site-copy';

const locale = defaultLocale;
const copy = getSiteCopy(locale);
const [cruises, englishCruises] = await Promise.all([getCruisePages(locale), getCruisePages('en')]);
const alternatePaths = englishCruises.length > 0 ? { en: '/en/cruises/' } : {};
---

<BaseLayout
  title={copy.pages.cruisesIndex.title}
  description={copy.pages.cruisesIndex.description}
  locale={locale}
  alternatePaths={alternatePaths}
>
  <main class="bg-background">
    {
      cruises.length > 0 ? (
        <CruiseArchiveReveal
          cruises={cruises}
          locale={locale}
          discoverLabel={copy.blocks.discoverCta}
          heroBadge={copy.pages.cruisesIndex.badge}
          heroHeading={copy.pages.cruisesIndex.heading}
          revealFirstLine={copy.pages.cruisesIndex.revealFirstLine}
          revealSecondLine={copy.pages.cruisesIndex.revealSecondLine}
          revealBrand={copy.pages.cruisesIndex.revealBrand}
          archiveHeading={copy.pages.cruisesIndex.archiveHeading}
          heroLead={copy.pages.cruisesIndex.introLead}
          heroBody={copy.pages.cruisesIndex.introBody}
          heroTail={copy.pages.cruisesIndex.introTail}
        />
      ) : (
        <>
          <Section padding="lg" class="border-b border-border/70 bg-muted/30">
            <Container>
              <div class="flex max-w-4xl flex-col gap-5">
                <Badge>{copy.pages.cruisesIndex.badge}</Badge>
                <h1 class="font-heading font-semibold leading-tight text-foreground">{copy.pages.cruisesIndex.heading}</h1>
                <div class="max-w-3xl text-lg leading-relaxed text-muted-foreground md:text-xl">
                  <p class="mb-4 font-bold text-foreground">{copy.pages.cruisesIndex.introLead}</p>
                  <p>{copy.pages.cruisesIndex.introBody}</p>
                  <p class="mt-4">{copy.pages.cruisesIndex.introTail}</p>
                </div>
              </div>
            </Container>
          </Section>
          <Section padding="lg">
            <Container>
              <div class="border border-dashed border-border p-8 text-center">
                <h2 class="font-heading font-semibold text-foreground">{copy.pages.cruisesIndex.emptyTitle}</h2>
                <p class="mx-auto mt-3 max-w-2xl text-muted-foreground">{copy.pages.cruisesIndex.emptyDescription}</p>
              </div>
            </Container>
          </Section>
        </>
      )
    }
  </main>
</BaseLayout>
