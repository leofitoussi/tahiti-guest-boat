---
import Container from '../../components/layout/Container.astro';
import Grid from '../../components/layout/Grid.astro';
import Section from '../../components/layout/Section.astro';
import { Badge } from '../../components/ui/badge';
import { buttonVariants } from '../../components/ui/button';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../../components/ui/card';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCruisePages } from '../../lib/cruises';
import { defaultLocale, localizePath } from '../../lib/localization';
import { getSiteCopy } from '../../lib/site-copy';
import { urlForImage } from '../../lib/sanity';

const locale = defaultLocale;
const copy = getSiteCopy(locale);
const cruises = await getCruisePages(locale);
---

<BaseLayout
  title={copy.pages.cruisesIndex.title}
  description={copy.pages.cruisesIndex.description}
  locale={locale}
>
  <main class="bg-background">
    <Section padding="lg" class="border-b border-border/70 bg-muted/30">
      <Container>
        <div class="flex max-w-4xl flex-col gap-5">
          <Badge>{copy.pages.cruisesIndex.badge}</Badge>
          <h1 class="font-heading font-semibold leading-tight text-foreground">{copy.pages.cruisesIndex.heading}</h1>
          <div class="max-w-3xl text-lg leading-relaxed text-muted-foreground md:text-xl">
            <p class="mb-4 font-bold text-foreground">{copy.pages.cruisesIndex.introLead}</p>
            <p>{copy.pages.cruisesIndex.introBody}</p>
            <p class="mt-4">{copy.pages.cruisesIndex.introTail}</p>
          </div>
        </div>
      </Container>
    </Section>

    <Section padding="lg">
      <Container>
        {
          cruises.length > 0 ? (
            <Grid columns={3}>
              {cruises.map((cruise) => {
                const imageUrl = cruise.heroImage
                  ? urlForImage(cruise.heroImage)?.width(860).height(580).fit('crop').quality(82).auto('format').url()
                  : undefined;

                return (
                  <Card className="transition hover:-translate-y-1 hover:shadow-md">
                    <a href={localizePath(`/nos-croisieres/${cruise.slug}/`, locale)} class="block">
                      {imageUrl ? (
                        <img
                          src={imageUrl}
                          alt={cruise.heroImage?.alt || ''}
                          width="860"
                          height="580"
                          loading="lazy"
                          decoding="async"
                          class="aspect-[1.48] w-full object-cover"
                        />
                      ) : (
                        <div class="aspect-[1.48] w-full bg-muted" />
                      )}
                    </a>
                    <CardHeader>
                      <CardTitle>
                      <a href={localizePath(`/nos-croisieres/${cruise.slug}/`, locale)} class="transition hover:text-primary">
                        {cruise.heroTitle || cruise.title}
                      </a>
                      </CardTitle>
                      {cruise.excerpt && <CardDescription className="line-clamp-4">{cruise.excerpt}</CardDescription>}
                    </CardHeader>
                    <CardContent>
                      <a href={localizePath(`/nos-croisieres/${cruise.slug}/`, locale)} class={buttonVariants({ variant: 'ghost', className: 'px-0' })}>
                        {copy.blocks.discoverCta}
                      </a>
                    </CardContent>
                  </Card>
                );
              })}
          </Grid>
        ) : (
          <div class="border border-dashed border-border p-8 text-center">
              <h2 class="font-heading font-semibold text-foreground">{copy.pages.cruisesIndex.emptyTitle}</h2>
              <p class="mx-auto mt-3 max-w-2xl text-muted-foreground">{copy.pages.cruisesIndex.emptyDescription}</p>
          </div>
        )
        }
      </Container>
    </Section>
  </main>
</BaseLayout>
