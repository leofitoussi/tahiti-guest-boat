---

<BaseLayout
  title="UI Kit | Tahiti Guest Boat"
  description="Documentation interne des composants UI Tahiti Guest Boat."
>
  <main class="bg-background">

    <!-- Hero de la page -->
    <Section padding="lg" class="border-b border-border/70 bg-muted/30">
      <Container>
        <div class="flex max-w-3xl flex-col gap-5">
          <Badge>Documentation interne</Badge>
          <h1 class="font-heading font-semibold text-foreground">
            UI Kit Tahiti Guest Boat
          </h1>
          <p class="text-lg leading-relaxed text-muted-foreground">
            Composants de base, blocs de mise en page et sections reliés aux tokens du projet.
          </p>
        </div>
      </Container>
    </Section>

    <!-- Layout avec sidebar de navigation -->
    <div class="mx-auto flex max-w-[var(--container-site)] gap-0 px-4 py-12 md:gap-12 md:px-8">

      <!-- Sidebar sticky -->
      <aside class="hidden shrink-0 md:block md:w-52 lg:w-60">
        <div class="sticky top-8">
          <p class="mb-4 text-xs font-semibold uppercase tracking-[0.14em] text-muted-foreground">
            Composants
          </p>
          <nav class="flex flex-col gap-1">
            {
              sections.map((s) => (
                <a
                  href={`#${s.id}`}
                  class="rounded-[var(--radius-control)] px-3 py-2 text-sm font-medium text-muted-foreground transition hover:bg-muted hover:text-foreground"
                >
                  {s.label}
                </a>
              ))
            }
          </nav>
        </div>
      </aside>

      <!-- Contenu principal -->
      <div class="min-w-0 flex-1 space-y-16">

        <!-- Buttons -->
        <section id="buttons" class="scroll-mt-8">
          <div class="mb-6 flex flex-col gap-2 border-b border-border pb-6">
            <Badge variant="secondary">Composants de base</Badge>
            <h2 class="font-heading font-semibold text-foreground">Buttons</h2>
            <p class="text-sm text-muted-foreground">
              4 variantes : primary, secondary, ghost, destructive.
            </p>
          </div>
          <div class="flex flex-wrap gap-3">
            {buttonVariants.map((variant) => <Button variant={variant}>{variant}</Button>)}
          </div>
        </section>

        <!-- Formulaires -->
        <section id="forms" class="scroll-mt-8">
          <div class="mb-6 flex flex-col gap-2 border-b border-border pb-6">
            <Badge variant="secondary">Composants de base</Badge>
            <h2 class="font-heading font-semibold text-foreground">Formulaires</h2>
            <p class="text-sm text-muted-foreground">
              Input, Label, Badge et Avatar avec leurs variantes.
            </p>
          </div>
          <Grid columns={3}>
            <Card>
              <CardHeader>
                <CardTitle>Input + Label</CardTitle>
                <CardDescription>Champ standard avec état focus et placeholder.</CardDescription>
              </CardHeader>
              <CardContent>
                <div class="flex flex-col gap-3">
                  <Label htmlFor="email">Email</Label>
                  <Input id="email" type="email" placeholder="contact@tahiti-guest-boat.com" />
                </div>
              </CardContent>
            </Card>

            <Card>
              <CardHeader>
                <CardTitle>Badge</CardTitle>
                <CardDescription>Variantes shadcn adaptées aux couleurs sémantiques.</CardDescription>
              </CardHeader>
              <CardContent>
                <div class="flex flex-wrap gap-3">
                  <Badge>Default</Badge>
                  <Badge variant="secondary">Secondary</Badge>
                  <Badge variant="ghost">Ghost</Badge>
                  <Badge variant="destructive">Destructive</Badge>
                </div>
              </CardContent>
            </Card>

            <Card>
              <CardHeader>
                <CardTitle>Avatar</CardTitle>
                <CardDescription>Fallback obligatoire et groupe compact.</CardDescription>
              </CardHeader>
              <CardContent>
                <AvatarDemo />
              </CardContent>
            </Card>
          </Grid>
        </section>

        <!-- Card & Separator -->
        <section id="card" class="scroll-mt-8">
          <div class="mb-6 flex flex-col gap-2 border-b border-border pb-6">
            <Badge variant="secondary">Mise en page</Badge>
            <h2 class="font-heading font-semibold text-foreground">Card & Separator</h2>
            <p class="text-sm text-muted-foreground">
              Structure complète avec header, contenu et footer.
            </p>
          </div>
          <Card>
            <CardHeader>
              <CardTitle>Card complète</CardTitle>
              <CardDescription>Structure complète avec header, contenu et footer.</CardDescription>
            </CardHeader>
            <CardContent>
              <div class="flex flex-col gap-5">
                <p class="text-sm leading-relaxed text-muted-foreground">
                  Cette carte montre les espacements, bordures et textes standards pour les panneaux internes.
                </p>
                <Separator />
                <div class="grid gap-4 md:grid-cols-3">
                  <div>
                    <Badge variant="secondary">Section</Badge>
                    <p class="mt-2 text-sm text-muted-foreground">Padding responsive sm, md, lg ou none.</p>
                  </div>
                  <div>
                    <Badge variant="secondary">Container</Badge>
                    <p class="mt-2 text-sm text-muted-foreground">Largeur centrée basée sur les tokens.</p>
                  </div>
                  <div>
                    <Badge variant="secondary">Grid</Badge>
                    <p class="mt-2 text-sm text-muted-foreground">2, 3 ou 4 colonnes responsive.</p>
                  </div>
                </div>
              </div>
            </CardContent>
            <CardFooter>
              <Button variant="ghost">Action secondaire</Button>
            </CardFooter>
          </Card>
        </section>

        <!-- Hero block -->
        <section id="hero" class="scroll-mt-8">
          <div class="mb-6 flex flex-col gap-2 border-b border-border pb-6">
            <Badge variant="secondary">Blocs</Badge>
            <h2 class="font-heading font-semibold text-foreground">Hero block</h2>
            <p class="text-sm text-muted-foreground">
              Bloc éditorial avec eyebrow, titre, body et CTA. Utilisé dans le page builder.
            </p>
          </div>
          <div class="overflow-hidden rounded-[var(--radius-surface)] border border-border/70">
            <HeroBlock
              eyebrow="Hero block"
              title="Explorer les lagons avec une interface claire et réutilisable"
              body="Ce bloc sert de base pour les futures pages éditoriales ou commerciales du site."
              primaryCta={{ label: 'Action principale', href: '/contact' }}
              secondaryCta={{ label: 'Action secondaire', href: '/blog' }}
            />
          </div>
        </section>

        <!-- Masonry Gallery -->
        <section id="masonry" class="scroll-mt-8">
          <div class="mb-6 flex flex-col gap-2 border-b border-border pb-6">
            <Badge variant="secondary">Blocs</Badge>
            <h2 class="font-heading font-semibold text-foreground">Masonry Gallery</h2>
            <p class="text-sm text-muted-foreground">
              Grille photo en colonnes masonry. Props : <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">images[]</code>,
              <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">columns</code> (2 | 3 | 4),
              <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">gap</code> (sm | md | lg),
              <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">eyebrow</code>,
              <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">title</code>.
            </p>
          </div>
          <div class="overflow-hidden rounded-[var(--radius-surface)] border border-border/70">
            <MasonryGallery
              eyebrow="Galerie"
              title="La Polynésie en images"
              images={demoImages}
              columns={3}
              gap="md"
            />
          </div>
          <div class="mt-6 overflow-hidden rounded-[var(--radius-surface)] border border-border/70">
            <MasonryGallery
              eyebrow="Galerie"
              title="Layout 3-4"
              images={demoImages}
              layout="rows-3-4"
            />
          </div>
          <div class="mt-6 overflow-hidden rounded-[var(--radius-surface)] border border-border/70">
            <MasonryGallery
              eyebrow="Galerie"
              title="Layout Bleed"
              images={demoImages}
              layout="bleed-rows"
            />
          </div>
        </section>

        <!-- Marquee Gallery -->
        <section id="marquee" class="scroll-mt-8">
          <div class="mb-6 flex flex-col gap-2 border-b border-border pb-6">
            <Badge variant="secondary">Blocs</Badge>
            <h2 class="font-heading font-semibold text-foreground">Marquee Gallery</h2>
            <p class="text-sm text-muted-foreground">
              3 lignes défilantes en boucle infinie. Le scroll accélère les lignes (desktop).
              Props : <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">row1[]</code>,
              <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">row2[]</code>,
              <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">row3[]</code>,
              <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">eyebrow</code>,
              <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">title</code>.
            </p>
          </div>
          <MarqueeGallery
            eyebrow="Galerie"
            title="La Polynésie en mouvement"
            row1={marqueeRow1}
            row2={marqueeRow2}
            row3={marqueeRow3}
          />
        </section>

        <!-- Navigation -->
        <section id="navigation" class="scroll-mt-8">
          <div class="mb-6 flex flex-col gap-2 border-b border-border pb-6">
            <Badge variant="secondary">Navigation</Badge>
            <h2 class="font-heading font-semibold text-foreground">Header & Footer</h2>
            <p class="text-sm text-muted-foreground">
              Header responsive avec drawer mobile. Footer avec liens et CTA.
            </p>
          </div>
          <Card>
            <CardContent className="p-0">
              <Header navItems={navItems} ctaLabel="Reserver" ctaHref="/reservation" />
              <Footer footerLinks={navItems} />
            </CardContent>
          </Card>
        </section>

      </div>
    </div>
  </main>


</BaseLayout>
