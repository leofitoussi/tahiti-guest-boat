  { url: 'https://images.unsplash.com/photo-1559494007-9f5847c49d94?w=800&q=80', alt: 'Coucher de soleil', width: 800, height: 534 },
  { url: 'https://images.unsplash.com/photo-1682686581030-7fa4ea2b96c3?w=800&q=80', alt: 'Palmiers', width: 800, height: 600 },
  { url: 'https://images.unsplash.com/photo-1510414842594-a61c69b5ae57?w=800&q=80', alt: 'Vue aérienne atoll', width: 800, height: 534 },
  { url: 'https://images.unsplash.com/photo-1500534314209-a25ddb2bd429?w=800&q=80', alt: 'Voilier', width: 800, height: 800 },
];
const marqueeRow2 = [
  { url: 'https://images.unsplash.com/photo-1544551763-46a013bb70d5?w=800&q=80', alt: 'Catamaran', width: 800, height: 1067 },
  { url: 'https://images.unsplash.com/photo-1589394815804-964ed0be2eb5?w=800&q=80', alt: 'Dauphins', width: 800, height: 1067 },
  { url: 'https://images.unsplash.com/photo-1506953823976-52e1fdc0149a?w=800&q=80', alt: 'Lagon corail', width: 800, height: 534 },
  { url: 'https://images.unsplash.com/photo-1501854140801-50d01698950b?w=800&q=80', alt: 'Collines bord de mer', width: 800, height: 1200 },
  { url: 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=800&q=80', alt: 'Plage', width: 800, height: 533 },
];
const marqueeRow3 = [
  { url: 'https://images.unsplash.com/photo-1510414842594-a61c69b5ae57?w=800&q=80', alt: 'Atoll', width: 800, height: 534 },
  { url: 'https://images.unsplash.com/photo-1559494007-9f5847c49d94?w=800&q=80', alt: 'Coucher de soleil', width: 800, height: 534 },
  { url: 'https://images.unsplash.com/photo-1500534314209-a25ddb2bd429?w=800&q=80', alt: 'Voilier', width: 800, height: 800 },
  { url: 'https://images.unsplash.com/photo-1682686581030-7fa4ea2b96c3?w=800&q=80', alt: 'Palmiers', width: 800, height: 600 },
  { url: 'https://images.unsplash.com/photo-1506953823976-52e1fdc0149a?w=800&q=80', alt: 'Lagon', width: 800, height: 534 },
];

const demoImages = [
  {
    url: 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=800&q=80',
    alt: 'Plage de sable blanc en Polynésie',
    width: 800,
    height: 533,
  },
  {
    url: 'https://images.unsplash.com/photo-1544551763-46a013bb70d5?w=800&q=80',
    alt: 'Catamaran sur un lagon turquoise',
    width: 800,
    height: 1067,
  },
  {
    url: 'https://images.unsplash.com/photo-1559494007-9f5847c49d94?w=800&q=80',
    alt: 'Coucher de soleil sur l\'océan',
    width: 800,
    height: 534,
    caption: 'Coucher de soleil depuis le pont',
  },
  {
    url: 'https://images.unsplash.com/photo-1589394815804-964ed0be2eb5?w=800&q=80',
    alt: 'Dauphins sous la surface',
    width: 800,
    height: 1067,
  },
  {
    url: 'https://images.unsplash.com/photo-1682686581030-7fa4ea2b96c3?w=800&q=80',
    alt: 'Palmiers sur une île tropicale',
    width: 800,
    height: 600,
  },
  {
    url: 'https://images.unsplash.com/photo-1510414842594-a61c69b5ae57?w=800&q=80',
