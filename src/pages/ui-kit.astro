    width: 800,
    height: 1200,
    caption: 'Les hauteurs de Moorea',
  },
  {
    url: 'https://images.unsplash.com/photo-1506953823976-52e1fdc0149a?w=800&q=80',
    alt: 'Lagon bleu-vert avec fond de corail',
    width: 800,
    height: 534,
  },
  {
    url: 'https://images.unsplash.com/photo-1500534314209-a25ddb2bd429?w=800&q=80',
    alt: 'Voilier dans le soleil couchant',
    width: 800,
    height: 800,
