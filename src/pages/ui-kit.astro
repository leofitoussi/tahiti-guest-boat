---
import HeroBlock from '../components/blocks/Hero.astro';
import MasonryGallery from '../components/blocks/MasonryGallery.astro';
import MarqueeGallery from '../components/blocks/MarqueeGallery.astro';
import Container from '../components/layout/Container.astro';
import Grid from '../components/layout/Grid.astro';
import Section from '../components/layout/Section.astro';
import Footer from '../components/navigation/Footer.astro';
import Header from '../components/navigation/Header.astro';
import { AvatarDemo } from '../components/ui-kit/AvatarDemo';
import { Badge } from '../components/ui/badge';
import { Button } from '../components/ui/button';
import { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from '../components/ui/card';
import { Input } from '../components/ui/input';
import { Label } from '../components/ui/label';
import { Separator } from '../components/ui/separator';
import BaseLayout from '../layouts/BaseLayout.astro';

const navItems = [
  { label: 'Notre bateau', href: '/notre-bateau' },
  { label: 'Nos croisieres', href: '/nos-croisieres' },
  { label: 'Blog', href: '/blog' },
];

const buttonVariants = ['primary', 'secondary', 'ghost', 'destructive'] as const;

const sections = [
  { id: 'buttons', label: 'Buttons' },
  { id: 'forms', label: 'Formulaires' },
  { id: 'card', label: 'Card & Separator' },
  { id: 'hero', label: 'Hero block' },
  { id: 'masonry', label: 'Masonry Gallery' },
  { id: 'marquee', label: 'Marquee Gallery' },
  { id: 'navigation', label: 'Navigation' },
];

// MarqueeGallery uses ResolvedImage (url-based), split into 3 rows of 5
const marqueeRow1 = [
